
////////////////////////////////////////////
////Step1 GLOBAL PROCESSING
////////////////////////////////////////////

//////////////// INPUT DATA

////WorldCover 2020

var WC2020 = ee.ImageCollection("ESA/WorldCover/v100").first();
var WC2020_foret = WC2020.eq(10);

////Copernicus 2019

var lc2019 = ee.Image("COPERNICUS/Landcover/100m/Proba-V-C3/Global/2019");
var lc2019_otherlandcover = ((lc2019.select('discrete_classification').gte(20)).and(lc2019.select('discrete_classification').lte(100)));

////GFC 2001-2021

var gfcImage = ee.Image("UMD/hansen/global_forest_change_2021_v1_9"); 
var treeCover = gfcImage.select(['treecover2000']);
var lossImage = gfcImage.select(['loss']);
var gainImage = gfcImage.select(['gain']);
var lossYear = gfcImage.select(['lossyear']).unmask(); //2001=1, 2015=15
var lossYearGFC2000_2020 = (treeCover.gte(10)).and(lossYear.gte(1)).and(lossYear.lte(20));

////Global land use UMD https://www.nature.com/articles/s43016-021-00429-z  https://glad.umd.edu/dataset/croplands

var cropmask_UMD_2003=ee.ImageCollection('users/potapovpeter/Global_cropland_2003').mosaic().unmask(); 
var cropmask_UMD_2007=ee.ImageCollection('users/potapovpeter/Global_cropland_2007').mosaic().unmask(); 
var cropmask_UMD_2011=ee.ImageCollection('users/potapovpeter/Global_cropland_2011').mosaic().unmask(); 
var cropmask_UMD_2015=ee.ImageCollection('users/potapovpeter/Global_cropland_2015').mosaic().unmask(); 
var cropmask_UMD_2015=ee.ImageCollection('users/potapovpeter/Global_cropland_2019').mosaic().unmask(); // Janvier 2019 !!
var cropmask_UMD = cropmask_UMD_2003.or(cropmask_UMD_2007).or(cropmask_UMD_2011).or(cropmask_UMD_2015).or(cropmask_UMD_2015);

////GEDI CH 2019 

var CH_GEDI = ee.ImageCollection('users/potapovpeter/GEDI_V27').mosaic();

//////////////// PROCESSING

var Global_forest_step1 = WC2020_foret;
Global_forest_step1 = Global_forest_step1.where(lc2019_otherlandcover,0);
Global_forest_step1 = Global_forest_step1.where(lossYearGFC2000_2020,0);
Global_forest_step1 = Global_forest_step1.where(cropmask_UMD,0);
Global_forest_step1 = Global_forest_step1.where(CH_GEDI.lt(5),0);

Map.addLayer(Global_forest_step1.updateMask(Global_forest_step1)) 


//////////// CLIP and Export 10deg tiles


//FN 10 deg.
var Zones=ee.FeatureCollection('users/bourgoinclement2/Harvest/10degGridGlobal_WithoutOcean')




var colFunc = function(feat) {
  var dis = feat.get("id");
  var clipped = img.clip(feat).set("id", dis);
  return clipped;
};

var imcol = ee.ImageCollection(Zones.map(colFunc));

print(imcol);

////////////// EXPORTING ///////////////////////
var featlist = Zones.getInfo()["features"];
for (var f in featlist) {
  var feat = ee.Feature(featlist[f]);
  var dis = feat.get("id");
  var disS = dis.getInfo();
  var name = "chip";  
  Export.image.toDrive({
    image: img,
    description: name+disS.toString(),
    folder: "EEtest",
    fileNamePrefix: name+disS.toString(),
    region: feat.geometry().bounds(),
    scale: 10,
    maxPixels: 1e13
  });
}
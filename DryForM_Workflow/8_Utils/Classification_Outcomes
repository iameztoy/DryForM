
//***********************************************************
// DRYFORM - Step 8.0 - Visualize Classification Results
//***********************************************************

var chaco_aoi = ee.FeatureCollection("users/iameztoy/dryform/AOIs/eco_zone_Chaco");
var caatinga_aoi = ee.FeatureCollection("users/iameztoy/dryform/AOIs/eco_zone_Caatinga");
var cerrado_aoi = ee.FeatureCollection("users/iameztoy/dryform/AOIs/eco_zone_Cerrado");
var tanzania_aoi = ee.FeatureCollection("users/iameztoy/dryform/AOIs/zone_Tanzania");


var chaco = ee.Image("projects/hardy-tenure-383607/assets/DryForm_Project/Classification/Class_chaco_Pb_buf20_9cl").clip(chaco_aoi);
var caatinga = ee.Image("projects/hardy-tenure-383607/assets/DryForm_Project/Classification/Class_caatinga_Pb_buf20_9cl").clip(caatinga_aoi);
var cerrado = ee.Image("projects/hardy-tenure-383607/assets/DryForm_Project/Classification/Class_cerrado_Pb_buf20_9cl").clip(cerrado_aoi);
var tanzania = ee.Image("projects/hardy-tenure-383607/assets/DryForm_Project/Classification/Class_tanzania_Pb_buf20_9cl").clip(tanzania_aoi);

// Tree Cover and Mangroves
var chaco_tc = chaco.eq(1);
var caatinga_tc = caatinga.eq(0).or(caatinga.eq(3));
var cerrado_tc = cerrado.eq(0).or(cerrado.eq(3));
var tanzania_tc = tanzania.eq(0).or(tanzania.eq(3));

var vp_tc = {palette:"green"};

Map.addLayer(chaco_tc.selfMask(), vp_tc, "Chaco TC", 1);
Map.addLayer(caatinga_tc.selfMask(), vp_tc, "Caatinga TC", 1);
Map.addLayer(cerrado_tc.selfMask(), vp_tc, "Cerrado TC", 1);
Map.addLayer(tanzania_tc.selfMask(), vp_tc, "Tanzania TC", 1);

// Shrubs

var chaco_sh = chaco.eq(2);
var caatinga_sh = caatinga.eq(1);
var cerrado_sh = cerrado.eq(1);
var tanzania_sh = tanzania.eq(1);

var vp_sh = {palette:"orange"};

Map.addLayer(chaco_sh.selfMask(), vp_sh, "Chaco Shrubs", 1);
Map.addLayer(caatinga_sh.selfMask(), vp_sh, "Caatinga Shrubs", 1);
Map.addLayer(cerrado_sh.selfMask(), vp_sh,"Cerrado Shrubs", 1);
Map.addLayer(tanzania_sh.selfMask(), vp_sh, "Tanzania Shrubs", 1);


/////// World Cover

var dataset = ee.ImageCollection('ESA/WorldCover/v200').first();

var visualization = {
  bands: ['Map'],
};

Map.centerObject(dataset);

Map.addLayer(dataset, visualization, 'Landcover');
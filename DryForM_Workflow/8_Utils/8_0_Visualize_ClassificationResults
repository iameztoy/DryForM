/*
Author: Iban Ameztoy | Joint Research Center - European Commission | DryForM Exploratory Research Project 2022-2024 - Units S.4/D.1

All four AOIs are loaded together (Chaco, Caatinga and Cerrado Biomes (FAO Ecozones) + Tanzania (GDAM dataset)
This classification version does not include any MMU filtering, it is the outcome of step 6.0 where artifacts have been partially corrected.

The tree cover is also crossed with tree cover heights coming from Lang (Potapov & Meta/WRI products are also available).
It also calculates the Tree Canoply Heights below 5 meters in the Tree Cover domain.
This is to check possible commission error and also areas classified as tree cover that are not aligned to FAO´s forest definition (only in terms of canopy height)
    Areas below 5 meters are shown in orange.
    Beware of the uncertainty of the Tree Canopy Height Map products. 
      In some cases this uncertainty is big. Therefore, consider the commission error interpretation of the Tree Cover dataset with caution.

*/

//Post-processed Tree Cover
var pp_tc = ee.ImageCollection("projects/hardy-tenure-383607/assets/DryForm_Project/Classification_PostProc/Classification_PostProc");
pp_tc = pp_tc.mosaic().selfMask();

// Load Tree Canopy Height Products
var gedil = ee.ImageCollection('users/potapovpeter/GEDI_V27').mosaic();
// Alternativelly:
//ee.ImageCollection("projects/meta-forest-monitoring-okw37/assets/CanopyHeight").mosaic(); //META/WRI
//ee.Image('users/nlang/ETH_GlobalCanopyHeight_2020_10m_v1'); //Lang

var h = pp_tc.multiply(gedil);
var m5 = h.lt(5).selfMask();

// Visualization
var palettes = require('users/gena/packages:palettes');
var palette = palettes.colorbrewer.YlGn[7];

var vp_tc = {palette:"green"};

Map.addLayer(pp_tc.selfMask(), vp_tc, "Post-processed Tree Cover", 1);
Map.addLayer(h.selfMask(), {min: 0, max: 30, palette: palette}, "Post-processed Tree Cover & Heights");
Map.addLayer(m5, {palette: "orange"}, "Mask height <5", 1); //This is only in the Tree Cover domain.


// Adding World Cover for comparison

var wc2021 = ee.ImageCollection('ESA/WorldCover/v200').first();
var visualization = {bands: ['Map'],};

Map.centerObject(pp_tc);
Map.setOptions("SATELLITE");
Map.addLayer(wc2021, visualization, 'World Cover 2021', 0);
    print("Classifier explain()", classifier.explain());

    // Training confusion matrix + OA (if available)
    // Guard: some classifiers may not support confusionMatrix()
    var methodUpper = CLASSIFIER_METHOD.toUpperCase();
    var supportsTrainCM = (methodUpper === 'RF' || methodUpper === 'CART' || methodUpper === 'GTB' || methodUpper === 'KNN' || methodUpper === 'NB' || methodUpper === 'SVM' || methodUpper === 'MIN_DIST');
    // We'll just try and catch by lazy evaluation (GEE doesn't do JS try/catch server-side),
    // so we compute and print; if it fails you'll see error and can disable this block.
    var trainCm = classifier.confusionMatrix();
    print('Training error matrix', trainCm);
    print('Training overall accuracy', trainCm.accuracy());


// ======================================================
// 8) CLASSIFIERS + PARAMS
// ======================================================

// RF
var RF_numberOfTrees      = 90;
var RF_variablesPerSplit  = null;
var RF_minLeafPopulation  = 1;
var RF_bagFraction        = 0.5;
var RF_maxNodes           = null;

// CART
var CART_maxNodes          = null;
var CART_minLeafPopulation = 1;

// GTB
var GTB_numberOfTrees = 200;
var GTB_shrinkage     = 0.005;
var GTB_samplingRate  = 0.7;
var GTB_maxNodes      = null;
var GTB_loss          = "LeastAbsoluteDeviation";

// KNN
var KNN_k            = 1;
var KNN_searchMethod = "AUTO";
var KNN_metric       = "EUCLIDEAN";

// NB
var NB_lambda = 0.000001;

// SVM
var SVM_decisionProcedure  = "Voting";
var SVM_svmType            = "C_SVC";
var SVM_kernelType         = "LINEAR";
var SVM_shrinking          = true;
var SVM_degree             = null;
var SVM_gamma              = null;
var SVM_coef0              = null;
var SVM_cost               = null;
var SVM_nu                 = null;
var SVM_terminationEpsilon = null;
var SVM_lossEpsilon        = null;
var SVM_oneClass           = null;

// Minimum Distance
var MIN_metric   = "euclidean";
var MIN_kNearest = 1;

function getClassifier(method) {
  method = (method || 'RF').toUpperCase();

  if (method === 'RF') {
    return ee.Classifier.smileRandomForest(
      RF_numberOfTrees, RF_variablesPerSplit, RF_minLeafPopulation,
      RF_bagFraction, RF_maxNodes, GLOBAL_SEED
    );
  }
  if (method === 'CART') {
    return ee.Classifier.smileCart(CART_maxNodes, CART_minLeafPopulation);
  }
  if (method === 'GTB') {
    return ee.Classifier.smileGradientTreeBoost(
      GTB_numberOfTrees, GTB_shrinkage, GTB_samplingRate,
      GTB_maxNodes, GTB_loss, GLOBAL_SEED
    );
  }
  if (method === 'KNN') {
    return ee.Classifier.smileKNN(KNN_k, KNN_searchMethod, KNN_metric);
  }
  if (method === 'NB') {
    return ee.Classifier.smileNaiveBayes(NB_lambda);
  }
  if (method === 'SVM') {
    return ee.Classifier.libsvm(
      SVM_decisionProcedure, SVM_svmType, SVM_kernelType, SVM_shrinking,
      SVM_degree, SVM_gamma, SVM_coef0, SVM_cost, SVM_nu,
      SVM_terminationEpsilon, SVM_lossEpsilon, SVM_oneClass
    );
  }
  if (method === 'MIN_DIST') {
    return ee.Classifier.minimumDistance(MIN_metric, MIN_kNearest);
  }

  return ee.Classifier.smileRandomForest(RF_numberOfTrees, null, 1, 0.5, null, GLOBAL_SEED);
}

function canExportClassifier(method) {
  method = method.toUpperCase();
  return (method === 'RF' || method === 'CART');
}


// ======================================================
// 9) METRICS + PRINTS HELPERS
// ======================================================

function arrayToFlatList(arr) {
  return ee.List(ee.Array(arr).toList()).flatten();
}

function eeJsonFromList(listObj) {
  return ee.String.encodeJSON(listObj);
}
function eeJsonFromFlatArray(arrObj) {
  return ee.String.encodeJSON(arrayToFlatList(arrObj));
}
function eeJsonFrom2DArray(arrObj) {
  return ee.String.encodeJSON(ee.Array(arrObj).toList());
}

// Validation: classify only samples (safe)
function computeValidationMetrics(classifier, compositeForTraining, validationGcp, fixedOrder) {

  var testArgs = { collection: validationGcp, properties: [landcover], scale: SCALE, geometries: false };
  if (USE_TILE_SCALE) testArgs.tileScale = TEST_TILE_SCALE;

  var valSamples = compositeForTraining.sampleRegions(testArgs);
  var valPred = valSamples.classify(classifier);

  var cm = valPred.errorMatrix(landcover, 'classification', fixedOrder);

  var oa    = cm.accuracy();
  var kappa = cm.kappa();

  var usersAcc = cm.consumersAccuracy();
  var prodAcc  = cm.producersAccuracy();
  var f1Arr    = cm.fscore();

  var macroPrecision = ee.Number(arrayToFlatList(usersAcc).reduce(ee.Reducer.mean()));
  var macroRecall    = ee.Number(arrayToFlatList(prodAcc).reduce(ee.Reducer.mean()));
  var macroF1        = ee.Number(arrayToFlatList(f1Arr).reduce(ee.Reducer.mean()));

  var order   = cm.order();
  var cmArr   = cm.array();
  var support = ee.Array(cmArr).reduce(ee.Reducer.sum(), [1]);

  return ee.Dictionary({
    cm: cm, // keep for printing in single mode
    val_overallAccuracy: oa,
    val_kappa: kappa,
    val_macroPrecision: macroPrecision,
    val_macroRecall: macroRecall,
    val_macroF1: macroF1,
    score: macroF1,
    val_labelOrder: eeJsonFromList(order),
    val_supportByClass: eeJsonFromFlatArray(support),
    val_usersAccuracy: eeJsonFromFlatArray(usersAcc),
    val_producersAccuracy: eeJsonFromFlatArray(prodAcc),
    val_f1ByClass: eeJsonFromFlatArray(f1Arr),
    val_confusionMatrix: eeJsonFrom2DArray(cmArr)
  });
}

// Training metrics (like original script): confusion matrix from classifier
function computeTrainingMetrics(classifier) {
  // For Smile classifiers, classifier.confusionMatrix() is available after training.
  // If a method doesn't support it, this will throw at runtime; we guard in single mode.
  var cmTrain = classifier.confusionMatrix();
  return ee.Dictionary({
    train_cm: cmTrain,
    train_oa: cmTrain.accuracy()
  });
}

// Feature importance (RF/GTB/CART often provide 'importance' in explain)
function getImportanceDict(classifier) {
  var explain = ee.Dictionary(classifier.explain());
  var imp = ee.Dictionary(explain.get('importance'));
  return imp;
}

function importanceToRelative(impDict) {
  var sum = impDict.values().reduce(ee.Reducer.sum());
  return impDict.map(function(k, v) {
    return ee.Number(v).multiply(100).divide(sum);
  });
}


// ======================================================
// 10) CORE: run one (AOI, method) and return Feature row (table-ready)
// ======================================================

function runOneAOIMethod(aoiName, method) {

  var aoiFc = AOIS[aoiName];

  var remap = getRemapForAOI(aoiName);
  var classValues = remap.classValues;
  var remapValues = remap.remapValues;

  var nClasses = remapValues.length;
  var fixedOrder = ee.List.sequence(0, nClasses - 1);

  var trainingGcp = (TRAIN_GEOM_MODE === 'POLYGONS')
    ? GTPol_DF_Balanced[aoiName]
    : GTPoint_DF_Balanced[aoiName];

  var validationGcp = GroundTruthPoint_DF
    .filter(ee.Filter.eq('aoiname', aoiName))
    .filter(ee.Filter.eq('purp', "validation"));

  trainingGcp   = trainingGcp.remap(classValues, remapValues, landcover);
  validationGcp = validationGcp.remap(classValues, remapValues, landcover);

  if (TRAIN_GEOM_MODE === 'POINTS' && BUFFER_METERS > 0) {
    trainingGcp   = trainingGcp.map(function(f){ return f.buffer(BUFFER_METERS); });
    validationGcp = validationGcp.map(function(f){ return f.buffer(BUFFER_METERS); });
  }

  var composite = getCompositeForAOIYear(aoiFc, YEAR);
  var compositeForTraining = composite;

  if (method.toUpperCase() === 'NB' && NB_ENABLE_PREPROCESS) {
    compositeForTraining = composite.multiply(NB_SCALE).add(NB_OFFSET).round().toInt();
  }

  var trainingArgs = { collection: trainingGcp, properties: [landcover], scale: SCALE, geometries: false };
  if (USE_TILE_SCALE) trainingArgs.tileScale = TRAIN_TILE_SCALE;

  var training = compositeForTraining.sampleRegions(trainingArgs);

  var classifier = getClassifier(method).train({
    features: training,
    classProperty: landcover,
    inputProperties: compositeForTraining.bandNames()
  });

  var v = computeValidationMetrics(classifier, compositeForTraining, validationGcp, fixedOrder);

  // Compact runTag stored in table (not too long)
  var runTag = 'AE' + YEAR + '_' + aoiName + '_' + method.toUpperCase() +
               '_' + lcShortName(landcover) + '_' + geomShortName(TRAIN_GEOM_MODE) +
               '_s' + GLOBAL_SEED;

  var props = ee.Dictionary({
    runTag: runTag,
    year: YEAR,
    aoi: aoiName,
    method: method.toUpperCase(),
    landcover: landcover,
    trainGeomMode: TRAIN_GEOM_MODE,
    bufferMeters: (TRAIN_GEOM_MODE === 'POINTS') ? BUFFER_METERS : 0,
    scale: SCALE,
    useTileScale: USE_TILE_SCALE,
    trainTileScale: TRAIN_TILE_SCALE,
    testTileScale: TEST_TILE_SCALE,
    seed: GLOBAL_SEED,
    nClasses: nClasses,
    bandsCount: compositeForTraining.bandNames().size(),
    trainCount: trainingGcp.size(),
    validCount: validationGcp.size(),
    classValues: JSON.stringify(classValues),
    remapValues: JSON.stringify(remapValues),

    val_overallAccuracy: v.get('val_overallAccuracy'),
    val_kappa: v.get('val_kappa'),
    val_macroPrecision: v.get('val_macroPrecision'),
    val_macroRecall: v.get('val_macroRecall'),
    val_macroF1: v.get('val_macroF1'),
    score: v.get('score')
  });

  if (BENCH_INCLUDE_CONFUSION_AND_PERCLASS) {
    props = props.combine(ee.Dictionary({
      val_labelOrder: v.get('val_labelOrder'),
      val_supportByClass: v.get('val_supportByClass'),
      val_usersAccuracy: v.get('val_usersAccuracy'),
      val_producersAccuracy: v.get('val_producersAccuracy'),
      val_f1ByClass: v.get('val_f1ByClass'),
      val_confusionMatrix: v.get('val_confusionMatrix')
    }), true);
  }

  if (BENCH_INCLUDE_CLASSIFIER_EXPLAIN) {
    props = props.combine(ee.Dictionary({
      classifierExplain: ee.Dictionary(classifier.explain()).serialize()
    }), true);
  }

  // Return feature + also return objects we need in single mode via a dictionary
  return ee.Dictionary({
    feature: ee.Feature(null, props),
    classifier: classifier,
    composite: compositeForTraining,
    validationDict: v,
    trainingFc: trainingGcp,
    validationFc: validationGcp,
    fixedOrder: fixedOrder
  });
}



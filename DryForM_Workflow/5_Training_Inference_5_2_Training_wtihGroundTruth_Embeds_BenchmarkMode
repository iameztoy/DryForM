  // ------------------------
  if (DO_EXPORT_CLASSIFIED_ASSET) {

    // NOTE: This can still be heavy on large AOIs. Use tiling if needed.
    var imgTaskBase = taskLabel("IMG", AOI_NAME, CLASSIFIER_METHOD);
    var classifiedImg = compositeForTraining.classify(classifier).toByte();

    if (!SINGLE_EXPORT_TILED) {
      Export.image.toAsset({
        image: classifiedImg.clip(aoi),
        description: imgTaskBase,
        assetId: EXPORT_CLASS_FOLDER + imgTaskBase,
        pyramidingPolicy: {'.default': 'mode'},
        region: aoi.geometry(),
        scale: SCALE,
        crs: EXPORT_CRS,
        maxPixels: 1e13
      });
      if (SHOW_MAP_LAYERS) {
        Map.addLayer(classifiedImg.clip(aoi), null, 'LC ' + YEAR + ' (' + CLASSIFIER_METHOD + ')', 0);
      }
    } else {
      var bounds = aoi.geometry().bounds(1);
      var ring = ee.List(bounds.coordinates().get(0));
      var xmin = ee.Number(ee.List(ring.get(0)).get(0));
      var ymin = ee.Number(ee.List(ring.get(0)).get(1));
      var xmax = ee.Number(ee.List(ring.get(2)).get(0));
      var ymax = ee.Number(ee.List(ring.get(2)).get(1));

      var xList = ee.List.sequence(xmin, xmax.subtract(TILE_DX_DEG), TILE_DX_DEG);
      var yList = ee.List.sequence(ymin, ymax.subtract(TILE_DY_DEG), TILE_DY_DEG);

      var grid = ee.FeatureCollection(
        xList.map(function(x) {
          x = ee.Number(x);
          return yList.map(function(y) {
            y = ee.Number(y);
            var rect = ee.Geometry.Rectangle([x, y, x.add(TILE_DX_DEG), y.add(TILE_DY_DEG)], null, false);
            return ee.Feature(rect);
          });
        }).flatten()
      ).filterBounds(aoi);

      var nTiles = grid.size().getInfo();
      if (nTiles > MAX_TILES) {
        throw new Error('Too many tiles (' + nTiles + '). Increase TILE_DX_DEG/TILE_DY_DEG or MAX_TILES.');
      }

      var gridList = grid.toList(nTiles);
      for (var t = 0; t < nTiles; t++) {
        var tile = ee.Feature(gridList.get(t));
        var region = tile.geometry().intersection(aoi.geometry(), 1);

        Export.image.toAsset({
          image: classifiedImg.clip(region),
          description: imgTaskBase + '_t' + t,
          assetId: EXPORT_CLASS_FOLDER + imgTaskBase + '_t' + t,
          pyramidingPolicy: {'.default': 'mode'},
          region: region,
          scale: SCALE,
          crs: EXPORT_CRS,
          maxPixels: 1e13
        });
      }
    }
  }
}

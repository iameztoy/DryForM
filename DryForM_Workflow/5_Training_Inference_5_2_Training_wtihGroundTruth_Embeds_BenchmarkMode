function lcShortName(lc) {
  if (lc === 'visulcrec') return 'vrec';
  if (lc === 'visu_lc')   return 'vlc';
  return lc;
}
function geomShortName(mode) {
  return (mode === 'POLYGONS') ? 'pol' : ('p' + String(BUFFER_METERS));
}
function taskLabelBase(aoiName, method) {
  var base =
    TASK_PREFIX + '_' +
    String(YEAR) + '_' +
    aoiName + '_' +
    method.toUpperCase() + '_' +
    lcShortName(landcover) + '_' +
    geomShortName(TRAIN_GEOM_MODE) + '_' +
    's' + String(GLOBAL_SEED);

  if (TASK_LABEL_MODE === 'medium') {
    base += '_ts' + String(USE_TILE_SCALE ? 1 : 0);
    base += '_nb' + String((method.toUpperCase() === 'NB' && NB_ENABLE_PREPROCESS) ? 1 : 0);
  }
  return base;
}
function taskLabel(type, aoiName, method) {
  return type + '_' + taskLabelBase(aoiName, method); // TAB/IMG/MOD
}



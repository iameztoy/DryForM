      'score'
    ];
    if (BENCH_INCLUDE_CONFUSION_AND_PERCLASS) {
      selectorsSingle = selectorsSingle.concat([
        'val_labelOrder','val_supportByClass','val_usersAccuracy','val_producersAccuracy','val_f1ByClass','val_confusionMatrix'
      ]);
    }

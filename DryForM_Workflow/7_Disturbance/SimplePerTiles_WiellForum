//from https://groups.google.com/g/google-earth-engine-developers/c/shIVv-ZcIzU/m/oCMXaADLBQAJ

var collection = ee.ImageCollection('LANDSAT/LC08/C02/T1_L2')
  .filterBounds(aoi)
  .map(function (image) {
    var cloudFree = bitwiseExtract(image.select('QA_PIXEL'), 0, 5).eq(0)
    return image.updateMask(cloudFree) 
  })

var segments = ee.Algorithms.TemporalSegmentation.Ccdc({
  collection: collection, 
  breakpointBands: ['SR_B3', 'SR_B4', 'SR_B5', 'SR_B6', 'SR_B7'],
  tmaskBands: ['SR_B3', 'SR_B6'],
  dateFormat: 1, 
}).clip(aoi)

var grid = aoi.coveringGrid(aoi.projection(), 45000)
grid.aggregate_array('system:index').evaluate(function (indexes) {
  indexes.map(function (index, i) {
    var tile = grid
      .filter(ee.Filter.eq('system:index', index))
      .geometry()
    Export.image.toAsset({
      image: segments, 
      description: 'tile-' + i, 
      assetId: 'projects/daniel-wiell/assets/segments-test-tiles/tile-' + i,
      pyramidingPolicy: {'.default': 'sample'}, 
      region: tile, 
      scale: 30,
      maxPixels: 1e13
    })    
  })
})


//Manual version - Need to add a geometry for the tile 



var temporalSegmentation = require('users/iameztoy/DryForest:DryForM_Workflow/7_Disturbance/req/temporalSegmentation');

var segmentsImage = ee.Image('projects/hardy-tenure-383607/assets/DryForm_Project/Change/CCD_FractionalYears/tile321_Cerrado');
print(segmentsImage)

var geometry = segmentsImage.select("tBreak").geometry()
print(geometry.getInfo())
Map.addLayer(geometry, {color:"red"}, "Geometry")

var segments = temporalSegmentation.Segments(segmentsImage, 1);

var dateRange = segments.dateRange('2020-01-01', '2024-05-01');
var breakpoint = dateRange.pickBreakpoint({ 
  breakAnalysisBand: 'ndfi', // The band to use when analyzing which breakpoint to provide data for.
  skipBreakInLastSegment: false, // CCDC sometimes detect breaks in the last segment. These can at times be unreliable.
  breakMagnitudeDirection: 'ANY', // Specify which breakpoints to filtered out, based on weather the break magnitude for the break analysis band decrease or increase. One of ANY, DECREASE, INCREASE
  minBreakConfidence: 6, // The minimum confidence of a breakpoint to be included. This is calculated by the break magnitude divided by the RMSE.
  breakSelection: 'CONFIDENCE' // Specify which of the break points to provide data for. One of FIRST, LAST, MAGNITUDE, CONFIDENCE
});

//gfc20 = gfc20.clip(geometry);

Map.centerObject(segmentsImage);
Map.addLayer(breakpoint.select('tBreak'), {min: 2020, max: 2024, palette: '#000000, #781C81, #3F60AE, #539EB6, #6DB388, #CAB843, #E78532, #D92120'}, 'tBreak');
Map.addLayer(breakpoint.select('ndfi_magnitude'), {min: -25000, max: 25000, palette: '#340D35, #9C3060, #DB8D77, #FFFFFF, #7EB390, #156C72, #151D44'}, 'ndfi_magnitude');
Map.addLayer(breakpoint.select('ndfi_breakConfidence'), {min: 0, max: 20, palette: '#000000, #781C81, #3F60AE, #539EB6, #6DB388, #CAB843, #E78532, #D92120'}, 'ndfi_breakConfidence');

var ndfiMag_gte10k = breakpoint.select('ndfi_magnitude').multiply(-1).gte(10000).selfMask().clip(geometry);
Map.addLayer(ndfiMag_gte10k, {min: 0, max: 1, palette:"red"}, 'ndfi_magnitude Masked');
//var ndfiMag_gte10k_f = ndfiMag_gte10k.updateMask(gfc20);

var mmu_p = 8;
var fcount = ndfiMag_gte10k.connectedPixelCount({maxSize: 200, eightConnected:true});
var mask_gte = fcount.gte(mmu_p);
var ndfiMag_gte10k_m = ndfiMag_gte10k.updateMask(mask_gte).rename("ndfi_magnitue_thr10k_m"); 

Map.addLayer(ndfiMag_gte10k_m.selfMask(), {palette:"orange"}, "Masked NDFI Mag 10000 MMU");

var tBreak_m = breakpoint.select('tBreak').updateMask(mask_gte).clip(geometry);
//tBreak_m = tBreak_m.updateMask(gfc20);
var ndfiMagnitude_m = breakpoint.select('ndfi_magnitude').updateMask(mask_gte).clip(geometry);
//ndfiMagnitude_m = ndfiMagnitude_m.updateMask(gfc20);
var ndfiBreakConf_m = breakpoint.select('ndfi_breakConfidence').updateMask(mask_gte).clip(geometry);
//ndfiBreakConf_m = ndfiBreakConf_m.updateMask(gfc20);


var ndfi_breaks = ee.Image.cat(ndfiMag_gte10k_m, tBreak_m, ndfiMagnitude_m, ndfiBreakConf_m);
print(ndfi_breaks);

Export.image.toAsset({
		image: ndfi_breaks,
    description: "tile321Cerrado",
    assetId: "projects/hardy-tenure-383607/assets/DryForm_Project/Change/CCD_ManualExtract/tile321_Cerrado",
    pyramidingPolicy:{'.default': 'sample'},
//	dimensions:,
//  region: geometry,
    scale:30,
    crs:"EPSG:4326",
//	crsTransform:,
    maxPixels:1e13,
//	shardSize:,
//	priority:,
});


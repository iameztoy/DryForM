//Reconstruct the Sentinel-2 image time series.
//targetdatelist is the discrete or equally-spaced datelist for NDVI and reflectance image time series reconstruction.
//Users cloud replace this datelist with a list of  discrete or equally-spaced dates.
//This datelist is a list of discrete dates.
//var targetdatelist=ee.List(['2020-01-02','2020-03-01','2020-05-22'])
//This datelist is a list of equally-spaced  dates.
var list=ee.List.sequence(0,20,4)
var targetdatelist=list.map(function(i)
{ i = ee.Number(i);
var basedate=ee.Date.fromYMD(targetyear,1,01);
var tagetdate1=basedate.advance(i,"day")
    return tagetdate1;});
for(var k1=0;k1<targetdatelist.length().getInfo();k1++)
{
var targetdate2=ee.Date(targetdatelist.get(k1));
var fractionyear=targetdate2.getFraction('year');
var timeRadians = fractionyear.add(ee.Number(0.5).divide(numindependents)).multiply(Math.PI);
var dctbase0=U.multiply(timeRadians).cos().multiply(ee.Number(2.0).divide(numindependents).sqrt());
var dctbase=ee.List(dctbase0);
var simuimage=dctcomposition.select('coefficients').matrixTranspose()
    .matrixMultiply(ee.Image.constant(dctbase).toArray(1)).float()
    .arrayProject([0]).arrayFlatten([outputbands]);
simuimage=simuimage.set({'system:time_start':targetdate2});
var visualization = {
  min: 0.0,
  max: 0.3,
  bands: ['Red', 'Green', 'Blue'],
};
Map.addLayer(simuimage.clip(roi1),visualization,'simuimage'+targetdate2.format('YYYYMMdd').getInfo());


Export.image.toDrive({
  image:simuimage.clip(roi1),
  description: "simu_"+targetdate2.format('YYYYMMdd').getInfo(),
  region: roi1,
  folder:'zjk',
  scale: 10,
  crs:'EPSG:4326',
  maxPixels:1e13
});

  

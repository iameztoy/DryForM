//--------------------------
//  VISU
//--------------------------

Map.addLayer(gtpoint_trchaco, {color: "green"}, "Training Points Chaco", 0);
Map.addLayer(gtpoint_vlchaco, {color: "orange"}, "Validation Points Chaco", 0);
Map.addLayer(gtpol_trchaco, {color: "green"}, "Training Polygons Chaco", 0);

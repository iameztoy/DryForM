    image2 = ee.Image("projects/hardy-tenure-383607/assets/CountValid_7cl"),
    image3 = ee.Image("projects/hardy-tenure-383607/assets/TC_BRABOLPARURUARG"),
    image4 = ee.Image("projects/hardy-tenure-383607/assets/12months_CloudShadows/sum12_CloudShadow_Chaco"),
    geometry = /* color: #d63000 */ee.Geometry.Point([-63.36826125203669, -28.218686102480216]);

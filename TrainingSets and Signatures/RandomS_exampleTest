var s2 = (ee.ImageCollection('COPERNICUS/S2_SR') // S2_SR_HARMONIZED
    .filterBounds(geometry)
    .filterDate("2020-05-01", "2020-06-01")
    .filter(ee.Filter.lte('CLOUDY_PIXEL_PERCENTAGE', 30)));
    
var s2m = s2.median();
var projs2m = s2m.projection().getInfo()
print(projs2m)
print(s2)

Map.addLayer(image3, null, "Tree Cover")
Map.addLayer(image4, null, "Mask")

var cross = image3.multiply(image4).int8()

print(cross)
Map.addLayer(cross, null, "Cross")

function bufferPoints(radius, bounds) {
  return function(pt) {
    pt = ee.Feature(pt);
    return bounds ? pt.buffer(radius).bounds() : pt.buffer(radius);
  };
}



var pts = cross.stratifiedSample({
	numPoints: 1500,
	classBand: "Trees",
//	region:null,
	scale: 10,
  projection: "EPSG:32720",
//	seed:false,
//	classValues:null,
//	classPoints:null,
	dropNulls:true,
//	tileScale:true,
	geometries:true,
})


var bufsize = 250
var samplesIn = pts.map(bufferPoints(bufsize, true));



var si = samplesIn.geometry()

var covgrid = si.coveringGrid({
		proj: "EPSG:32720",
  	scale: 10
})

var bands = ['B8', 'B4', 'B3'];
Map.addLayer(s2m, {'bands': bands, 'min': 0, 'max': 2500}, "s2", 1)
Map.addLayer(samplesIn, {color: "red"}, "STRS")
Map.addLayer(covgrid, null, "covGrid")



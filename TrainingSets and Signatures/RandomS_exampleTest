var cross = image3.multiply(image4).int8()
var cross = cross.clip(geometry)

//print(cross)


var pts = cross.stratifiedSample({
	numPoints: 10,
	classBand: "Trees",
//	region:null,
	scale: 10,
  projection: "EPSG:32720", //EPGS:4326 | "EPSG:32720"
//	seed:false,
//	classValues:null,
//	classPoints:null,
	dropNulls:true,
	tileScale:4,
	geometries:true,
})

function bufferPoints(radius, bounds) {
  return function(pt) {
    pt = ee.Feature(pt);
    return bounds ? pt.buffer(radius).bounds() : pt.buffer(radius);
  };
}


var bufsize = 250
var samplesIn = pts.map(bufferPoints(bufsize, true));



var si = samplesIn.geometry()

var covgrid = si.coveringGrid({
		proj: "EPSG:32720",
  	scale: 10
})

Map.addLayer(cross, null, "Cross", 0)
Map.addLayer(image3, null, "Tree Cover", 0)
Map.addLayer(image4, null, "Mask", 0)
var bands = ['B4', 'B3', 'B2'];
Map.addLayer(s2m, {'bands': bands, 'min': 0, 'max': 2500}, "s2", 1)
Map.addLayer(samplesIn, {color: "red"}, "STRS")

/**** Start of imports. If edited, may not auto-convert in the playground. ****/
var table = ee.FeatureCollection("projects/hardy-tenure-383607/assets/Glance/glance_qg"),
    geometry = 
    /* color: #d63000 */
    /* shown: false */
    /* displayProperties: [
      {
        "type": "rectangle"
      }
    ] */
    ee.Geometry.Polygon(
        [[[-67.6482482915554, -11.203239603732037],
          [-67.6482482915554, -32.21563239864376],
          [-51.47637329155536, -32.21563239864376],
          [-51.47637329155536, -11.203239603732037]]], null, false),
    vp_7cl = {"opacity":1,"bands":["classification"],"min":1,"max":11,"palette":["318dff","ff341f","d2ac74","d2ac74","d2ac74","88d830","88d830","88d830","ffba74","daff0e","fdff7c"]};
/***** End of imports. If edited, may not auto-convert in the playground. *****/
var samples = table.filterBounds(geometry)
//Map.addLayer(samples)

var water = samples.filter(ee.Filter.eq('Glance_C_1', 1));
var isnow = samples.filter(ee.Filter.eq('Glance_C_1', 2));
var developed = samples.filter(ee.Filter.eq('Glance_C_1', 3));
var soil = samples.filter(ee.Filter.eq('Glance_C_1', 4));
var rock = samples.filter(ee.Filter.eq('Glance_C_1', 5));
var beach = samples.filter(ee.Filter.eq('Glance_C_1', 6));
var decid_v = samples.filter(ee.Filter.eq('Glance_C_1', 7));
var everg_v = samples.filter(ee.Filter.eq('Glance_C_1', 8));
var mixed = samples.filter(ee.Filter.eq('Glance_C_1', 9));
var shrub = samples.filter(ee.Filter.eq('Glance_C_1', 10));
var grass = samples.filter(ee.Filter.eq('Glance_C_1', 11));
var agric = samples.filter(ee.Filter.eq('Glance_C_1', 12));
var mos_li = samples.filter(ee.Filter.eq('Glance_C_1', 13));

var s2 = ee.ImageCollection('COPERNICUS/S2_SR_HARMONIZED');
var filtered = s2
.filter(ee.Filter.lt('CLOUDY_PIXEL_PERCENTAGE', 30))
  .filter(ee.Filter.date('2020-01-01', '2021-01-01'))
  .filter(ee.Filter.bounds(geometry))
  .select('B.*');

var composite = filtered.median();
var gcps = water.merge(developed).merge(soil).merge(rock).merge(beach).merge(decid_v).merge(everg_v)
.merge(mixed).merge(shrub).merge(grass).merge(agric);

//.merge(mos_li).merge(isnow);

var l = gcps.limit(4)
print(l)

// Overlay the point on the image to get training data.
var training = composite.sampleRegions({
  collection: gcps, 
  properties: ['Glance_C_1'], 
  scale: 10
});

// Train a classifier.
var classifier = ee.Classifier.smileRandomForest(50).train({
  features: training,  
  classProperty: 'Glance_C_1', 
  inputProperties: composite.bandNames()
});

print(classifier.explain())

// Using the random forest classifier defined earlier, export the random 
// forest classifier as an Earth Engine asset.
Export.classifier.toAsset(
  classifier,
  "RF_Glance_s2_2020_v0_tr5000"
);

// Display the input composite.
var rgbVis = {
  min: 0.0,
  max: 3000,
  bands: ['B4', 'B3', 'B2'],
};

Map.addLayer(water, null, "Water", 0); 
Map.addLayer(developed, null, "Developed", 0); 
Map.addLayer(soil, null, "Soil", 0); 
Map.addLayer(rock, null, "Rocks", 0); 
Map.addLayer(beach, null, "Beach", 0); 
Map.addLayer(decid_v, null, "Deciduous Vegetation", 0);
Map.addLayer(everg_v, null, "Evergreen Vegetation", 0); 
Map.addLayer(mixed, null, "Mixed", 0); 
Map.addLayer(shrub, null, "Shrubs", 0); 
Map.addLayer(grass, null, "Grass", 0);
Map.addLayer(agric, null, "Agriculture", 0); 

Map.addLayer(composite.clip(geometry), rgbVis, 'image');
//Map.addLayer(isnow, null, "Ice/Snow", 0); 
//Map.addLayer(mos_li, null, "Lichen/Moss", 0);

// Inference

// Once the classifier export finishes, we can load our saved classifier.
var classifierAssetId = "projects/hardy-tenure-383607/assets/RF_Glance_s2_2020_v0";
var classifierAssetId_tr500 = "projects/hardy-tenure-383607/assets/RF_Glance_s2_2020_v0_tr500";
//var classifierAssetId_tr5000 = "projects/hardy-tenure-383607/assets/RF_Glance_s2_2020_v0_tr5000";
var savedClassifier = ee.Classifier.load(classifierAssetId);
var savedClassifier_tr500 = ee.Classifier.load(classifierAssetId_tr500);
//var savedClassifier_tr5000 = ee.Classifier.load(classifierAssetId_tr5000);


// // Classify the image.
var classified = composite.classify(savedClassifier);
var classified_tr500 = composite.classify(savedClassifier_tr500);
var classified_tr5000 = composite.classify(savedClassifier_tr5000);
// Choose a 4-color palette
// Assign a color for each class in the following order
// Urban, Bare, Water, Vegetation

Map.addLayer(classified.clip(geometry), vp_7cl, "Classified v0");
Map.addLayer(classified_tr500.clip(geometry), vp_7cl, "Classified v0 tr500");
Map.addLayer(classified_tr5000.clip(geometry), vp_7cl, "Classified v0 tr5000");



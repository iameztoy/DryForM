var fromList = [-1, 0, 1];
var toList =   [0, 0, 1];

var hansen_TC_2020_r = hansen_TC_2020.remap({
  from: fromList,
  to: toList,
  defaultValue: 0,
  bandName: 'treecover2000'
});


var r1 = esa2020Forest.rename("f");

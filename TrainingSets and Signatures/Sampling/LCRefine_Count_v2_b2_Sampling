var chaco = chaco.geometry();
var Zones = chaco.coveringGrid({
  	proj: "EPSG:4326", //EPSG:32720
  	scale: 100000
});

// CoveringGrid produces a strage ID so I make a new fc with proper
// unique id so are parsed to the name while exporting.
// with earth engine plugin for Chrome we can use "Run All" option to 
// run all at once (note that client may crash if there are many features,
// although if we wait, it may still work; just push wait)

// make a list of length of features
var idList = ee.List.sequence(0,Zones.size().subtract(1));

// featureCollection to a List
var list = Zones.toList(Zones.size());

// set the system:index
var zonesID = ee.FeatureCollection(idList.map(function(newSysIndex){
  var feat = ee.Feature(list.get(newSysIndex));
  // format number to string (system:index must be a string)
  var indexString = ee.Number(newSysIndex).format('%03d')
  return feat.set('system:index', indexString, 'ID', indexString);
}));

// print('list system:index OLD', Zones.aggregate_array('system:index'));
// print('list system:index NEW', zonesID.aggregate_array('system:index'));

////////////// EXPORTING ///////////////////////
var featlist = zonesID.getInfo()["features"];
for (var f in featlist) {
  var feat = ee.Feature(featlist[f]);
  var dis = feat.get("ID");
  var disS = dis.getInfo();
  var name = "chip";  
  Export.image.toDrive({
    image: SumTC_4cl_rK,
    description: name+disS, //.toString(),
    folder: "Zones_test",
    fileNamePrefix: name+disS, //.toString(), (only if integer ID)
    region: feat.geometry().bounds(),
    scale: 10,
    maxPixels: 1e13
  });
}


function ndvi(img){
  var thisNDVI = img.normalizedDifference(['B8', 'B4']).rename('NDVI');
  return img.addBands(thisNDVI);
}
function ndviCloud(img){
  var thisNDVI = img.normalizedDifference(['nir', 'red']).rename('NDVI');
  return img.addBands(thisNDVI);
}

function shadow(img){
  //( (1-b2)*(1-b3)*(1-b4) )^(1/3)
  var si = img.expression(
    '( (1-red)*(1-green)*(1-blue)**(0.333333) )', {
      'red': img.select('red'),
      'green': img.select('green'),
      'blue': img.select('blue')}).rename('shadow');
  return img.addBands(si);
}


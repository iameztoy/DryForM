function filterNdvi(input,nbFiles){
  // sort input in chronological order
  var collection = input.sort('system:time_start', true).toList(nbFiles);
  var resultFilter = ee.List.sequence(1, nbFiles-2, 1).map(function(ii){

    var img  = ee.Image(collection.get(ee.Number(ii)));
    var img1 = ee.Image(collection.get(ee.Number(ii).subtract(ee.Number(1))));
    var img2 = ee.Image(collection.get(ee.Number(ii).add(ee.Number(1))));
    var difa = img1.subtract(img).divide(img1);
    var difb = img2.subtract(img).divide(img2);
  
    var interpol= img.where(difa.gt(DropNdvi).multiply(difb.gt(DropNdvi)), img1.add(img2).multiply(0.5)); //ne fonctionne que s'il y a des valeurs dans les deux images
    return interpol.copyProperties(img)
  })
  
  // rajout des mois de janv et decembre qui n'ont pas été interpolés
  resultFilter = ee.List(resultFilter).insert(0, ee.Image(collection.get(ee.Number(0))));
  resultFilter = ee.List(resultFilter).insert(nbFiles-1, ee.Image(collection.get(ee.Number(nbFiles-1))));//verify
  
  return resultFilter
}


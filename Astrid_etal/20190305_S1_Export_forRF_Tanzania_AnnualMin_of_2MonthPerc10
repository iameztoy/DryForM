function radarViewVV(startDate, endDate, clipper, polarisation, orbit){
  
  if (typeof clipper === 'string') {
    var thisArea = countries
      .filterMetadata('country_na', 'Contains', clipper);
  } else {thisArea = clipper}
  
  var sentinel1 = ee.ImageCollection('COPERNICUS/S1_GRD')
              .filterBounds(thisArea)
              .filterDate(startDate, endDate)
              .filterMetadata('instrumentMode', 'equals', 'IW')
              .filterMetadata('resolution', 'equals', 'H')
  var subset = sentinel1
              .filter(ee.Filter.listContains('transmitterReceiverPolarisation', polarisation))
              .select([polarisation]);

    var ascending = subset.filter(ee.Filter.eq('orbitProperties_pass', 'ASCENDING'));
    var descending = subset.filter(ee.Filter.eq('orbitProperties_pass', 'DESCENDING'));
    //print ('#Ascending ',ascending.size(), '#Descending',descending.size());

    var ascendingComp = ascending.map(erodeGeometry).map(maskEdgeVV);
    var descendingComp = descending.map(erodeGeometry).map(maskEdgeVV);
    
    var synth = 0;
    if (orbit=='ASCENDING') {
      print('Processing Ascending');
      synth = ascendingComp;
    } else if (orbit=='DESCENDING') {
      print('Processing Descending');
      synth = descendingComp;
    } else {
      print('Processing Ascending and Descending');
      synth = ee.ImageCollection(ascendingComp.merge(descendingComp));
    }

    var minRadar = synth.reduce(ee.Reducer.percentile([10]));
    var maxRadar = synth.reduce(ee.Reducer.percentile([90]));
    var medianRadar = synth.median();
    var meanRadar = synth.map(toNatural).map(RefinedLee).mean().log10().multiply(10.0)//modif astrid
    
    return ee.List([minRadar, meanRadar, medianRadar, maxRadar]);
}


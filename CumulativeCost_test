var forest = ee.ImageCollection('projects/hardy-tenure-383607/assets/EUFO_Forest2020_v1_post_MMUAreaProj').mosaic().unmask()
forest = forest.clip(geometry)

var f_unm = forest.selfMask()

var geodetic = forest.cumulativeCost({
		source:forest,
		maxDistance:50,
	geodeticDistance:true,
})

var planar = forest.cumulativeCost({
		source:forest,
		maxDistance:50,
	geodeticDistance:false,
})

var nospec = forest.cumulativeCost({
		source:forest,
		maxDistance:50,
	//geodeticDistance:false,
})

Map.addLayer(geodetic, vp_geo, "geodetic")
Map.addLayer(planar,vp_pl, "planar")
Map.addLayer(nospec, null, "no espec")

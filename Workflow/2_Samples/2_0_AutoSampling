
//***********************************************************
// DRYFORM - Step 2_0 - Ground Truth Auto-sampling
//***********************************************************

/*
 This scripts generates ground sampling points automatically based on the sampling framework
    created in Step 1. Point 2 below. The idea of the sampling framework is twofold:
      1/ To generate a preliminary land cover proxy layer that is used to extract preliminary sampling points. These are visually interpreted afterwards
          in a GIS environment using VHR (basempas and Planet via NICFI). These sampling points are used to train the RF model implemented in step 5.
         The idea here is to boost productivity.
      2/ To generate the points automatically with no visual supervision and see how the classification performs
          compared to the classification carried out with the sampling points generated in 1/
          It is only created for experimental purposes. 
      3/ If there is any computation time out, it is also possible to run the sampling out of GEE and import after the features created.
*/

// Areas of Interest
var caatinga = ee.FeatureCollection("users/iameztoy/dryform/AOIs/eco_zone_Caatinga");
var cerrado = ee.FeatureCollection("users/iameztoy/dryform/AOIs/eco_zone_Cerrado");
var chaco = ee.FeatureCollection("users/iameztoy/dryform/AOIs/eco_zone_Chaco");
var tanzania = ee.FeatureCollection("users/iameztoy/dryform/AOIs/zone_Tanzania");

var aoi = caatinga;
var aoi_n = "caatinga";
var npoints = 150; // Number of samples to be generated

//Sampling Framework created in step 1
var lc = ee.ImageCollection("projects/hardy-tenure-383607/assets/DryForm_Project/Framework/LC_Refine").mosaic().clip(aoi); 
lc = lc.rename("lc");
print(lc);

// Allocate the sampling points with Stratified Random Sampling (equal/balanced number of points for Random Forest)
var samples = lc.stratifiedSample({
		numPoints: npoints,
    classBand: "lc",
    region: aoi,
    scale: 10,
//	projection:null,
//	seed:false,
//	classValues:null,
//	classPoints:null,
    dropNulls:true,
    tileScale: 16, // This can be probably lowered to make the process faster. 
    geometries: true,
});

// Export the samples to asset
Export.table.toAsset({
		collection: samples,
    description: "AutoSamples_" + aoi_n + npoints.toString(),
    assetId: "projects/hardy-tenure-383607/assets/DryForm_Project/GroundTruth/"+"AutoSamples_" + aoi_n + npoints.toString(),
//	maxVertices:,
//	priority:,
});
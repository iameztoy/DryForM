/**** Start of imports. If edited, may not auto-convert in the playground. ****/
var table = ee.FeatureCollection("users/iameztoy/dryform/AOIs/eco_zone_Chaco");
/***** End of imports. If edited, may not auto-convert in the playground. *****/
var dataset = ee.ImageCollection('ESA/WorldCover/v100').first();

var visualization = {
  bands: ['Map'],
};

Map.centerObject(dataset);

Map.addLayer(dataset, visualization, 'Landcover');

var wri = ee.ImageCollection("projects/wri-datalab/TropicalTreeCover").mosaic();
var wri_tree = wri.gte(50);
Map.addLayer(wri_tree.selfMask(), {color: "green"}, "WRI", 1)

//***********************************************************
// DRYFORM - Step 5.2 - Training
//***********************************************************

//From (remove): https://courses.spatialthoughts.com/end-to-end-gee.html

// pb = Pixel Based
// oo = Object Oriented

//Areas of Interest | Included within the Ground Truth 
var chaco = "chaco";
var caatinga = "caatinga";
var cerrado = "cerrado";
var tanzania = "tanzania";

// Ground Truth attribute to be used:
var landcover = "visulcrec"; // or visu_lc / visulcrec

// Imagery 
// Pixel based is an Image Collection (needs mosaicing) while Object Oriented image is an Image

var AllChaco_pb = ee.ImageCollection("projects/hardy-tenure-383607/assets/Preprocessing/s1s2_Chaco").mosaic();
var AllChaco_oo = ee.Image("projects/hardy-tenure-383607/assets/DryForm_Project/Segmentation/Chaco_SNIC_sNAc0c8n256se12");

// Ground Truth

// Notes:

// ** visu_lc attribute is the original disaggregated version of the visual interpretation step
//        
//        It includes 13 classes:
//          tc1	1, tc2	1, tc3	1, shrub	2, owl	2, grass	3, grasstree	3, mangroves	4, Flooded Veg.	5
//          built	6, PWater	7, SWater	0, Bare	9,  Crops	10
//          Not Included: tc4, tc5, tc67, Snow, moss/lichen
// ** visulcrec attribute is the reclassified version of the disaggregated version (visu_lc). 
//        It includes 9 classes:
//          tc1	1, tc2	1, tc3	1, shrub	2, owl	2, grass	3, grasstree	3, mangroves	4, Flooded Veg.	5
//          built	6, PWater	7, SWater	0, Bare	9,  Crops	10
//          Not Included: tc4, tc5, tc67, Snow, moss/lichen

var GroundTruthPoint_DF = ee.FeatureCollection("projects/hardy-tenure-383607/assets/DryForm_Project/GroundTruth/GroundTruthPoint_DF");
var GroundTruthPol_DF = ee.FeatureCollection("projects/hardy-tenure-383607/assets/DryForm_Project/GroundTruth/GroundTruthPol_DF");

// Chaco Points 
var gtpoint_chaco = GroundTruthPoint_DF.filter(ee.Filter.eq('aoiname', chaco));
var gtpoint_trchaco =  gtpoint_chaco.filter(ee.Filter.eq('purp', "training"));
var gtpoint_vlchaco =  gtpoint_chaco.filter(ee.Filter.eq('purp', "validation"));

var ttt0 = gtpoint_trchaco.filter(ee.Filter.eq("visulcrec", 1));
print("ttt0", ttt0.size())

print("Original Training", gtpoint_trchaco.size());
print("Original Validation", gtpoint_vlchaco.size());


// For the Pixel Based approach -> Balance classes
// In order to balance the class respect the other classes, the target column in randomized and merged again with the other classes.

    // Classes TC TC(1) + TC(2) + TC(3)
    // Total number of the three tree cover classes is 450 (tc1+tc2+tc3). Balanced samples are 150 approx.

var aTC = gtpoint_trchaco.filter(ee.Filter.lte("visu_lc", 3)); // First we select the Tree Cover class from the visu_lc attribute (Anything below or equal 3)
var bTC = aTC.randomColumn(); // We create a random values column
var cTC = bTC.filter('random > 0.6'); //We select a % over the random column. For random > 0 -> 450 classes. For 0.65: 159 samples 0.5: 221 samples

    // Classes Shrub(7 or 2) and OWL(8 or 2). There are different alternatives:
      // 1. Keep them separated (not very convenient for the pixel based approach), 2. Merge them, 3. Keep only shrub class 
      
var aSh = gtpoint_trchaco.filter(ee.Filter.eq("visu_lc", 7));

    // Class Grass(9 or 3) and GrassTree (10 or 3). There are different alternatives
      // 1. Keep them separated (not very convenient for the pixel based approach), 2. Merge them, 3. Keep only shrub class 

var aGr = gtpoint_trchaco.filter(ee.Filter.eq("visu_lc", 9));
var gt11 =  gtpoint_trchaco.filter(ee.Filter.gt("visu_lc", 11)); // Select all the other classes and merge 


  // We merge the newly created columns into the final training set
gtpoint_trchaco = gt11.merge(cTC).merge(aSh).merge(aGr); 

// Rename the inputs | Final set for RF
var composite = AllChaco_pb;
var trainingGcp = gtpoint_trchaco;
var validationGcp = gtpoint_vlchaco;
print("Training GCP Final", trainingGcp);
print("Validation GCP Final", validationGcp);

var ttt = gtpoint_trchaco.filter(ee.Filter.eq("visulcrec", 1));
print("Filter ttt", ttt)


// Overlay the point on the image to get training data.
var training = composite.sampleRegions({
  collection: trainingGcp, 
  properties: [landcover], 
  scale: 10
});

Map.addLayer(composite, null, "S1-S2 Composite")
Map.addLayer(trainingGcp, null, "Training Points")

// Train a classifier.
// Use here the parameters established in the Hyperparameter Tunning step
var classifier = ee.Classifier.smileRandomForest({
		numberOfTrees: 80, // The number of decision trees to create.
//	variablesPerSplit: null, // The number of variables per split. If unspecified, uses the square root of the number of variables.
//	minLeafPopulation: true, // Only create nodes whose training set contains at least this many points.
//	bagFraction :0.5, //The fraction of input to bag per tree.
//	maxNodes: null, //The maximum number of leaf nodes in each tree. If unspecified, defaults to no limit.
//	seed:false, // The randomization seed.
  }).train({
  features: training,  
  classProperty: landcover, 
  inputProperties: composite.bandNames()
});

// // Classify the image.
var classified = composite.classify(classifier);

Map.addLayer(classified, null, 'LC 2020');
print("Classified", classified)

//************************************************************************** 
// Accuracy Assessment
//************************************************************************** 

// Use classification map to assess accuracy using the validation fraction
// of the overall training set created above.
var test = classified.sampleRegions({
  collection: validationGcp,
  properties: [landcover],
  tileScale: 16,
  scale: 10,
});

var testConfusionMatrix = test.errorMatrix(landcover, 'classification');

print('Confusion Matrix', testConfusionMatrix);
print('Test Accuracy', testConfusionMatrix.accuracy());

// Alternate workflow 
// This is similar to machine learning practice
var validation = composite.sampleRegions({
  collection: validationGcp,
  properties: [landcover],
  scale: 10,
  tileScale: 16
});

var test = validation.classify(classifier);

var testConfusionMatrix = test.errorMatrix('landcover', 'classification')
// Printing of confusion matrix may time out. Alternatively, you can export it as CSV
print('Confusion Matrix', testConfusionMatrix);
print('Test Accuracy', testConfusionMatrix.accuracy());

Map.addLayer(table, {color: "red"})
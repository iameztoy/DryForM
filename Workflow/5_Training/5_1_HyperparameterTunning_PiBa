
//***********************************************************
// DRYFORM - Step 5.1 - Hyperparameter Tunning
//***********************************************************

// pb = Pixel Based
// oo = Object Oriented

//Areas of Interest | Included within the Ground Truth 
var chaco = "chaco";
var caatinga = "caatinga";
var cerrado = "cerrado";
var tanzania = "tanzania";

// Ground Truth attribute to be used:
var landcover = "visulcrec"; // or visu_lc

// Imagery 
// Pixel based is an Image Collection (needs mosaicing) while Object Oriented image is an Image

var AllChaco_pb = ee.ImageCollection("projects/hardy-tenure-383607/assets/Preprocessing/s1s2_Chaco").mosaic();
var AllChaco_oo = ee.Image("projects/hardy-tenure-383607/assets/DryForm_Project/Segmentation/Chaco_SNIC_sNAc0c8n256se24_sBands");

// Ground Truth

// Notes:

// ** visu_lc attribute is the original disaggregated version of the visual interpretation step
//        
//        It includes 13 classes:
//          tc1	1, tc2	1, tc3	1, shrub	2, owl	2, grass	3, grasstree	3, mangroves	4, Flooded Veg.	5
//          built	6, PWater	7, SWater	0, Bare	9,  Crops	10
//          Not Included: tc4, tc5, tc67, Snow, moss/lichen
// ** visulcrec attribute is the reclassified version of the disaggregated version (visu_lc). 
//        It includes 9 classes:
//          tc1	1, tc2	1, tc3	1, shrub	2, owl	2, grass	3, grasstree	3, mangroves	4, Flooded Veg.	5
//          built	6, PWater	7, SWater	0, Bare	9,  Crops	10
//          Not Included: tc4, tc5, tc67, Snow, moss/lichen

var GroundTruthPoint_DF = ee.FeatureCollection("projects/hardy-tenure-383607/assets/DryForm_Project/GroundTruth/GroundTruthPoint_DF");
var GroundTruthPol_DF = ee.FeatureCollection("projects/hardy-tenure-383607/assets/DryForm_Project/GroundTruth/GroundTruthPol_DF");

// Chaco Points 
var gtpoint_chaco = GroundTruthPoint_DF.filter(ee.Filter.eq('aoiname', chaco));
var gtpoint_trchaco =  gtpoint_chaco.filter(ee.Filter.eq('purp', "training"));
var gtpoint_vlchaco =  gtpoint_chaco.filter(ee.Filter.eq('purp', "validation"));

// For the Pixel Based approach -> Balance classes
// In order to balance the class respect the other classes, the target column in randomized and merged again with the other classes.

    // Classes TC TC(1) + TC(2) + TC(3)
    // Total number of the three tree cover classes is 450 (tc1+tc2+tc3). Balanced samples are 150 approx.

var aTC = gtpoint_trchaco.filter(ee.Filter.lte("visu_lc", 3)); // First we select the Tree Cover class from the visu_lc attribute (Anything below or equal 3)
var bTC = aTC.randomColumn(); // We create a random values column
var cTC = bTC.filter('random > 0.60'); //We select a % over the random column. For random > 0 -> 450 classes. For 0.65: 159 samples 0.5: 221 samples
print("Random Filtered TC class", cTC);

    // Classes Shrub(7 or 2) and OWL(8 or 2). There are different alternatives:
      // 1. Keep them separated (not very convenient for the pixel based approach), 2. Merge them, 3. Keep only shrub class 
      
var aSh = gtpoint_trchaco.filter(ee.Filter.eq("visu_lc", 7));

    // Class Grass(9 or 3) and GrassTree (10 or 3). There are different alternatives
      // 1. Keep them separated (not very convenient for the pixel based approach), 2. Merge them, 3. Keep only shrub class 

var aGr = gtpoint_trchaco.filter(ee.Filter.eq("visu_lc", 9));
var gt11 =  gtpoint_trchaco.filter(ee.Filter.gt("visu_lc", 11)); // Select all the other classes and merge 

  // We merge the newly created columns into the final training set
gtpoint_trchaco = gt11.merge(cTC).merge(aSh).merge(aGr); 
print("Final samples", gtpoint_trchaco);

var buffer = function(feature) {
return feature.buffer(20)};
gtpoint_trchaco = gtpoint_trchaco.map(buffer);
validationGcp = gtpoint_vlchaco.map(buffer);

// Rename the inputs | Final set for RF
var composite = AllChaco_pb;
var trainingGcp = gtpoint_trchaco;
var validationGcp = gtpoint_vlchaco;
print("Training GCP", trainingGcp);
print("Validation GCP", validationGcp);


var training = composite.sampleRegions({
  collection: trainingGcp,
  properties: [landcover], // The points corresponding to visual inspection
  scale: 10,
  tileScale: 16
});

//************************************************************************** 
// Implement RF
//************************************************************************** 

print("Training", training);
var classifier = ee.Classifier.smileRandomForest(80)
.train({
  features: training,  
  classProperty: landcover,
  inputProperties: composite.bandNames()
});


//************************************************************************** 
// Feature Importance | Accuracies, etc.
//************************************************************************** 

// Preliminary - Need to re-run with the parameters decided in the
// hyperparameter tuning phase.

// Run .explain() to see what the classifer looks like
print("Classifier", classifier.explain());

// Get a confusion matrix and overall accuracy for the training sample.
var trainAccuracy = classifier.confusionMatrix();
print('Training error matrix', trainAccuracy);
print('Training overall accuracy', trainAccuracy.accuracy());

// Calculate variable importance
var importance = ee.Dictionary(classifier.explain().get('importance'));

// Calculate relative importance
var sum = importance.values().reduce(ee.Reducer.sum());

var relativeImportance = importance.map(function(key, val) {
   return (ee.Number(val).multiply(100)).divide(sum);
  });
print(relativeImportance);

// Create a FeatureCollection so we can chart it
var importanceFc = ee.FeatureCollection([
  ee.Feature(null, relativeImportance)
]);

var chart = ui.Chart.feature.byProperty({
  features: importanceFc
}).setOptions({
      title: 'Feature Importance',
      vAxis: {title: 'Importance'},
      hAxis: {title: 'Feature'}
  });
print(chart);

//************************************************************************** 
// Hyperparameter Tuning - Only Number of Trees
//************************************************************************** 

var test = composite.sampleRegions({
  collection: validationGcp,
  properties: [landcover],
  scale: 10,
  tileScale: 16
});

// Tune the numberOfTrees parameter.
var numTreesList = ee.List.sequence(10, 500, 10); // More than 500 out of memory

var accuracies = numTreesList.map(function(numTrees) {
  var classifier = ee.Classifier.smileRandomForest(numTrees)
      .train({
        features: training,
        classProperty: landcover,
        inputProperties: composite.bandNames()
      });

  // Here we are classifying a table instead of an image
  // Classifiers work on both images and tables
  return test
    .classify(classifier)
    .errorMatrix(landcover, 'classification')
    .accuracy();
});

var chart = ui.Chart.array.values({
  array: ee.Array(accuracies),
  axis: 0,
  xLabels: numTreesList
  }).setOptions({
      title: 'Hyperparameter Tuning for the numberOfTrees Parameters',
      vAxis: {title: 'Validation Accuracy'},
      hAxis: {title: 'Number of Tress', gridlines: {count: 15}}
  });
print(chart);


//************************************************************************** 
// Hyperparameter Tuning - Multiple Parameter x2 | nTrees and Bag Fraction
//************************************************************************** 

// We can tune many parameters together using
// nested map() functions
// Let's tune 2 parameters
// numTrees and bagFraction 
var numTreesList = ee.List.sequence(10, 500, 10);
var bagFractionList = ee.List.sequence(0.1, 0.9, 0.1);

var accuracies = numTreesList.map(function(numTrees) {
  return bagFractionList.map(function(bagFraction) {
     var classifier = ee.Classifier.smileRandomForest({
       numberOfTrees: numTrees,
       bagFraction: bagFraction
     })
      .train({
        features: training,
        classProperty: landcover,
        inputProperties: composite.bandNames()
      });

    // Here we are classifying a table instead of an image
    // Classifiers work on both images and tables
    var accuracy = test
      .classify(classifier)
      .errorMatrix(landcover, 'classification')
      .accuracy();
    return ee.Feature(null, {'accuracy': accuracy,
      'numberOfTrees': numTrees,
      'bagFraction': bagFraction});
  });
}).flatten();
var resultFc = ee.FeatureCollection(accuracies);


//from https://gis.stackexchange.com/questions/409273/proportional-stratified-random-sample-in-google-earth-engine-setting-class-poi/409304

//filter NLCD for contiguous US landcover band 2001-2016
var nlcd = imageCollection
.filterDate('2001-01-01','2001-12-31')
.filterBounds(geometry)
.select('landcover');
//get nlcd projection
var PRJ = nlcd.first().projection();
print(PRJ)

//get two focal mean -- grass and crop percent
var nlcd2001 = nlcd.max();
var crop = nlcd2001.eq(82).focalMean(1800,'square','meters').multiply(100).toInt();
var grass = nlcd2001.eq(71)
.or(nlcd2001.eq(81))
.or(nlcd2001.eq(95)).focalMean(1800,'square','meters').multiply(100).toInt();
var all_clipped = crop.addBands(grass).clip(geometry);


//training data for clusterer
var training = all_clipped.sample({
  region: geometry,
  scale: 270,
  numPixels: 500
});

//clusterer
var clusterer = ee.Clusterer.wekaKMeans(8).train(training);
var strata = all_clipped.cluster(clusterer).rename('clusters');
Map.addLayer(strata, {min:0,max:7,palette:['indigo','cyan','limegreen','yellow']},'strata')

var pixelCount = strata.reduceRegion({
  geometry: geometry,
  scale: 270,
  crs:PRJ,
  reducer: ee.Reducer.frequencyHistogram().unweighted(),
  maxPixels: 70000000000,
}).get('clusters')

print(pixelCount)


//need help here 

var dataset = ee.Image("users/andreatassi23/DATASET_COMPOSITION")
print("origial", dataset)

Map.addLayer(dataset, vp_original, "Original")
Map.centerObject(dataset)


var gray = dataset.expression(
      '(0.3 * NIR) + (0.59 * R) + (0.11 * G)', {
      'NIR': dataset.select('B8'),
      'R': dataset.select('B4'),
      'G': dataset.select('B3')
}).rename('gray');

var glcm = gray.unitScale(0, 0.30).multiply(100).toInt().glcmTexture({size: 2});

print("GLCM", glcm)

Map.addLayer(glcm.select("gray_asm"), null, "Gray asm")

function deleteChildren(ImgCollection){
var n = ImgCollection.size().getInfo();
  var colList = ImgCollection.toList(n);
  var assetFolder = 'projects/hardy-tenure-383607/assets/DistanceForestEdge3_1/';
  
  for (var i = 0; i < n; i++) {
    var img = ee.Image(colList.get(i));
    var id = img.id().getInfo() || 'image_'+i.toString();
    var assetId = assetFolder+id;
    ee.data.deleteAsset(assetId);
  }
}


deleteChildren(ic)
//  BARE
// ---------------------

// The Majority class of bare soil areas is prioritized over all others except snow, jrc_waterse, crops, built. Therefore, all others should be masked

//First we mask from bare the classes that will be not masked
var mask4bare = snow.or(jrc_waterse).or(crop_maj).or(built_maj_m);
bare_maj = bare_maj.updateMask(mask4bare.not()).unmask();

//We apply the masks
tree_maj1 = tree_maj1.updateMask(bare_maj.not()).unmask();
tree_maj2 = tree_maj2.updateMask(bare_maj.not()).unmask();
tree_maj3 = tree_maj3.updateMask(bare_maj.not()).unmask();
tree_maj4 = tree_maj4.updateMask(bare_maj.not()).unmask();
tree_maj5 = tree_maj5.updateMask(bare_maj.not()).unmask();

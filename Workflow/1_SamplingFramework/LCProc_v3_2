*/

//Map.addLayer(Zones,{},'Zones',false);

// ---- !!! --- Notes --- Need to be corrected !!! ---
// There are seasonal water pixels over built - Correct? Some are fine. 
    //Some isolated pixels can be corrected by connectedPixels 1 or 2? 
    //Perhaps remove Seasonal waters from coastlines? Some overlap too much.

// LC products

var esawc = ee.ImageCollection("ESA/WorldCover/v200").first(); //v100 also available
var glc = ee.ImageCollection("projects/sat-io/open-datasets/FROM-GLC10").mosaic(); //'FROM-GLC10 Land Cover'
var dw = ee.ImageCollection("GOOGLE/DYNAMICWORLD/V1"); //+Info: https://developers.google.com/earth-engine/datasets/catalog/GOOGLE_DYNAMICWORLD_V1#bands
var esri = ee.ImageCollection("projects/sat-io/open-datasets/landcover/ESRI_Global-LULC_10m").mosaic(); //+Info https://gee-community-catalog.org/projects/esrilc2020/
var wri = ee.ImageCollection("projects/wri-datalab/TropicalTreeCover").mosaic();
var gfc = ee.Image("UMD/hansen/global_forest_change_2021_v1_9"); 
var glclc20 = ee.Image('projects/glad/GLCLU2020/v2/LCLUC_2020').updateMask(ee.Image("projects/glad/OceanMask").lte(1));
var glclc19 = ee.ImageCollection('projects/glad/GLCmap2019').mosaic(); //// UMD Land cover map 2019 - Legend - https://storage.googleapis.com/earthenginepartners-hansen/GLCLU_2019/legend.xlsx
var osmw = ee.ImageCollection("projects/sat-io/open-datasets/OSM_waterLayer"); //https://gee-community-catalog.org/projects/osm_water/?h=water
//var jrc_water = ee.ImageCollection('JRC/GSW1_4/YearlyHistory'); 
var jrc_water = ee.Image('JRC/GSW1_4/YearlyHistory/2020');  //#99d9ea: Seasonal Water, #0000ff Permanent Water
var glacier_ft = ee.FeatureCollection("projects/sat-io/open-datasets/RGI/RGI_VECTOR_MERGED_V7");


var cropmask_UMD_2003=ee.ImageCollection('users/potapovpeter/Global_cropland_2003').mosaic().unmask(); 
var cropmask_UMD_2007=ee.ImageCollection('users/potapovpeter/Global_cropland_2007').mosaic().unmask(); 
var cropmask_UMD_2011=ee.ImageCollection('users/potapovpeter/Global_cropland_2011').mosaic().unmask(); 
var cropmask_UMD_2015=ee.ImageCollection('users/potapovpeter/Global_cropland_2015').mosaic().unmask(); 
var cropmask_UMD_2019=ee.ImageCollection('users/potapovpeter/Global_cropland_2019').mosaic().unmask(); 

//--------------
// VARIABLES GENERAL

Map.setOptions("SATELLITE");
var srt = '2020-01-01'; var end = '2021-01-01';

// Visu

var vp_trees1 = {"opacity":1,"palette":["005200"]},
    vp_trees2 = {"opacity":1,"palette":["007400"]},
    vp_trees3 = {"opacity":1,"palette":["009f00"]},
    vp_trees4 = {"opacity":1,"palette":["00ba00"]},
    vp_trees5 = {"opacity":1,"palette":["e2bc31"]}, // Changed the color as it might be a transition zone between low tree cover and shrubs
    vp_trees6 = {"opacity":1,"palette":["00eb00"]},
    vp_trees7 = {"opacity":1,"palette":["aceb14"]},
    vp_trees67 = {"opacity":1,"palette":["00d800"]},
    vp_shrub = {"opacity":1,"palette":["ffbb22"]},
    vp_owl = {"opacity":1,"palette":["d28230"]},
    vp_grasstree = {"opacity":1,"palette":["d8ff60"]},
    vp_grass = {"opacity":1,"palette":["ffff4c"]},
    vp_crop = {"opacity":0.7,"palette":["f096ff"]},
    vp_built = {"opacity":1,"palette":["fa0000"]},
    vp_bare = {"opacity":1,"palette":["b4b4b4"]},
    vp_snow = {"opacity":1,"palette":["f0f0f0"]},
    vp_water = {"opacity":1,"palette":["0064c8"]},
    vp_waterse = {"opacity":1,"palette":["99d9ea"]},
    vp_floodv = {"opacity":1,"palette":["0096a0"]},
    vp_mang = {"opacity":1,"palette":["00cf75"]},
    vp_mossl = {"opacity":1,"palette":["fae6a0"]},
    vp_writrees = {"opacity":1,"palette":["97ff56"]},
    vp_ghsl = {"opacity":1,"palette":["ff0000"]},
    vp_wri_masked = {"opacity":0.79,"palette":["b4ff62"]};
    
  
// Define a palette for the 18 distinct land cover classes.
var lc_Palette = [
  '000000', // 0 nodata 
  '005200', // 1 TC-1   
  '007400', // 2 TC-2
  '009f00', // 3 TC-3
  '00ba00', // 4 TC-4
  'e2bc31', // 5  TC-5
  '00d800', // 6 TC-67
  'ffbb22', // 7 Shrub
  'd28230', // 8 OWL
  'ffff4c', // 9 Grass
  'ffff4c', // 10 Grass-Tree
  'd8ff60', // 11 Mangroves
  '00cf75', // 12 Herbaceous Veg.
  'fa0000', // 13 Built-up
  '0064c8', // 14 Permanent Water
  '99d9ea', // 15 Seasonal Water
  'f0f0f0', // 16 Snow
  'f0f0f0', // 17 Bare
  'fae6a0', // 18 Mosch/Lin
  'f096ff'  // 19 Crops
];

//var Final_lc = {"opacity":1,"bands":["Tree1"],"max":18,"palette":["000000","005200","007400","009f00","00ba00","e2bc31","00d800","ffbb22","d28230","ffff4c","d8ff60","00cf75","0096a0","fa0000","0064c8","99d9ea","f0f0f0","b4b4b4","fae6a0"]};


//--------------
// SELECT CLASSES

// 1. ESA World Cover

var wc_tree = esawc.eq(10).rename(['wc_trees']);  
var wc_shrub = esawc.eq(20).rename(['wc_shrub']); 
var wc_grass =  esawc.eq(30).rename(['wc_grass']); 
var wc_crop = esawc.eq(40).rename(['wc_crop']); 
var wc_built = esawc.eq(50).rename(['wc_built']); 
var wc_bare = esawc.eq(60).rename(['wc_bare']); 
var wc_snow = esawc.eq(70).rename(['wc_snow']); 
var wc_water = esawc.eq(80).rename(['wc_water']); 
var wc_floodv = esawc.eq(90).rename(['wc_floodv']); 
var wc_mang = esawc.eq(95).rename(['wc_mang']); 
var wc_mossl = esawc.eq(100).rename(['wc_mossl']); 

// 2. GLC

var glc_tree = glc.eq(20).rename(['glc_tree']); 
var glc_shrub = glc.eq(40).rename(['glc_shrub']); 
var glc_grass = glc.eq(30).rename(['glc_grass']); 
var glc_crop = glc.eq(10).rename(['glc_crop']); 
var glc_built = glc.eq(80).rename(['glc_built']); 
var glc_bare = glc.eq(90).rename(['glc_bare']); 
var glc_snow = glc.eq(100).rename(['glc_snow']); 
var glc_water = glc.eq(60).rename(['glc_water']); 

// 3. Dynamic World

var dwl = dw.filterDate(srt, end).select("label"); //.filterBounds(AOIpt)
var dwMode = dwl.reduce(ee.Reducer.mode()); //Mode reducer for the period selected
var dw_tree = dwMode.eq(1).rename(['dw_trees']);  
var dw_shrub = dwMode.eq(5).rename(['dw_shrub']); 
var dw_grass = dwMode.eq(2).rename(['dw_grass']); 
var dw_crop = dwMode.eq(4).rename(['dw_crop']); 
var dw_built = dwMode.eq(6).rename(['dw_built']); 
var dw_bare = dwMode.eq(7).rename(['dw_bare']); 
var dw_snow = dwMode.eq(8).rename(['dw_snow']); 
var dw_water = dwMode.eq(0).rename(['dw_water']); 
var dw_floodv = dwMode.eq(3).rename(['dw_floodv']); 

// 4. ESRI

var esri_tree = esri.eq(2).rename(['esri_tree']);  
var esri_shrub = esri.eq(6).rename(['esri_shrub']);
var esri_grass = esri.eq(3).rename(['esri_grass']);
var esri_crop = esri.eq(5).rename(['esri_crop']);
var esri_built = esri.eq(7).rename(['esri_built']);
var esri_bare = esri.eq(8).rename(['esri_bare']);
var esri_snow = esri.eq(9).rename(['esri_snow']);
var esri_water = esri.eq(1).rename(['esri_water']);
var esri_floodv = esri.eq(4).rename(['esri_floodv']);

// 5. WRI

var wri_tree = wri.gte(10); //Classes 10 and 20 are not included to avoid commission.
                            // Although this could be probably masked afterwards by majority of grass?

// 6. GFC

var gfc_stree = gfc.select(['treecover2000']);
var gfc_tree10 = gfc_stree.gte(10);
var lossYear = gfc.select(['lossyear']).unmask(); //2001=1, 2015=15
var lossb2020 = lossYear.gte(1).and(lossYear.lte(20));
//var lossYearGFC2000_2020 = (treeCover.gte(10)).and(lossb2020);
var gfc_treed = gfc_tree10.subtract(lossb2020);

var fromList = [-1, 0, 1];
var toList =   [0, 0, 1];

var gfc_tree = gfc_treed.remap({
  from: fromList,
  to: toList,
  defaultValue: 0,
  bandName: 'treecover2000'
});

// 7. GLC LCLU 2020

var glclc20_tree = glclc20.gte(25).and(glclc20.lte(48)).rename(['glclc20_tree']);  
var glclc20_crop = glclc20.eq(244).rename(['glclc20_crop']);
var glclc20_built = glclc20.gte(250).rename(['glclc20_built']);
var glclc20_snow = glclc20.eq(241).rename(['glclc20_snow']);
var glclc20_water = glclc20.eq(200).and(glclc20.lte(207)).rename(['glclc20_water']);
var glclc20_floodv = glclc20.gte(100).and(glclc20.lte(148)).rename(['glclc20_floodv']);

// 8. GLC LC 2019

var glclc19_tree = (glclc19.gte(51).and(glclc19.lte(74))).or(glclc19.gte(75).and(glclc19.lte(91))).rename(['glclc19_tree']);
var glclc19_treeo = glclc19.gte(51).and(glclc19.lte(74)).rename(['glclc219_treeo']);
var glclc19_treec = glclc19.gte(75).and(glclc19.lte(91)).rename(['glclc219_treec']);
var glclc19_crop = glclc19.eq(252).rename(['glclc219_crop']);
var glclc19_built = glclc19.gte(240).and(glclc19.lte(249)).rename(['glclc219_built']);
var glclc19_snow = glclc19.eq(251).rename(['glclc219_snow']);
var glclc19_water = glclc19.eq(250).rename(['glclc219_water']);
var glclc19_floodv = glclc19.gte(126).and(glclc19.lte(211)).rename(['glclc219_floodw']);

// 9. UMD Crops (2003, 2007, 2011, 2015, 2019)

var umd_crop = cropmask_UMD_2003.or(cropmask_UMD_2007).or(cropmask_UMD_2011).or(cropmask_UMD_2015).or(cropmask_UMD_2019);

// 10. JRC Water (2020) - Seasonal
var jrc_waterse = jrc_water.eq(2).unmask();

// 11. RANDOLPH-GLACIER-INVENTORY

var glacier_img = glacier_ft.reduceToImage({properties: ['area_km2'], reducer: ee.Reducer.first()});
var glacier_binary = glacier_img.gt(0).unmask();


// Others
// GEDI Lang

var gedi_lang = ee.Image('users/nlang/ETH_GlobalCanopyHeight_2020_10m_v1');
var gedilt= gedi_lang.lt(5);
var gedigte= gedi_lang.gte(5);

var ghsl = ee.ImageCollection("JRC/GHSL/P2023A/GHS_BUILT_C");
ghsl = ghsl.mosaic().gte(11);

// End of Select Classes
//******************************

// Overall Trees
var trees = wc_tree.add(dw_tree).add(esri_tree).add(gfc_tree).add(glc_tree).add(glclc20_tree).add(glclc19_tree).rename(['trees']); //.add(glc_tree)
// Overall Shrub
var shrub = wc_shrub.add(dw_shrub).add(esri_shrub).add(glc_shrub).rename(['shrub']); //.add(glc_shrub)
// Overall Grass
var grass = wc_grass.add(dw_grass).add(esri_grass).add(glc_grass).rename(['grass']); //.add(glc_grass)
// Overall Crop
var crop = wc_crop.add(dw_crop).add(esri_crop).add(glclc20_crop).add(glclc19_crop).add(umd_crop).rename(['crop']); //.add(glc_crop)
// Overall built
var built = wc_built.add(dw_built).add(esri_built).add(glc_built).add(ghsl).rename(['built']); //.add(glclc20_built).add(glclc19_built)
// Overall bare
var bare = wc_bare.add(dw_bare).add(esri_bare).add(glc_bare).rename(['bare']); //.add(glc_bare)
// Overall snow
var snow = wc_snow.add(dw_snow).add(esri_snow).add(glc_snow).add(glclc20_snow).add(glclc19_snow).rename(['snow']); // Majority contains certain omission. Might be better to take the overall (.or)
// Overall water
var water = wc_water.add(dw_water).add(esri_water).add(glc_water).rename(['water']); //.or(glclc20_water).or(glclc19_water)
// Overall floodv
var floodv = wc_floodv.add(dw_floodv).add(esri_floodv).add(glclc20_floodv).add(glclc19_floodv).rename(['floodv']);
// Overall mang
var mang = wc_mang.rename(['mang']);
// Overall mossl
var mossl = wc_mossl.rename(['mossl']);

// Majority rules

var shrub_maj = shrub.gt(2).rename(['shrub']); // Shrub majority (overall 4 products used). Majority: >2
var grass_maj = grass.gte(2).unmask().rename(['grass']); // Grass majority (overall 4 products). Majority: >2
var crop_maj = crop.gt(3).unmask().rename(['crop']); // Crop majority (overall 6 products). Majority: >3
var built_maj = built.gte(2).rename(['built']); // Built layer (overall 4 products) Rule: gte(2) Allow a bit more flexibility instead of majority. To be crossed with GHSL
built_maj = built_maj.or(ghsl); //GHSL might be more accurate even than the majority of the previous, so we include with an .or statement
var bare_maj = bare.gt(2).rename(['bare']); // Bare majority (overall 4 products). Majority: >2
var snow_maj = snow.gt(3).rename(['snow']); // Snow Majority (overall 6 products). Majority: >3
snow_maj = snow_maj.or(glacier_binary); // Snow Majority or glaciers
var water_maj = water.gt(2); // Water majority (overall 4 products) Majority: >2. If being more flexible (e.g. gte(2) -> Shadows included
var floodv_maj = floodv.gt(2).rename(['floodv']); // Flooded vegetation: (Overall 4 products) Majority: >2
var mang_maj = mang.rename(['mang']); // Only 1 class available. Eventually cross with flooded vegetation.
var mossl_maj = mossl.rename(['mossl']); // Moss and linchen. Only one layer available, eventually remove.

// ------------------------
// *** ITERATION - 1 *** 
// ------------------------

// ---------------------
//  TREES and SHRUBS - 1
// ---------------------

// ---- Majority ---- //
var tree_maj1 = trees.eq(7);
var tree_maj2 = trees.eq(6);
var tree_maj3 = trees.eq(5); 
var tree_maj4 = trees.eq(4); 
// ---- Low desn. ---- //
var tree_maj5 = trees.eq(3);
var tree_maj6 = trees.eq(2); //------ Overall til here ----- maj6

// Tree Cover Majority: >3 (total is 7). This is to be used along with shrubs
var tree_overall_4cat = tree_maj1.or(tree_maj2).or(tree_maj3).or(tree_maj4);
var tree_overall_5cat = tree_maj1.or(tree_maj2).or(tree_maj3).or(tree_maj4).or(tree_maj5);
var tree_overall_6cat = tree_maj1.or(tree_maj2).or(tree_maj3).or(tree_maj4).or(tree_maj5).or(tree_maj6);

//Anything that does not fall within the 6 categories but has been mappen by WRI Tree.
//Mainly trees outside forest
var tree_maj7 = wri_tree.updateMask(tree_overall_6cat.not()).unmask(); 
var tree_overall_7cat = tree_overall_6cat.or(tree_maj7);

// -----------------------------
//  WATER Permanent & Seasonal
// -----------------------------

// Water Permanent masks all others but not crops (water within crops is probably well delineated)
// Then we first mask the permanent water layers with crops

water_maj = water_maj.updateMask(crop_maj.not()).unmask();

tree_maj1 = tree_maj1.updateMask(water_maj.not()).unmask();
tree_maj2 = tree_maj2.updateMask(water_maj.not()).unmask();
tree_maj3 = tree_maj3.updateMask(water_maj.not()).unmask();
tree_maj4 = tree_maj4.updateMask(water_maj.not()).unmask();
tree_maj5 = tree_maj5.updateMask(water_maj.not()).unmask();
tree_maj6 = tree_maj6.updateMask(water_maj.not()).unmask();
tree_maj7 = tree_maj7.updateMask(water_maj.not()).unmask();
shrub_maj = shrub_maj.updateMask(water_maj.not()).unmask();
grass_maj = grass_maj.updateMask(water_maj.not()).unmask();
built_maj = built_maj.updateMask(water_maj.not()).unmask();
floodv_maj = floodv_maj.updateMask(water_maj.not()).unmask();
mang_maj = mang_maj.updateMask(water_maj.not()).unmask();
mossl_maj = mossl_maj.updateMask(water_maj.not()).unmask();

// Water Seasonal masks all trees, shrubs, grass, built, mossl, water | not crop, floodv, mang
// Thus, first we need to mask the water seasonal by the layers that will not be masked (crop, floodv and mang)

//First we built an overall mask of crops, floodv and mang
var mask4waterse = crop_maj.or(floodv_maj).or(mang_maj);
// Then we apply the mask
jrc_waterse = jrc_waterse.updateMask(mask4waterse.not()).unmask();

//Once the seasonal water is masked, we apply the resulting layer to the target layers
tree_maj1 = tree_maj1.updateMask(jrc_waterse.not()).unmask();
tree_maj2 = tree_maj2.updateMask(jrc_waterse.not()).unmask();
tree_maj3 = tree_maj3.updateMask(jrc_waterse.not()).unmask();
tree_maj4 = tree_maj4.updateMask(jrc_waterse.not()).unmask();
tree_maj5 = tree_maj5.updateMask(jrc_waterse.not()).unmask();
tree_maj6 = tree_maj6.updateMask(jrc_waterse.not()).unmask();
tree_maj7 = tree_maj7.updateMask(jrc_waterse.not()).unmask();
shrub_maj = shrub_maj.updateMask(jrc_waterse.not()).unmask();
grass_maj = grass_maj.updateMask(jrc_waterse.not()).unmask();
built_maj = built_maj.updateMask(jrc_waterse.not()).unmask();
mossl_maj = mossl_maj.updateMask(jrc_waterse.not()).unmask();
water_maj = water_maj.updateMask(jrc_waterse.not()).unmask();

// ---------------------
//  TREES and SHRUBS - 2
// ---------------------

// Shrub majority is masked by majority of Tree cover
var shrub_maj_m = shrub_maj.updateMask(tree_overall_5cat.not()).unmask();

// Other wooded land is the intersection between shrub majority and lowest density classes of Tree Cover (cat 6 and 7)
// Note that WRI TC does not cover areas outside the tropics. In order to have OWL outside the tropics it is neccessary to
// include an additional low density class (i.e. maj6). 
// This also makes sense as this TC class 6 still has a lot of overlap with shrub majority.

var owl1 = shrub_maj_m.and(tree_maj6); // Outside the tropics
var owl2 = shrub_maj_m.and(tree_maj7); // In and outside the tropics
var owl = owl1.or(owl2); // Overall owl

// Apply owl mask on Tree Cover maj6 and maj7 so we get clean maj6 and maj7 classes
// These are low density tree cover areas that did not intersect with Shrub Majority
var tree_maj6_m = tree_maj6.updateMask(owl.not());
var tree_maj7_m = tree_maj7.updateMask(owl.not());

// Overall maj67 (masked by owl). 
// Some of these areas will be probably masked afterwards by the grass majority
var tree_maj67_m = tree_maj6_m.or(tree_maj7_m);

//Version of shrubs masked by owl and TC majority
var shrub_maj_mm = shrub_maj_m.updateMask(owl.not());

tree_maj1 = tree_maj1.rename("tree_maj1");
tree_maj2 = tree_maj2.rename("tree_maj2");
tree_maj3 = tree_maj3.rename("tree_maj3");
tree_maj4 = tree_maj4.rename("tree_maj4");
tree_maj5 = tree_maj5.rename("tree_maj5");
owl = owl.rename("owl_maj67");
shrub_maj_mm = shrub_maj_mm.rename("shrub");
tree_maj67_m = tree_maj67_m.rename("tree_maj67");


// ---------------------
//  GRASS
// ---------------------

// First we need to apply a mask. Remove from grass Majority - TC Cat 1-5 (5cat)
var grass_maj_m = grass_maj.updateMask(tree_overall_5cat.not()).unmask();
// We cross majority of grass already masked with TC 1-5 with remaining TC 6 and 7 (the one already masked by OWL) to create a new mixed class
var grasstree67 = grass_maj_m.and(tree_maj67_m);
// We update/mask the tree_maj67m with the new grasstree67
var tree_maj67_mm = tree_maj67_m.updateMask(grasstree67.not()).unmask();
// We update/mask the Grass Majority already masked with TC Cat 1-5 with the new grasstree67
var grass_maj_mm = grass_maj_m.updateMask(grasstree67.not()).unmask();

// -----------------------------------------------
//  Wrap-up | Intermediate list of final layers
// -----------------------------------------------

/*
Trees: tree_maj1, tree_maj2, tree_maj3, tree_maj4, tree_maj5, tree_maj67_mm
Shrub: shrub_maj_mm
Owl: owl
Grass: grass_maj_mm
Grass Tree: grasstree67
*/

// ---------------------
//  CROPS
// ---------------------
// Crops dominate over the other classes | At least the following: 

tree_maj1 = tree_maj1.updateMask(crop_maj.not()).unmask();
tree_maj2 = tree_maj2.updateMask(crop_maj.not()).unmask();
tree_maj3 = tree_maj3.updateMask(crop_maj.not()).unmask();
tree_maj4 = tree_maj4.updateMask(crop_maj.not()).unmask();
tree_maj5 = tree_maj5.updateMask(crop_maj.not()).unmask();
tree_maj67_mm = tree_maj67_mm.updateMask(crop_maj.not()).unmask();
shrub_maj_mm = shrub_maj_mm.updateMask(crop_maj.not()).unmask();
owl = owl.updateMask(crop_maj.not()).unmask();
grass_maj_mm = grass_maj_mm.updateMask(crop_maj.not()).unmask();
grasstree67 = grasstree67.updateMask(crop_maj.not()).unmask();

// ---------------------
//  BUILT
// ---------------------

// The majority class of built-up areas go beyond the real boundaries of the real built-up class
// It does not contain other classes so we mask the built up with all other classes except Bare/Snow/FG/Mangroves (water is already masked)
// Note that this might remove small built-up areas. These can be corrected on a second phase by:
    // Selecting the small built up areas from the original built_maj via connectedPixels and stich them aftewards to the outcome.

//First we build an overall mask for this specific case
var mask4built = tree_maj1.or(tree_maj2).or(tree_maj3).or(tree_maj4).or(tree_maj5).or(tree_maj67_mm).or(shrub_maj_mm).or(owl).or(grass_maj_mm).or(grasstree67).or(crop_maj);
var built_maj_m = built_maj.updateMask(mask4built.not()).unmask();


// ------------------------------------------------
//  MANGROVES - HERBACEOUS WETLAND (flooded veg.)
// ------------------------------------------------

// Should be considered that mangroves are only classified in ESA-WC. All other datasets do not contain this class but only herbaceous wetlands.
// The problem is that in terms of majority vote, both mangroves and herbaceous wetland are very similar in extent. 
// However, there is in principle a good match between Mangroves and TC-67. This helps to discriminate between both.
// Therefore, here we define the mangroves as the intersection between TC-67 and the Majority Vote for TC-67.

//First we mask the mangroves with TC67
mang_maj = mang_maj.and(tree_maj67_mm);

// Now we need to separate herbaceous wetland (floodv) from the mangroves
floodv_maj = floodv_maj.updateMask(mang_maj.not()).unmask();

//We also separate both the mangroves and floodv from TC-67
var mask4_tc67 = mang_maj.or(floodv_maj);
tree_maj67_mm = tree_maj67_mm.updateMask(mask4_tc67.not()).unmask();

// We also need to mask from mangroves and wetlands all the other classes to avoid overlaps | not snow
var mask4both = tree_maj1.or(tree_maj2).or(tree_maj3).or(tree_maj4).or(tree_maj5).or(shrub_maj_mm).or(owl).or(grass_maj_mm).or(grasstree67).or(crop_maj).or(built_maj_m).or(mossl_maj).or(jrc_waterse).or(water_maj);
mang_maj = mang_maj.updateMask(mask4both.not()).unmask(); 
floodv_maj = floodv_maj.updateMask(mask4both.not()).unmask(); 


// -----------------------------------------------
//  Wrap-up | Intermediate list of layers
// -----------------------------------------------


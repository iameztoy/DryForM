mossl_maj = mossl_maj.updateMask(bare_maj.not()).unmask();


// ---------------------
//  SNOW
// ---------------------

// The snow is prioritized over all the other classes. 
//    Although it is unlikely that snow cover certain classes, we mask them all 
//    to avoid overlapping pixels of possible snow commission errors.

tree_maj1 =tree_maj1.updateMask(snow_maj.not()).unmask();
tree_maj2 = tree_maj2.updateMask(snow_maj.not()).unmask();
tree_maj3 = tree_maj3.updateMask(snow_maj.not()).unmask();
tree_maj4 = tree_maj4.updateMask(snow_maj.not()).unmask();
tree_maj5 = tree_maj5.updateMask(snow_maj.not()).unmask();
tree_maj67_mm = tree_maj67_mm .updateMask(snow_maj.not()).unmask();
shrub_maj_mm = shrub_maj_mm.updateMask(snow_maj.not()).unmask();
owl = owl.updateMask(snow_maj.not()).unmask();
grass_maj_mm = grass_maj_mm.updateMask(snow_maj.not()).unmask();
grasstree67 = grasstree67.updateMask(snow_maj.not()).unmask();
mang_maj = mang_maj.updateMask(snow_maj.not()).unmask();
floodv_maj = floodv_maj.updateMask(snow_maj.not()).unmask();
water_maj =  water_maj.updateMask(snow_maj.not()).unmask();
mossl_maj = mossl_maj.updateMask(snow_maj.not()).unmask();
jrc_waterse = jrc_waterse.updateMask(snow_maj.not()).unmask();
jrc_waterse = jrc_waterse.updateMask(snow_maj.not()).unmask();
built_maj_m = built_maj_m.updateMask(snow_maj.not()).unmask();
crop_maj = crop_maj.updateMask(snow_maj.not()).unmask();

// ---------------------
//  MOSCH AND LICHEN
// ---------------------

// Mosh and lichen are added only where others are not present. ML is only available in ESA-WC
// We mask ML by the sum of all others

var mask4ML = tree_maj1.or(tree_maj2).or(tree_maj3).or(tree_maj4).or(tree_maj5).or(tree_maj67_mm)
              .or(shrub_maj_mm).or(owl)
              .or(grass_maj_mm).or(grasstree67)
              .or(mang_maj).or(floodv_maj)
              .or(crop_maj)
              .or(water_maj).or(jrc_waterse).or(snow_maj)

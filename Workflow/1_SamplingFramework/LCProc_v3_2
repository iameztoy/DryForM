/*

This code was developed under the Exploratory Research Project (JRC-EC S.4/D1) and it aims at stablishing a 
preliminary framework to extract samples to be used in Supervised Classification activities. 
A number of global coverage Land Cover products are used and mixed different rules. The outcome is a new
LC map containing overall 19 classes at global scale.
Data extraction is prepared for different Areas of Interest; currently Chaco, Caatinga, Cerrado and Tanzania.
Note that not all the regions contain the same number of classes.

The outcome of this procedure is exported both as an asset and to drive so it can be used to get samples using a
a stratified random sampling approach implemented in AcATaMa plugin for QGIS - https://plugins.qgis.org/plugins/AcATaMa/
** IAA March 2023

Continues in folder 2/ Samples

*/

// or 
var chaco = ee.FeatureCollection("users/iameztoy/dryform/AOIs/eco_zone_Chaco");
var caatinga = ee.FeatureCollection("users/iameztoy/dryform/AOIs/eco_zone_Caatinga");
var cerrado = ee.FeatureCollection("users/iameztoy/dryform/AOIs/eco_zone_Cerrado");
var tanzania = ee.FeatureCollection("users/iameztoy/dryform/AOIs/zone_Tanzania");

//Map.addLayer(chaco.merge(caatinga).merge(cerrado))

// Target AOI for export
var aoi = chaco;
var aoi_n = "chaco";

/* 


//***********************************************************
// DRYFORM - Step 8.3 - Calculate Largest Loss
//***********************************************************

// Note that this script requires to load segments previously calculated in step 8.1


// Require | Import required dependencies
var temporalSegmentation = require('users/wiell/temporalSegmentation:temporalSegmentation'); // Load module

// Load Classification produced in step 5.
var chaco = ee.Image("projects/hardy-tenure-383607/assets/DryForm_Project/Classification/Class_chaco_Pb_buf20_9cl");

//Import segmented array created in step 8.1
var segmentsImage = ee.Image('projects/hardy-tenure-383607/assets/my_test_segments');// Load CCDC asset

//Preliminary variables. Dates within which you want to extract the largest loss
var segments = temporalSegmentation.Segments(segmentsImage); // Create temporal segments
var fromDate = '2021-01-01';
var toDate = '2024-05-01';

var from = segments.findByDate(fromDate).slice({harmonics: 0});
var to = segments.findByDate(toDate).slice({harmonics: 0});

// Extract largest loss from start of reporting peroid.
var tFrom = segments.toT(fromDate);
var tTo = segments.toT(toDate);
var largestLoss = segments.find()
  .updateMask('i.tEnd >= from and i.tStart <= to', {
      from: segments.toT(fromDate), 
      to: segments.toT(toDate)
  })
  .addBands(function (segment) {
    var tStart = segment.toImage('tStart').max(tFrom);
    var tEnd = segment.toImage('tEnd').min(tTo);
    var changeToStart = segment.slice({t: tStart, harmonics: 0}).subtract(from).select('ndfi');
    var changeToEnd = segment.slice({t: tEnd, harmonics:0}).subtract(from).select('ndfi');
    var change = changeToStart.min(changeToEnd);
    return change
      .int16()
      .rename('change');
  })
  .updateMask('i.change < 0')
  .min('change')
  .toImage('change')
  .unmask(0).clip(segmentsImage.geometry());


//

// Once we extract the largest loss we can cross it with our own classification (e.g. Tree Cover, forest or shrubs)
//    so that the losses are only shown for this classes

largestLoss = largestLoss.multiply(-1); //Just to make it more readable
largestLoss = largestLoss.gte(3000); //Apply a threshold to NDFI loss
largestLoss = largestLoss.updateMask(largestLoss);
var chaco_tc = chaco.eq(1); // Example for tree cover.
chaco_tc = chaco_tc.updateMask(chaco_tc);
var change_chaco = chaco_tc.multiply(largestLoss);

//VISUALIZATION
var visParams = {min: -10000, max: 10000, palette: 'red,orange,white,green,blue'};
Map.addLayer(chaco_tc, {palette:"green"}, "Chaco TC"); 

Map.addLayer(change_chaco, {palette:"red"}, "Largest Loss 2021-2024 (thr 3000)");
Map.centerObject(segmentsImage);

/**** Start of imports. If edited, may not auto-convert in the playground. ****/
var ndvi_2020 = ee.Image("projects/hardy-tenure-383607/assets/Preprocessing/s1s2_UnionSA_NDVItest_MinMaxTailor_byte_2020_CC065"),
    caatinga = ee.FeatureCollection("users/iameztoy/dryform/AOIs/eco_zone_Caatinga"),
    cerrado = ee.FeatureCollection("users/iameztoy/dryform/AOIs/eco_zone_Cerrado"),
    chaco = ee.FeatureCollection("users/iameztoy/dryform/AOIs/eco_zone_Chaco"),
    cloudsum_vp = {"opacity":1,"bands":["t0_NDVI"],"palette":["000000","fff949","ffc74b","ff9f9f","ff483f"]};
/***** End of imports. If edited, may not auto-convert in the playground. *****/

var aoi = chaco.merge(cerrado).merge(caatinga);
aoi = aoi.union();

// Where are the clouds in the multitemporal (MT) domain?
// First we unmask e.g. the NDVI. Zero values = cloudy pixels in MT
// Any other set of bands could be used (e.g. B8)
// We need to make sure that training samples do not fall within this mask
//  in order to avoid inputing noisy data -> All MT bands shall share the same
//  cloud mask.
// Sampling shoud be applied on any of the output bands which contain valid pixels
//   in the multi-temporal domain

// Assets derived from step 0
var t0 = ndvi_2020.select("t0_NDVI"); 
var t1 = ndvi_2020.select("t1_NDVI");
var t2 = ndvi_2020.select("t2_NDVI");
var t3 = ndvi_2020.select("t3_NDVI");

// Unmask, clip and filter clouds (eq.0)
var t0c = ndvi_2020.select("t0_NDVI").unmask().clip(aoi).eq(0);
var t1c = ndvi_2020.select("t1_NDVI").unmask().clip(aoi).eq(0);
var t2c = ndvi_2020.select("t2_NDVI").unmask().clip(aoi).eq(0);
var t3c = ndvi_2020.select("t3_NDVI").unmask().clip(aoi).eq(0);

// We sum the all and create an overall MT cloud Mask
var sum = t0c.add(t1c).add(t2c).add(t3c);
//Cloudy MT pixels are between 1 and 4
var clouds = sum.gte(1).and(sum.lte(4));
//Non cloudy MT pixels equal 0 | Outcome is 1
var no_cloudsMT = sum.eq(0);
//Map.addLayer(no_cloudsMT, null, "No clouds overall",0);

Map.addLayer(t0, null, "t0")
Map.addLayer(t2, null, "t2")
Map.addLayer(t1, null, "t1")
//Interpolate
var a = (t0.unmask().add(t2.unmask())).divide(2)
print("a", a)
Map.addLayer(a, null, "mean")
var b = a.updateMask(t1c).unmask()
print("b", b)
Map.addLayer(b, null, "mean masked")
var c = t1.unmask().add(b)
print("c", c)
Map.addLayer(c, null, "gap-fill")

var d = c.unitScale(0, 255).multiply(255).toByte()
Map.addLayer(d, null, "to byte")




//Mask the original bands with non-cloudy pixels
var t0m = t0.updateMask(no_cloudsMT);
var t1m = t1.updateMask(no_cloudsMT);
var t2m = t2.updateMask(no_cloudsMT);
var t3m = t3.updateMask(no_cloudsMT);

var blist = [t1m, t2m, t3m];

//Merge back the masked bands
var col2020 = t0m.addBands(blist);


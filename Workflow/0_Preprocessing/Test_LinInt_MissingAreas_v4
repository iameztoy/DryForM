var str = year.toString()+"-01-01"; var end = (year+1).toString()+"-01-01" // Second Image Collection dates to calculate medians within the months of interest (see t_int parameter)


// Create a covering GRID
var aoi = caatinga.geometry();
var Zones = aoi.coveringGrid({
  	proj: "EPSG:4326", //EPSG:32720
  	scale: cg_scale // Need to find the right balance here (Test case: Caatinga)
  	              // Test 0: 35000 tile is similar to a geometry that worked (see 2024-01-06)
  	              //         print(Zones.size() = 804 tiles

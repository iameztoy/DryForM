/**** Start of imports. If edited, may not auto-convert in the playground. ****/
var ndvi_2020 = ee.Image("projects/hardy-tenure-383607/assets/Preprocessing/s1s2_UnionSA_NDVItest_MinMaxTailor_byte_2020_CC065"),
    caatinga = ee.FeatureCollection("users/iameztoy/dryform/AOIs/eco_zone_Caatinga"),
    cerrado = ee.FeatureCollection("users/iameztoy/dryform/AOIs/eco_zone_Cerrado"),
    chaco = ee.FeatureCollection("users/iameztoy/dryform/AOIs/eco_zone_Chaco"),
    cloudsum_vp = {"opacity":1,"bands":["t0_NDVI"],"palette":["000000","fff949","ffc74b","ff9f9f","ff483f"]};
/***** End of imports. If edited, may not auto-convert in the playground. *****/
var aoi = caatinga.merge(cerrado).merge(chaco)
aoi = aoi.union()

// Assets derived from step 0
var t0 = ndvi_2020.select("t0_NDVI"); 
var t1 = ndvi_2020.select("t1_NDVI");
var t2 = ndvi_2020.select("t2_NDVI");
var t3 = ndvi_2020.select("t3_NDVI");

// Unmask, clip and filter clouds (eq.0)
var t0c = ndvi_2020.select("t0_NDVI").unmask().clip(aoi).eq(0);
var t1c = ndvi_2020.select("t1_NDVI").unmask().clip(aoi).eq(0);
var t2c = ndvi_2020.select("t2_NDVI").unmask().clip(aoi).eq(0);
var t3c = ndvi_2020.select("t3_NDVI").unmask().clip(aoi).eq(0);

Map.addLayer(t0, null, "t0",0)
Map.addLayer(t1, null, "t1")
Map.addLayer(t2, null, "t2",0)
Map.addLayer(t1c, null, "t1c",0)

//Interpolate
var a = (t0.add(t2)).divide(2)
print("a", a)
Map.addLayer(a, null, "mean",0)
var b = a.updateMask(t1c)
print("b", b)
Map.addLayer(b, null, "mean masked",0)
var c = (t1.unmask()).add(b)
print("c", c)
Map.addLayer(c, null, "gap-fill",0)

var d = c.unitScale(0, 255).multiply(255).toByte()
Map.addLayer(d, null, "to byte",0)


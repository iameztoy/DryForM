/**** Start of imports. If edited, may not auto-convert in the playground. ****/
var ndvi_2020 = ee.Image("projects/hardy-tenure-383607/assets/Preprocessing/s1s2_UnionSA_NDVItest_MinMaxTailor_byte_2020_CC065"),
    caatinga = ee.FeatureCollection("users/iameztoy/dryform/AOIs/eco_zone_Caatinga"),
    cerrado = ee.FeatureCollection("users/iameztoy/dryform/AOIs/eco_zone_Cerrado"),
    chaco = ee.FeatureCollection("users/iameztoy/dryform/AOIs/eco_zone_Chaco"),
    cloudsum_vp = {"opacity":1,"bands":["t0_NDVI"],"palette":["000000","fff949","ffc74b","ff9f9f","ff483f"]},
    ndvi_2019 = ee.Image("projects/hardy-tenure-383607/assets/Preprocessing/s1s2_UnionSA_NDVItest_MinMaxTailor_byte_t3");
/***** End of imports. If edited, may not auto-convert in the playground. *****/
//Interpolate in this order t1, t0, t2, t3

var aoi = caatinga.merge(cerrado).merge(chaco)
aoi = aoi.union()

// Assets derived from step 0
var tm1 = ndvi_2019.select("t3_NDVI");
var t0 = ndvi_2020.select("t0_NDVI"); 
var t1 = ndvi_2020.select("t1_NDVI");
var t2 = ndvi_2020.select("t2_NDVI");
var t3 = ndvi_2020.select("t3_NDVI");

// Unmask, clip and filter clouds (eq.0)
var t0c = ndvi_2020.select("t0_NDVI").unmask().clip(aoi).eq(0);
var t1c = ndvi_2020.select("t1_NDVI").unmask().clip(aoi).eq(0);
var t2c = ndvi_2020.select("t2_NDVI").unmask().clip(aoi).eq(0);
var t3c = ndvi_2020.select("t3_NDVI").unmask().clip(aoi).eq(0);

Map.addLayer(t0, null, "t0",0)
Map.addLayer(t1, null, "t1")
Map.addLayer(t2, null, "t2",0)
Map.addLayer(t1c, null, "t1c",0)

//Interpolate
var a = (t0.add(t2)).divide(2); //calculate mean between t1 (t0 and t2). Avoid calculating mean if any of t is cloudy -> do not unmask
var b = a.updateMask(t1c); //mask with clouds in t1
var c = t1.unmask(); //unmask t1
var d = c.add(b.unmask()); //add mean values (t0 - t2) to t1
var e = (d.unitScale(0, 255).multiply(255).toByte()).selfMask(); //add changes to 510, unitScale and convert.

// Replace the masked pixels in the current image with the average value
//  var result = image.unmask(interpolated)

//add a second iteration with values from t0 - 1 (median from Oct-Nov 2019)
// areas that have not been interpolated. Still cloudy:
// either t0, t2 or both do not contain data (cloudy)

var ec = e.unmask().clip(aoi).eq(0) //clouds in interpolated image
var f = (ndvi_2019.add(t2)).divide(2) //I maintain t2 because it is less cloudy
var g = f.updateMask(ec) //mask with clouds in t1 that were not interpolated
var h = e.unmask(); //unmask the target t1 that have already been interpolated
var i = h.add(g.unmask()) //add mean values (t3_2019 - t2).
print("i", i)
var j = (i.unitScale(0, 255).multiply(255).toByte()).selfMask().clip(aoi); 
print("j", j)

print("a", a); print("b", b); print("c", c)
print("d", d); print("e", e)


Map.addLayer(a, null, "mean",0)
Map.addLayer(b, null, "mean masked",0)
Map.addLayer(c, null, "t1 unmask",0)
Map.addLayer(d, null, "t1 interpolated", 0)
Map.addLayer(e, null, "t1 interpolated to byte",1)
Map.addLayer(i, null, "t1 Interpolated 2nd", 1)
Map.addLayer(j, null, "t1 Interpolated 2nd byte", 1)

var test = (t1.unmask().add(((t0.add(t2)).divide(2))
            .updateMask(t1c).unmask())
            .unitScale(0, 255)).multiply(255).toByte().selfMask();
            
var test2 = (test.unmask().add((tm1.add(t2)).divide(2)
            .updateMask(test.unmask().eq(0)).unmask()))
            .unitScale(0, 255).multiply(255).toByte().selfMask();

Map.addLayer(test, null, "test all in one step 1 byte")
Map.addLayer(test2, null, "test all in one step 2 byte")



            










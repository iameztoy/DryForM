var str = year.toString()+"-01-01"; var end = (year+1).toString()+"-01-01"

var csPlus = ee.ImageCollection('GOOGLE/CLOUD_SCORE_PLUS/V1/S2_HARMONIZED');

var s2f = ee.ImageCollection('COPERNICUS/S2_SR_HARMONIZED')
    .filterBounds(aoi)
    .filterDate(str, end) //str, end //"2020-01-01", "2021-01-01"
    .filter(ee.Filter.lt('CLOUDY_PIXEL_PERCENTAGE',cloud_per)) 
    .linkCollection(csPlus, [QA_BAND])
    .map(function(img) {
      return img.updateMask(img.select(QA_BAND).gte(CLEAR_THRESHOLD)).divide(10000)
        .select("B.*")
        .clip(aoi)
        .copyProperties(img, ["system:time_start"]);
    }); 

var createSeasonComposites_s2 = function(months) {
  var startMonth = ee.List(months).get(0);
  var endMonth = ee.List(months).get(1);
  var monthFilter = ee.Filter.calendarRange(startMonth, endMonth, 'month');
  var seasonFiltered = s2f.filter(monthFilter);
  var composite = seasonFiltered.median();
  return composite.select("B.*").clip(aoi);
};

var compList_s2 = t_int.map(createSeasonComposites_s2);

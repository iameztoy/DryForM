var image = ee.Image("projects/hardy-tenure-383607/assets/S2inter_Caatinga/tile009_sc100000_s2ig_s1_double"),
    vp_original = {"opacity":1,"bands":["t0_B8"],"min":809.3661285920072,"max":4688.082052706442,"gamma":1},
    vp_minmax = {"opacity":1,"bands":["t0_B8"],"min":0.06189487629313926,"max":0.29645124413989105,"gamma":1},
    vp_onlyuint = {"opacity":1,"bands":["t0_B8"],"min":992,"max":4619,"gamma":1},
    vp_norm2uint = {"opacity":1,"bands":["t0_B8"],"min":599,"max":2964,"gamma":1},
    vp_onlyByte = {"opacity":1,"bands":["t0_B8"],"min":23,"max":129,"gamma":1};
/***** End of imports. If edited, may not auto-convert in the playground. *****/
image = image.select("t0_B8")

var only_uint16 = image.uint16()
var only_byte = only_uint16.multiply(0.0255).byte()


var minMax = image.reduceRegion({
  reducer: ee.Reducer.minMax(),
  //geometry: roi,
  scale: 10,
  maxPixels: 10e9,
}); 

// use unit scale to normalize the pixel values
var normalize = ee.ImageCollection.fromImages(
  image.bandNames().map(function(name){
    name = ee.String(name);
    var band = image.select(name);
    return band.unitScale(ee.Number(minMax.get(name.cat('_min'))), ee.Number(minMax.get(name.cat('_max'))))
})).toBands().rename(image.bandNames());

var norm_toInt16 = normalize.multiply(10000).uint16()

print("only uint16", only_uint16)
print("only byte", only_byte)
print("original", image)
print("min max", normalize)
print("to uint", norm_toInt16)

Map.addLayer(image, vp_original, "Original")
Map.addLayer(only_uint16, vp_onlyuint, "Only Uint16")
Map.addLayer(only_byte, vp_onlyByte, "Only byte")
Map.addLayer(normalize, vp_minmax, "MinMax")
Map.addLayer(norm_toInt16, vp_norm2uint, "Norm toInt16")


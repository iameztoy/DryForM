    ee.Geometry.Polygon(
        [[[-64.5352712553919, -27.685082711867956],
          [-64.5352712553919, -28.47581780993069],
          [-63.835107414144346, -28.47581780993069],
          [-63.835107414144346, -27.685082711867956]]], null, false),
    image = ee.Image("projects/hardy-tenure-383607/assets/Preprocessing/s1s2_NDVItest_MinMaxTailor_byte_chaco");
/***** End of imports. If edited, may not auto-convert in the playground. *****/
var aoi = geometry

var cloud_per = 0.90
var QA_BAND = 'cs'; // Use 'cs' or 'cs_cdf', depending on your use case; see docs for guidance.
var CLEAR_THRESHOLD = 0.65;

// Cloud Score+ image collection. Note Cloud Score+ is produced from Sentinel-2
// Level 1C data and can be applied to either L1C or L2A collections.
var csPlus = ee.ImageCollection('GOOGLE/CLOUD_SCORE_PLUS/V1/S2_HARMONIZED');


// SELECT AND MASK CLOUD/SHADOWS
var s2 = ee.ImageCollection('COPERNICUS/S2_SR_HARMONIZED')
    .filterBounds(aoi)
    .filterDate("2020-01-01", "2020-04-01") //str, end //"2020-01-01", "2021-01-01"
    .filter(ee.Filter.lt('CLOUDY_PIXEL_PERCENTAGE',90)) 
    .linkCollection(csPlus, [QA_BAND])
    .map(function(img) {
      return img.updateMask(img.select(QA_BAND).gte(0.65));
    });


var addIndex = function addindexes(img) {
  var ndvi = img.normalizedDifference(['B8', 'B4']).rename('NDVI');
  return img.addBands(ee.Image.cat(ndvi));
};

     
var s2i = s2.map(addIndex)
var s2im = s2i.median().select("NDVI").clip(aoi)
print(s2im)

Map.addLayer(s2im, null, "Calculated chaco On the fly NO BYTE")

var minMax = s2im.reduceRegion({
  reducer: ee.Reducer.minMax(),
  geometry: aoi,
  scale: 10,
  maxPixels: 10e13,
});

print(minMax)

var s2imf = ee.ImageCollection.fromImages(
  s2im.bandNames().map(function(name){
    name = ee.String(name);
    var band = s2im.select(name);
    return band.unitScale(ee.Number(minMax.get(name.cat('_min'))), 
    ee.Number(minMax.get(name.cat('_max')))).multiply(255).byte();
})).toBands().rename(s2im.bandNames());

print(s2imf)

Map.addLayer(s2imf, null, "Calculated chaco On the fly Byte")
Map.addLayer(image, null, "Calculated chaco Asset")






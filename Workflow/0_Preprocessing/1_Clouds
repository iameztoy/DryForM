var aoi = chaco.merge(cerrado).merge(caatinga);
aoi = aoi.union();

// Where are the clouds in the multitemporal domain?
// First we unmask the NDVI. Zero values = cloudy pixels
// We need to make sure that training samples do not fall within this mask
var t0 = ndvi_2020.select("t0_NDVI").unmask().clip(aoi).eq(0);
var t1 = ndvi_2020.select("t1_NDVI").unmask().clip(aoi).eq(0);
var t2 = ndvi_2020.select("t2_NDVI").unmask().clip(aoi).eq(0);
var t3 = ndvi_2020.select("t3_NDVI").unmask().clip(aoi).eq(0);

// We sum the all and create an overall MT cloud Mask
var sum = t0.add(t1).add(t2).add(t3);
var clouds = sum.gte(1).and(sum.lte(4));


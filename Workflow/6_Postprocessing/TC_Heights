/**** Start of imports. If edited, may not auto-convert in the playground. ****/
var table = ee.FeatureCollection("projects/hardy-tenure-383607/assets/DryForm_Project/Ancillary/FAO_ecozones"),
    tanzania = ee.FeatureCollection("users/iameztoy/dryform/AOIs/zone_Tanzania"),
    chaco = ee.FeatureCollection("users/iameztoy/dryform/AOIs/eco_zone_Chaco"),
    clasif = ee.ImageCollection("projects/hardy-tenure-383607/assets/DryForm_Project/Classification_PostProc/Classification_PostProc");
/***** End of imports. If edited, may not auto-convert in the playground. *****/

var aoi = chaco
var image = clasif.mosaic().selfMask()

var gedil = ee.Image('users/nlang/ETH_GlobalCanopyHeight_2020_10m_v1');
//ee.ImageCollection("projects/meta-forest-monitoring-okw37/assets/CanopyHeight").mosaic()
//ee.Image('users/nlang/ETH_GlobalCanopyHeight_2020_10m_v1');

var h = image.multiply(gedil)
var palettes = require('users/gena/packages:palettes');
var palette = palettes.colorbrewer.YlGn[7];
var m5 = h.lt(5).selfMask()

Map.addLayer(image, null, "TC", 0)
Map.addLayer(h, {min: 0, max: 30, palette: palette}, "TC heights")
Map.addLayer(m5, {palette: "orange"}, "Mask height <5")

// World Cover

var dataset = ee.ImageCollection('ESA/WorldCover/v200').first();
var visualization = {bands: ['Map']};
Map.addLayer(dataset.clip(aoi), visualization, 'World Cover v200', 0);

Map.setOptions("SATELLITE")

var mmu = 5000


var proj = clasif.projection();

var fcount = clasif.connectedPixelCount({maxSize: 250, eightConnected:true}).reproject({crs:proj});
var farea = ee.Image.pixelArea().reproject({crs:proj});
var area = fcount.multiply(farea);

Map.addLayer(area, null, "area")

var mask_gte = area.gte(mmu);
var final = mask_gte.updateMask(mask_gte);
final = final.updateMask(clasif.eq(1))

Map.addLayer(final, null, "Final filtered MMU")




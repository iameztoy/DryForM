
//************************************************************************** 
// Correcting nodata in the classification outcome
//************************************************************************** 

// These are the classifications of the best performing models.
// The aim of this script is to partially correct the artifacts created by the imagery pre-processing step. 
// Some areas remained as nodata (e.g. mountain shadows, border artifacts, etc.). 
// The idea is to replace these nodata values (only for Tree Cover and mangroves) by the LC_Refine for post-processing layer (iteration 2)
// The LC_Refine is already exported as an asset.

// Note that LC_Refine (iteration 1) is prepared to get samples, so it should not be used in this step.
// This is just a method to mitigate the artifacts but they still remain; mainly as a consequence of Sentinel-1 overlapped areas.
// Ideally this has to be corrected in the imagery pre-processing step.

// Target AOI for export | All go to the same asset

var chaco_b = ee.FeatureCollection("users/iameztoy/dryform/AOIs/eco_zone_Chaco");
var caatinga_b = ee.FeatureCollection("users/iameztoy/dryform/AOIs/eco_zone_Caatinga");
var cerrado_b = ee.FeatureCollection("users/iameztoy/dryform/AOIs/eco_zone_Cerrado");
var tanzania_b = ee.FeatureCollection("users/iameztoy/dryform/AOIs/zone_Tanzania");

// Target Classification. This asset contains 9 classes:

var chaco = ee.Image("projects/hardy-tenure-383607/assets/DryForm_Project/Classification/Class_chaco_Pb_buf20_9cl");
var caatinga = ee.Image("projects/hardy-tenure-383607/assets/DryForm_Project/Classification/Class_caatinga_Pb_buf20_9cl");
var cerrado = ee.Image("projects/hardy-tenure-383607/assets/DryForm_Project/Classification/Class_cerrado_Pb_buf20_9cl");
var tanzania = ee.Image("projects/hardy-tenure-383607/assets/DryForm_Project/Classification/Class_tanzania_Pb_buf20_9cl");

// Get only trees and mangroves
var chaco_trees = chaco.eq(1); // Trees in Chaco are defined with a different value
var caatinga_trees = caatinga.eq(0).or(caatinga.eq(3)); // value 0: Trees | value 3: Mangroves
var cerrado_trees = cerrado.eq(0).or(cerrado.eq(3));
var tanzania_trees = tanzania.eq(0).or(tanzania.eq(3));

// Set the targets | change the names to the target biome.
var aoi = tanzania_b; //or caatinga_b; cerrado_b; tanzania_b
var aoi_n = "tanzania"; //or caatinga; cerrado; tanzania
var target_class = tanzania;
var target_trees = tanzania_trees;

// Get the nodatas
//var list = [chaco, caatinga, cerrado, tanzania];
//var ic = ee.ImageCollection.fromImages(list).mosaic();
var gte0 = target_class.gte(0).unmask(); // We first identify all valid pixels and set 0 for those that were nodata. Value 1: valid pixels | value 0: originally nodata (artifact)
var eq0 = gte0.eq(0).clip(aoi); // We create a mask for 0 (nodata)

// LC_Refine (iteration 2)
// We use this to fill the gaps (artifacts)
var lc_refine = ee.ImageCollection("projects/hardy-tenure-383607/assets/DryForm_Project/Framework/LC_Refine4PostProc").mosaic();
var lc_refine_trees = lc_refine.eq(1); //Get only trees

// We cross the originally nodata values with LC_refine
var lc_refine_trees_m = lc_refine_trees.updateMask(eq0).unmask().clip(aoi);

// We correct the original classification by filling the nodata values
var ic_tree_c = target_trees.unmask().add(lc_refine_trees_m.unmask())


// Export with covering grid

var aoi = aoi.geometry();
var Zones = aoi.coveringGrid({
  	proj: "EPSG:4326", //EPSG:32720
  	scale: 300000
});

// CoveringGrid produces a strange ID so I make a new fc with proper
// unique id. This way we can parse them to the name while running the Export Loop.
// Take into account that we need to differentiate each tile so we do not have the same name while exporting; otherwise you get an error.

// make a list of length of features
var idList = ee.List.sequence(0,Zones.size().subtract(1)); 
// featureCollection to a List
var list = Zones.toList(Zones.size());
// set the system:index
var zonesID = ee.FeatureCollection(idList.map(function(newSysIndex){
  var feat = ee.Feature(list.get(newSysIndex));
  // format number to string (system:index must be a string)
  var indexString = ee.Number(newSysIndex).format('%03d'); //3 is until 999, increase if needed 
                                                          // but big chance of client crash while exporting. 
                                                          // Take into account that this is a loop on the client side.
  return feat.set('system:index', indexString, 'ID', indexString);
}));
//Set 30° N/S Aoi
//var tropic = ee.Geometry.Polygon([[[-120, 30],[-120, -30],[165, -30],[165, 30]]], null, false);


var ic_tree_cc = ic_tree_c.clip(aoi); //We clip to each AOI
ic_tree_cc = ic_tree_cc.gt(0).toByte().rename("Classified_Trees"); //While correcting, the range is 0-2. Perhaps due to small overlaps (1+1). We convert to 0-1 and cast to Byte.
print(ic_tree_cc);


var featlist = zonesID.getInfo()["features"];
for (var f in featlist) {
  var feat = ee.Feature(featlist[f]);
  var dis = feat.get("ID");
  var disS = dis.getInfo();
  var name = "tile";  
  Export.image.toAsset({
    image: ic_tree_cc, // The target image that has been corrected
    description: name+disS+"_"+aoi_n, //"test", //.toString(), Now the ID is already a string
    assetId: 'projects/hardy-tenure-383607/assets/DryForm_Project/Classification_PostProc/Classification_PostProc/' + name+disS+"_"+aoi_n, //.toString(),
    pyramidingPolicy:"mode", //Activate and select the Pyramiding Policy
    crs: 'EPSG:4326',
    region: feat.geometry().bounds(),
    scale: 10,
    maxPixels: 1e13
    });
}

// Visualization

Map.addLayer(chaco_trees, null, "Chaco Trees", 0);
Map.addLayer(caatinga_trees, null, "Caatinga Trees", 0);
Map.addLayer(cerrado_trees, null, "Cerrado Trees", 0);
Map.addLayer(tanzania_trees, null, "Tanzania Trees", 0);

Map.addLayer(lc_refine_trees_m, null, "LC Refine for nodata", 0);
Map.addLayer(ic_tree_c, null, "Trees Corrected", 0);
Map.addLayer(ic_tree_cc, {"opacity":0.7,"bands":["Classified_Trees"],"max":1,"palette":["000000","39b12a"]}, "Corrected and Cliped to target AOI");
Map.addLayer(eq0.selfMask(), {"palette":["ff0000"]}, "Originally Nodata");

Map.addLayer(zonesID, null, "Zones ID", 0);
Map.addLayer(aoi, null, "AOI Boundary", 0);

Map.centerObject(aoi);
Map.setOptions("SATELLITE");
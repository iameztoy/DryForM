// Loope functions and area calculation
var LOOPsamples= function(feature) {
  var vals = (target_tc.multiply(ee.Image.pixelArea())).divide(1e6).reduceRegion({
    reducer: ee.Reducer.sum(), 
    geometry: feature.geometry(),
    scale: 10,
    maxPixels: 5e9,
  })
  return ee.Feature(null, vals).copyProperties(feature, feature.propertyNames());
};

var LOOPresult2= zones_biome.map(LOOPsamples);

// Visualization

Map.addLayer(zones_biome, null, "Zones Biome");
Map.addLayer(target_tc, null, 'Target TC');

// Export
Export.table.toDrive({
	collection: LOOPresult2,
	description: 'AreaEstimates_' + aoi_name + "_" + target,
	folder: 'AreaEstimates',
	fileNamePrefix: 'AreaEstimates_' + aoi_name + "_" + target,
});


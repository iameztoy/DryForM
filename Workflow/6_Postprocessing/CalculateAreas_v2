

//AOI

var caatinga = ee.FeatureCollection("users/iameztoy/dryform/AOIs/eco_zone_Caatinga");
var cerrado = ee.FeatureCollection("users/iameztoy/dryform/AOIs/eco_zone_Cerrado");
var chaco = ee.FeatureCollection("users/iameztoy/dryform/AOIs/eco_zone_Chaco");
var tanzania = ee.FeatureCollection("users/iameztoy/dryform/AOIs/zone_Tanzania");

var aoi_name = "Caatinga"
var target = "MyClass"

// GRID to calculate areas
var Zones=ee.FeatureCollection('users/bourgoinclement2/World_UNctry_grid');//
var zones_biome = Zones.filterBounds(caatinga);



// Target Land Cover

var target = ee.Image('projects/hardy-tenure-383607/assets/DryForm_Project/Classification/Class_caatinga_Pb_buf20_9cl')
var target_tc = target.eq(0).or(target.eq(3)).selfMask().clip(caatinga);
Map.addLayer(target_tc, null, "Target Tc")


//ee.ImageCollection('JRC/GFC2020/V1').mosaic().clip(caatinga).rename("Tree Cover");
//var target_tc = ee.Image('projects/hardy-tenure-383607/assets/DryForm_Project/Classification/Class_caatinga_Pb_buf20_9cl').clip(caatinga).rename("Tree Cover"); 


// Loope functions and area calculation
var LOOPsamples= function(feature) {
  var vals = (target_tc.multiply(ee.Image.pixelArea())).divide(1e6).reduceRegion({
    reducer: ee.Reducer.sum(), 
    geometry: feature.geometry(),
    scale: 10,
    maxPixels: 5e9,
  })
  return ee.Feature(null, vals).copyProperties(feature, feature.propertyNames());
};

var LOOPresult2= zones_biome.map(LOOPsamples);

// Visualization

Map.addLayer(zones_biome, null, "Zones Biome");
Map.addLayer(target_tc, null, 'Target TC');

// Export
Export.table.toDrive({
	collection: LOOPresult2,
	description: 'AreaEstimates_' + aoi_name + "_" + target,
	folder: 'AreaEstimates',
	fileNamePrefix: 'AreaEstimates_' + aoi_name + "_" + target,
});

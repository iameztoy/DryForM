    scale: 10,
    crs: "EPSG:4326",
//	crsTransform:,
    maxPixels: 1e13
//	shardSize:,
});

// Export as an asset the classified defined before
var nTrees = 60;
var vps = 8;
var mlp = 2;
var bf = 0.5; 
var seed = 5757;

var bfp = bf * 100; //Only to avoid the point (0.5) in the model name
var model_name = "ClassObOb_"+ aoi_n + "_" + "nT" + nTrees.toString() + "vps" + vps.toString() + "mlp" + mlp.toString() + "bfp" + bfp.toString() + "se" + seed.toString();
print("Model name", model_name);

Export.classifier.toAsset({
		classifier: classifier,
    description: "Save_classifier",
    assetId: "projects/hardy-tenure-383607/assets/DryForm_Project/ClassifierModels/" + model_name
});




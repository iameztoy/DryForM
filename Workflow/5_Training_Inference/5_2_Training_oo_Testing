// "t0_B8", "t1_B8", "t2_B8", "t3_B8"
// "t0_B4", "t1_B4", "t2_B4", "t3_B4"
// "t0_B3", "t1_B3", "t2_B3", "t3_B3"
// "t0_gray_savg_glcm", "t1_gray_savg_glcm", "t2_gray_savg_glcm", "t3_gray_savg_glcm"

// Select target image | pb = pixel based, oo = object oriented
// Apply band selection if necessary (for testing purposes)
var composite = target_c //.select(bands); // or (bands)

// Ground Truth

// Notes:

// ** visu_lc attribute is the original disaggregated version of the visual interpretation step
//        
//        It includes 13 classes:
//          tc1	1, tc2	1, tc3	1, shrub	2, owl	2, grass	3, grasstree	3, mangroves	4, Flooded Veg.	5
//          built	6, PWater	7, SWater	0, Bare	9,  Crops	10
//          Not Included: tc4, tc5, tc67, Snow, moss/lichen
// ** visulcrec attribute is the reclassified version of the disaggregated version (visu_lc). 
//        It includes 9 classes:
//          tc1	1, tc2	1, tc3	1, shrub	2, owl	2, grass	3, grasstree	3, mangroves	4, Flooded Veg.	5
//          built	6, PWater	7, SWater	0, Bare	9,  Crops	10
//          Not Included: tc4, tc5, tc67, Snow, moss/lichen


var GroundTruthPol_DF = ee.FeatureCollection("projects/hardy-tenure-383607/assets/DryForm_Project/GroundTruth/GroundTruthPol_DF");
var GroundTruthPoint_DF = ee.FeatureCollection("projects/hardy-tenure-383607/assets/DryForm_Project/GroundTruth/GroundTruthPoint_DF");


// Training set | Already Balanced sample sets.
    // Points

var GTPoint_DF_Balanced_chaco = ee.FeatureCollection("projects/hardy-tenure-383607/assets/DryForm_Project/GroundTruth/GTPoint_DF_Balanced_chaco");
var GTPoint_DF_Balanced_caatinga = ee.FeatureCollection("projects/hardy-tenure-383607/assets/DryForm_Project/GroundTruth/GTPoint_DF_Balanced_caatinga");
var GTPoint_DF_Balanced_cerrado = ee.FeatureCollection("projects/hardy-tenure-383607/assets/DryForm_Project/GroundTruth/GTPoint_DF_Balanced_cerrado");
var GTPoint_DF_Balanced_tanzania = ee.FeatureCollection("projects/hardy-tenure-383607/assets/DryForm_Project/GroundTruth/GTPoint_DF_Balanced_tanzania");

    // Polygons
var GTPol_DF_Balanced_chaco = ee.FeatureCollection("projects/hardy-tenure-383607/assets/DryForm_Project/GroundTruth/GTPol_DF_Balanced_chaco");
var GTPol_DF_Balanced_caatinga = ee.FeatureCollection("projects/hardy-tenure-383607/assets/DryForm_Project/GroundTruth/GTPol_DF_Balanced_caatinga");
var GTPol_DF_Balanced_cerrado = ee.FeatureCollection("projects/hardy-tenure-383607/assets/DryForm_Project/GroundTruth/GTPol_DF_Balanced_cerrado");
var GTPol_DF_Balanced_tanzania = ee.FeatureCollection("projects/hardy-tenure-383607/assets/DryForm_Project/GroundTruth/GTPoint_DF_Balanced_tanzania");

// Validation set - Filtering the set to be used for validation purposes - From the original set

var gtp_f = GroundTruthPol_DF.filter(ee.Filter.eq('aoiname', aoi_n)); 
var gtp_vl =  gtp_f.filter(ee.Filter.eq('purp', "validation"));

// Process objects

// These are cliped from the original imagery. 
//    Connected components are calculated based on the ground truth polygons
//    To do so:
//      1/ Imagery is cliped with the GT Pol
//      2/ A random dummy band is selected. This will be used to calculate different the mean values of the different objects or segments.
//          Each has its own id.
//      3/ Mean values per object per band are calculated 
//      The outcome is a new Image Collection where each cliped image represents the mean values of an object.
//      These are the values that will be crossed with the Ground Truth point data set and will be used for training.
//      Doing so we avoid "sampling regions", which would not be fully representative of classes like OWL.

var target_clgt = target.clip(GroundTruthPol_DF)
var dummy_mask = target_clgt.select("t0_B8").gte(0)
var objectId =  dummy_mask.connectedComponents({
  connectedness: ee.Kernel.plus(1),
  maxSize: 80
});

var mean_obid = target_clgt.addBands(objectId.select('labels'));

var target_mean = mean_obid.reduceConnectedComponents({
  reducer: ee.Reducer.mean(),
  labelBand: 'labels'
});


// Input band names should be renamed to be aligned with the target image band names (the one to be classified, i.e. The segmented image)
    // Note that when segments are created, these are averaged and a suffix "_mean" is added to each band.
var blist = target_mean.bandNames();
var cat = function(ele){return ee.String(ele).cat("_mean")};
var ren = blist.map(cat);

target_mean = target_mean.select(blist).rename(ren);
print("Renamed", target_mean.bandNames())


var trainingGcp = GTPoint_DF_Balanced_chaco;
var validationGcp = gtp_vl;

// Reclassify the classes if necessary to get consecutive integers
// 0-based sequential series. 

var classValues = [0, 1, 2, 3, 5, 6, 7, 9, 10];
var remapValues = [6, 0, 1, 2, 3, 4, 5, 7, 8];

// For visulrec column (defined in landcover variable):
// 1: TC, 2: Shrub, 3: Grass, 4: Flooded Veg., 5: Built, 6: P.Water, 7: S.Water, 8: Bare, 9: Crops

trainingGcp = trainingGcp.remap(classValues, remapValues, landcover);
validationGcp = validationGcp.remap(classValues, remapValues, landcover);

// Overlay the point on the image to get training data.
var training = target_mean.sampleRegions({
  collection: trainingGcp, 
  properties: [landcover], 
  scale: 10,
  tileScale: 8 // Need to set this otherwise the classifier throws an error | The alternative is to export the target_mean collection as an asset.
});

//**********************
// Train a classifier.
//**********************

// Set the optimal hyperparameters derived from previous step
var nTrees = 100
var vps = 8
var mlp = 2
var bf = 0.5
var seed = 5768

// Use here the parameters established in the Hyperparameter Tunning step
// Hyperparameters may be different for pixel based or object oriented approach. Check within the Hyperparameter Tunning step
var classifier = ee.Classifier.smileRandomForest({
		numberOfTrees: nTrees, // The number of decision trees to create.
    //variablesPerSplit: vps, // The number of variables per split. If unspecified, uses the square root of the number of variables.
    //minLeafPopulation: mlp, // Only create nodes whose training set contains at least this many points.
    //bagFraction: bf, //The fraction of input to bag per tree.
    //maxNodes: 100, //The maximum number of leaf nodes in each tree. If unspecified, defaults to no limit.
    seed: seed // The randomization seed.
  }).train({
  features: training,  
  classProperty: landcover, 
  inputProperties:  target_mean.bandNames()
});


// Classify the image.
var classified = target_c.classify(classifier); // Need to add here the target for classification (not for training)
print("Classified", classified);

//************************************************************************** 
// Feature Importance | Accuracies, etc.
//************************************************************************** 

// Run .explain() to see what the classifer looks like
print("Classifier", classifier.explain());

// Get a confusion matrix and overall accuracy for the training sample.
var trainAccuracy = classifier.confusionMatrix();
print('Training error matrix', trainAccuracy);
print('Training overall accuracy', trainAccuracy.accuracy());

// Calculate variable importance
var importance = ee.Dictionary(classifier.explain().get('importance'));

// Calculate relative importance
var sum = importance.values().reduce(ee.Reducer.sum());

var relativeImportance = importance.map(function(key, val) {
   return (ee.Number(val).multiply(100)).divide(sum);
  });
print(relativeImportance);

// Create a FeatureCollection so we can chart it
var importanceFc = ee.FeatureCollection([
  ee.Feature(null, relativeImportance)
]);

var chart = ui.Chart.feature.byProperty({
  features: importanceFc
}).setOptions({
      title: 'Feature Importance',
      vAxis: {title: 'Importance'},
      hAxis: {title: 'Feature'}
  });
print(chart);

//************************************************************************** 
// Accuracy Assessment
//************************************************************************** 

// Use classification map to assess accuracy using the validation fraction
// of the overall training set created above.
var test = classified.sampleRegions({
  collection: validationGcp,
  properties: [landcover],
  tileScale: 16,
  scale: 10,
});

var testConfusionMatrix = test.errorMatrix(landcover, 'classification');

print('Confusion Matrix', testConfusionMatrix);
print('VAL Accuracy', testConfusionMatrix.accuracy());


var cerrado = ee.FeatureCollection("users/iameztoy/dryform/AOIs/eco_zone_Cerrado");
var chaco = ee.FeatureCollection("users/iameztoy/dryform/AOIs/eco_zone_Chaco");
var tanzania = ee.FeatureCollection("users/iameztoy/dryform/AOIs/zone_Tanzania");

// Areas of Interest
var aoi = GTPol_DF_Balanced_chaco; //target aoi

var chaco_n = "chaco";
var caatinga_n = "caatinga";
var cerrado_n = "cerrado";
var tanzania_n = "tanzania";

var aoi_n = chaco_n;

// Ground Truth attribute to be used:
var landcover = "visulcrec"; // or visu_lc

// Imagery | Target for training
var target = ee.ImageCollection("projects/hardy-tenure-383607/assets/Preprocessing/s1s2_Chaco").mosaic();
// Imagery | Target for classification (Previously computed in Module 4)
var target_c = ee.Image("projects/hardy-tenure-383607/assets/DryForm_Project/Segmentation/Chaco_SNIC_sNAc0c8n256se28");
target_c = target_c.select("t.*");

// Band selection


var bands = ["t0_MSAVI", "t1_MSAVI", "t2_MSAVI", "t3_MSAVI",
             "t0_gNDVI", "t1_gNDVI", "t2_gNDVI", "t3_gNDVI",
             "t0_VV", "t0_VH", "t1_VV", "t1_VH", "t2_VV", "t2_VH", "t3_VV", "t3_VH",
             "t0_B12", "t1_B12", "t2_B12", "t3_B12",
             "t0_B11", "t1_B11", "t2_B11", "t3_B11"];

// "t0_VV", "t0_VH", "t1_VV", "t1_VH", "t2_VV", "t2_VH", "t3_VV", "t3_VH"
// "t0_MSAVI", "t1_MSAVI", "t2_MSAVI", "t3_MSAVI"

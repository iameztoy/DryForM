// pb = Pixel Based
// oo = Object Oriented

//Areas of Interest | Included within the Ground Truth 
var chaco = "chaco";
var caatinga = "caatinga";
var cerrado = "cerrado";
var tanzania = "tanzania";

var aoi = chaco

// Ground Truth attribute to be used:
var landcover = "visulcrec"; // or visu_lc
var buffer = 15 // To buffer the training and validation points | Take into account whether if you select points or polygons. If POL are selected, there is no need to buffer

// Imagery 
// Pixel based is an Image Collection (needs mosaicing) while Object Oriented image is an Image

var AllChaco_pb = ee.ImageCollection("projects/hardy-tenure-383607/assets/Preprocessing/s1s2_Chaco").mosaic();
var AllChaco_oo = ee.Image("projects/hardy-tenure-383607/assets/DryForm_Project/Segmentation/Chaco_SNIC_sNAc0c8n256se28_sBands");


// Select Bands if necessary
var bands = ["t0_B11", "t2_VH","t0_B12", "t2_B11", "t2_B12", "t0_VH", "t2_B8", "t0_gNDVI", "t3_B11", "t1_B11", "t0_gray_savg_glcm", "t3_B12",
             "t3_VH", "t1_gray_savg_glcm", "t3_gray_savg_glcm", "t3_gNDVI", "t1_B12", "t1_VH", "t0_MSAVI", "t3_MSAVI", "t3_VV", "t2_gray_savg_glcm",
              "t2_MSAVI", "t0_B3", "t2_gNDVI", "t2_VV", "t0_gray_idm_glcm", "t1_gNDVI", "t2_SI", "t3_gray_contrast_glcm"];
              

// Select target imager | pb = pixel based, oo = object oriented
// Apply band selection if necessary (for testing purposes)
var composite = AllChaco_pb //.select(bandsc); // or (bands)

// Ground Truth

// Notes:

// ** visu_lc attribute is the original disaggregated version of the visual interpretation step
//        
//        It includes 13 classes:
//          tc1	1, tc2	1, tc3	1, shrub	2, owl	2, grass	3, grasstree	3, mangroves	4, Flooded Veg.	5
//          built	6, PWater	7, SWater	0, Bare	9,  Crops	10
//          Not Included: tc4, tc5, tc67, Snow, moss/lichen
// ** visulcrec attribute is the reclassified version of the disaggregated version (visu_lc). 
//        It includes 9 classes:
//          tc1	1, tc2	1, tc3	1, shrub	2, owl	2, grass	3, grasstree	3, mangroves	4, Flooded Veg.	5
//          built	6, PWater	7, SWater	0, Bare	9,  Crops	10
//          Not Included: tc4, tc5, tc67, Snow, moss/lichen


var GroundTruthPoint_DF = ee.FeatureCollection("projects/hardy-tenure-383607/assets/DryForm_Project/GroundTruth/GroundTruthPoint_DF");
var GroundTruthPol_DF = ee.FeatureCollection("projects/hardy-tenure-383607/assets/DryForm_Project/GroundTruth/GroundTruthPol_DF");

// Select either points or polygons
var Gtp = GroundTruthPoint_DF 

// Point or polygon filtering | change variable aoi to run on a different biome
var gtp_f = Gtp.filter(ee.Filter.eq('aoiname', aoi)); 
var gtp_tr =  gtp_f.filter(ee.Filter.eq('purp', "training"));
var gtp_vl =  gtp_f.filter(ee.Filter.eq('purp', "validation"));

print("Original Training", gtp_tr.size());
print("Original Validation", gtp_vl.size());


// For the Pixel Based approach -> Balance classes
// In order to balance the class respect the other classes, the target column in randomized and merged again with the other classes.

    // Classes TC TC(1) + TC(2) + TC(3)
    // Total number of the three tree cover classes is 450 (tc1+tc2+tc3). Balanced samples are 150 approx.

var aTC = gtp_tr.filter(ee.Filter.lte("visu_lc", 3)); // First we select the Tree Cover class from the visu_lc attribute (Anything below or equal 3)
var bTC = aTC.randomColumn(); // We create a random values column
var cTC = bTC.filter('random > 0.65'); //We select a % over the random column. For random > 0 -> 450 classes. For 0.65: 159 samples 0.5: 221 samples

    // Classes Shrub(7 or 2) and OWL(8 or 2). There are different alternatives:
      // 1. Keep them separated (not very convenient for the pixel based approach), 2. Merge them, 3. Keep only shrub class 
      
var aSh = gtp_tr.filter(ee.Filter.eq("visu_lc", 7));

    // Class Grass(9 or 3) and GrassTree (10 or 3). There are different alternatives
      // 1. Keep them separated (not very convenient for the pixel based approach), 2. Merge them, 3. Keep only shrub class 

var aGr = gtp_tr.filter(ee.Filter.eq("visu_lc", 9));
var gt11 =  gtp_tr.filter(ee.Filter.gt("visu_lc", 11)); // Select all the other classes and merge 


  // We merge the newly created columns into the final training set
gtp_tr = gt11.merge(cTC).merge(aSh).merge(aGr); 

// Rename the inputs | Final set for RF
var trainingGcp = gtp_tr;
var validationGcp = gtp_vl;


var applybuffer = function(feature) {
return feature.buffer(20)};
trainingGcp = trainingGcp.map(applybuffer);
validationGcp = validationGcp.map(applybuffer);

print("Training GCP Final", trainingGcp);
print("Validation GCP Final", validationGcp);

// Overlay the point on the image to get training data.
var training = composite.sampleRegions({
  collection: trainingGcp, 
  properties: [landcover], 
  scale: 10
});

Map.addLayer(composite, null, "S1-S2 Composite", 0)
Map.addLayer(trainingGcp, null, "Training Points", 0)

//**********************
// Train a classifier.
//**********************

// Use here the parameters established in the Hyperparameter Tunning step
// Hyperparameters may be different for pixel based or object oriented approach. Check within the Hyperparameter Tunning step
var classifier = ee.Classifier.smileRandomForest({
		numberOfTrees: 40, // The number of decision trees to create.
    variablesPerSplit: 8, // The number of variables per split. If unspecified, uses the square root of the number of variables.
    minLeafPopulation: 2, // Only create nodes whose training set contains at least this many points.
    bagFraction: 0.5, //The fraction of input to bag per tree.
    maxNodes: 20, //The maximum number of leaf nodes in each tree. If unspecified, defaults to no limit.
//	seed:false, // The randomization seed.
  }).train({
  features: training,  
  classProperty: landcover, 
  inputProperties: composite.bandNames()
});

// // Classify the image.
var classified = composite.classify(classifier);

//************************************************************************** 
// Feature Importance | Accuracies, etc.
//************************************************************************** 

// Run .explain() to see what the classifer looks like
print("Classifier", classifier.explain());

// Get a confusion matrix and overall accuracy for the training sample.
var trainAccuracy = classifier.confusionMatrix();
print('Training error matrix', trainAccuracy);
print('Training overall accuracy', trainAccuracy.accuracy());

// Calculate variable importance
var importance = ee.Dictionary(classifier.explain().get('importance'));

// Calculate relative importance
var sum = importance.values().reduce(ee.Reducer.sum());

var relativeImportance = importance.map(function(key, val) {
   return (ee.Number(val).multiply(100)).divide(sum);
  });
print(relativeImportance);

// Create a FeatureCollection so we can chart it
var importanceFc = ee.FeatureCollection([
  ee.Feature(null, relativeImportance)
]);

var chart = ui.Chart.feature.byProperty({
  features: importanceFc
}).setOptions({
      title: 'Feature Importance',
      vAxis: {title: 'Importance'},
      hAxis: {title: 'Feature'}
  });
print(chart);


//************************************************************************** 
// Accuracy Assessment
//************************************************************************** 

// Use classification map to assess accuracy using the validation fraction
// of the overall training set created above.
var test = classified.sampleRegions({
  collection: validationGcp,
  properties: [landcover],
  tileScale: 16,
  scale: 10,
});

var testConfusionMatrix = test.errorMatrix(landcover, 'classification');

print('Confusion Matrix', testConfusionMatrix);
print('VAL Accuracy', testConfusionMatrix.accuracy());


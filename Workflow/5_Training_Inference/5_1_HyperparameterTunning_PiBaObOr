//************************************************************************** 
// Hyperparameter Tuning - Multiple Parameter x4  (or x5)
//************************************************************************** 

/*
** numberOfTrees (Integer): variablesPerSplit (Integer, default: null):
    The number of variables per split. If unspecified, uses the square root of the number of variables.
** minLeafPopulation (Integer, default: 1): Only create nodes whose training set contains at least this many points.
** bagFraction (Float, default: 0.5): The fraction of input to bag per tree.
** maxNodes (Integer, default: null): The maximum number of leaf nodes in each tree. If unspecified, defaults to no limit.
** seed (Integer, default: 0): The randomization seed.
*/

//Set the hyperparameters list for iterative retrieval.
// Number of trees computed in the previous step should be included in the numTreesList
// e.g. for Chaco pixel based the highest accuracy is for nTrees: 60
//var numTreesList = ee.List.sequence(50, 500, 50);
var numTreesList = ee.List([60, 80, 100, 120]);
//var variablesPerSplitList = ee.List.sequence(5, 70, 5);
var variablesPerSplitList = ee.List([8, 16, 24]);
//var bagFractionList = ee.List.sequence(0.1, 0.9, 0.2);
var bagFractionList = ee.List([0.5, 0.7, 0.9]);
var minLeafPopList = ee.List.sequence(1, 24, 4);
var maxNodesList = ee.List.sequence(2, 10, 2);
//var seedList = ee.List.sequence(0, 150, 0); //Not implemented

/*
Better to run with fixed number of trees and less iterations to avoid memory issues
Otherwise make it sequentially - one by one or two by two - first number of trees
Then with the best performing number test the bag fraction, etc.
var numTreesList = ee.List.sequence(50, 500, 50);
var bagFractionList = ee.List.sequence(0.1, 0.9, 0.3);
var minLeafPopList = ee.List.sequence(1, 24, 4);
var maxNodesList = ee.List.sequence(10, 150, 30);
var seedList = ee.List.sequence(0, 150, 0);
*/

var accuracies = numTreesList.map(function(numTrees) {
    return variablesPerSplitList.map(function(variablesPerSplit) {
    return bagFractionList.map(function(bagFraction) {
    return minLeafPopList.map(function(minLeafPopulation) {
    return maxNodesList.map(function(maxNodes) {
    
     
     var classifier = ee.Classifier.smileRandomForest({
       numberOfTrees: numTrees,
       bagFraction: bagFraction,
       minLeafPopulation: minLeafPopulation,
       maxNodes: maxNodes
     })
      .train({
        features: training,
        classProperty: landcover,
        inputProperties: composite.bandNames()
      });

    // Here we are classifying a table instead of an image
    // Classifiers work on both images and tables
    var accuracy = test
      .classify(classifier)
      .errorMatrix(landcover, 'classification')
      .accuracy();
    return ee.Feature(null, {'accuracy': accuracy,
      'numberOfTrees': numTrees,
      'bagFraction': bagFraction,
      'nimLeafPop': minLeafPopulation,
      'maxNodesList': maxNodes,
      'variablesPerSplit': variablesPerSplit
    });
  });
  });
  });
  });
}).flatten();
var resultFc = ee.FeatureCollection(accuracies);


// Export the result as CSV
Export.table.toDrive({
  collection: resultFc,
  description: 'Multiple_Parameter_Tuning_Results',
  folder: 'earthengine',
  fileNamePrefix: 'hyperparameter_tuning',
  fileFormat: 'CSV'});
  

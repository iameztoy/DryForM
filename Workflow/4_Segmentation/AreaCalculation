//*******************************************************
// Area calculation by class and AOI for large areas
//*******************************************************

// Exports the Feature Collection as a CSV file

var areaImage = ee.Image.pixelArea().divide(1e6).addBands(mv);

var areas = areaImage.reduceRegion({
      reducer: ee.Reducer.sum().group({
      groupField: 1,
      groupName: 'classification',
    }),
    geometry: AOI,
    scale: 10,
    maxPixels: 1e13
    }); 
    
var classAreas = ee.List(areas.get('groups'));


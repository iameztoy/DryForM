var chaco = ee.FeatureCollection("users/iameztoy/dryform/AOIs/eco_zone_Chaco");
/***** End of imports. If edited, may not auto-convert in the playground. *****/

//****************************************************
// DRYFORM - Segmentation of preprocessed imagery
//****************************************************

// This piece of code is to export as an asset an all-in-one segmentation
// It is also intended for testing purposes. Size segmentation of 12, 24 and 49 has been run.

var chaco_ic = ee.ImageCollection("projects/hardy-tenure-383607/assets/Preprocessing/s1s2_Chaco");
chaco = chaco.geometry().buffer(300)

chaco_ic = chaco_ic.mosaic().clip(chaco)
//Map.addLayer(a, null, "Image Collection")

var size_segmentation = 12

var seeds = ee.Algorithms.Image.Segmentation.seedGrid(size_segmentation);

var snic = ee.Algorithms.Image.Segmentation.SNIC({
  image: chaco_ic, 
  //size: 12,
  compactness: 0,  
  connectivity: 8, 
  neighborhoodSize: 256, 
  seeds: seeds
})

Export.image.toAsset({
  image: snic,
  description: 'Chaco_SNIC_sNAc0c8n256se12',
  assetId: 'projects/hardy-tenure-383607/assets/DryForm_Project/Segmentation/Chaco_SNIC_sNAc0c8n256se12',
  crs: "EPSG:4326",
  //crsTransform: proj_obj.transform,
    scale: 10,
  //region: geometry,
  maxPixels: 1e13
    
});



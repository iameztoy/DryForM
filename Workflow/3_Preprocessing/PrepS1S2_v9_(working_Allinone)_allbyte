    var bi_a = ((img.select("B4").pow(2).add(img.select("B3").pow(2))).divide(2)).sqrt().rename("iBI"); //I add the "i" to avoid the "B.*" selection afterwards
    var bi = bi_a.multiply(255).toByte();
    var si_a = img.expression('((1-red)*(1-green)*(1-blue)**(0.333333) )', {
      'red': img.select('B4'), 'green': img.select('B3'),'blue': img.select('B2')}).rename('SI');
      //( (1-b2)*(1-b3)*(1-b4) )^(1/3)
    var si = si_a.multiply(255).toByte();
    /*

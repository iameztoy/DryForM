  // In order to avoid memory errors we create a function with the entire process within a single function.
  // This should be run along with the list of input tiles (tilelist).

var processTiles = function(tile){
  
  //var interm_aoi = zonesID.filter(ee.Filter.eq('ID', tile))
  //var interm_aoi = zonesID.filter(ee.Filter.eq('ID', ee.List([tile])));
  var interm_aoi = zonesID.filter(ee.Filter.inList('ID', ee.List([tile])));
  //print("interm aoi fx", interm_aoi)

    var gndvi_a = img.normalizedDifference(['B8', 'B3']).rename('gNDVI');
    var gndvi = gndvi_a.multiply(255).toByte();
    var msavi2_a = img.select('B8').multiply(2).add(1)
      .subtract(img.select('B8').multiply(2).add(1).pow(2)
      .subtract(img.select('B8').subtract(img.select('B4')).multiply(8)).sqrt())

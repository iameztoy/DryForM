//  Continuation of LCProc_v2_1_TreeForest version for Shrubs/Scrub and Grass. 
// Overall maximum value 4


//--------------
// Datasets
//

var RefineStep1 = ee.Image("projects/ee-dryforestia/assets/Global_forest_step1"); //Our first processing step

//var WC2020 = ee.ImageCollection("ESA/WorldCover/v100").first(); //review! even remove and use esawc2020
var dw = ee.ImageCollection("GOOGLE/DYNAMICWORLD/V1"); //+Info: https://developers.google.com/earth-engine/datasets/catalog/GOOGLE_DYNAMICWORLD_V1#bands
var esri_lulc2020 = ee.ImageCollection("projects/sat-io/open-datasets/landcover/ESRI_Global-LULC_10m"); //+Info https://gee-community-catalog.org/projects/esrilc2020/
var esawc2020 = ee.ImageCollection("ESA/WorldCover/v100").first(); //v100 also available
var GLC10 = ee.ImageCollection("projects/sat-io/open-datasets/FROM-GLC10");
var CH_GEDI = ee.ImageCollection('users/potapovpeter/GEDI_V27').mosaic();
var GEDI_Lang = ee.Image('users/nlang/ETH_GlobalCanopyHeight_2020_10m_v1');

////Global land use UMD https://www.nature.com/articles/s43016-021-00429-z  https://glad.umd.edu/dataset/croplands

var cropmask_UMD_2003=ee.ImageCollection('users/potapovpeter/Global_cropland_2003').mosaic().unmask(); 
var cropmask_UMD_2007=ee.ImageCollection('users/potapovpeter/Global_cropland_2007').mosaic().unmask(); 
var cropmask_UMD_2011=ee.ImageCollection('users/potapovpeter/Global_cropland_2011').mosaic().unmask(); 
var cropmask_UMD_2015=ee.ImageCollection('users/potapovpeter/Global_cropland_2015').mosaic().unmask(); 
var cropmask_UMD_2015=ee.ImageCollection('users/potapovpeter/Global_cropland_2019').mosaic().unmask(); // January 2019 !!
var cropmask_UMD = cropmask_UMD_2003.or(cropmask_UMD_2007).or(cropmask_UMD_2011).or(cropmask_UMD_2015).or(cropmask_UMD_2015);


//--------------
// VARIABLES GENERAL

var srt = '2020-01-01'; var end = '2021-01-01';

//--------------
// PROCESSING

// 0. WorldCover 2020
//var WC2020Forest = WC2020.eq(10);

// 1. Dynamic World

var dwl = dw.filterDate(srt, end).select("label"); //.filterBounds(AOIpt)
var dwMode = dwl.reduce(ee.Reducer.mode()); //Mode reducer for the period selected
  
var dwM_shrub = dwMode.eq(5).rename(['Shrubs_dw']); //Trees 1, shrub_and_scrub 5, Grass 2
var dwM_grass = dwMode.eq(2).rename(['Grass_dw']); //Trees 1, shrub_and_scrub 5, Grass 2

// 2. ESRI LULC 2020

var esri_aoi = esri_lulc2020.mosaic(); 
var esri_shrub = esri_aoi.eq(7).rename(['Shrub_esri']);  // Trees 3, shrubs 7, Grass 4 NEED TO DOUBLE CHECK WHICH CLASS ARE TREES APPARENTLY IT IS BAND 3 BUT THEN IT SEEMS IT IS 2??
var esri_grass = esri_aoi.eq(4).rename(['Grass_esri']); 

// 3. ESA World Cover 2020

var esa_shrub = esawc2020.eq(20);  // Tree 10, shrubland 20, grassland 30
var esa_grass = esawc2020.eq(30);  


// 4. GLC10 and 6.1 Hansen Loss (2018-2020)

var glc10m = GLC10.mosaic();
var glc10m_grass = glc10m.eq(30);
var glc10m_shrub = glc10m.eq(40); //Grass 30, Shrub	40


//5. GEDI <= 5

var gedilt5 = CH_GEDI.lt(5);     


// n. Overall Shrub 2020

var TotalShrub2020 =  dwM_shrub.add(esri_shrub).add(esa_shrub).add(glc10m_shrub);
var TotalShrub2020s = TotalShrub2020.subtract(gedilt5);


// n. Overall Grass 2020

var TotalGrass2020 = dwM_grass.add(esri_grass).add(esa_grass).add(glc10m_grass);
var TotalGrass2020s = TotalGrass2020.subtract(gedilt5);

//Remap

var fromListsg = [-1, 0, 1, 2, 3, 4];
var toListsg =   [0, 0, 1, 2, 3, 4];

var TotalShrub2020sr = TotalShrub2020s.remap({
  from: fromListsg,
  to: toListsg,
  defaultValue: 0,
  //bandName: 'Total Shrub 2020'
});

var TotalGrass2020sr = TotalGrass2020s.remap({
  from: fromListsg,
  to: toListsg,
  defaultValue: 0,
  //bandName: 'Total Grass 2020'
});

var TotalShrub2020sr = TotalShrub2020sr.unmask();
var TotalGrass2020sr = TotalGrass2020sr.unmask();

//Total shrub/scrub + Grass
var totalSG = TotalShrub2020sr.add(TotalGrass2020sr)


//VISUALIZATION

Map.addLayer(Caatinga, {}, "Caatinga", 0);
Map.addLayer(Cerrado, {}, "Cerrado", 0);
Map.addLayer(Chaco, {}, "Chaco", 0);

Map.addLayer(TotalGrass2020sr, imageVisParam, "Total Grass 2020", 0); //Range 0-4
Map.addLayer(TotalShrub2020sr, imageVisParam, "Total Shrub 2020", 0); //Range 0-4
Map.addLayer(totalSG, imVP8cl, "Total Shrub/Scrub and Grass", 0) //Range 0-8






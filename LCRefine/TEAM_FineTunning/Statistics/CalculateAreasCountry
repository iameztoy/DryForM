////Admin Boundaries
var gaul = ee.FeatureCollection('FAO/GAUL_SIMPLIFIED_500m/2015/level0');
var SCo = gaul.filter(ee.Filter.eq('ADM0_CODE', 66));

// MMU applied over version 1 of GFC
var forest_v01 = ee.ImageCollection('users/bourgoinclement2/ForestReferenceMap/v1/EUFO_Forest2020_v1'); //users/bourgoinclement2/ForestReferenceMap/EUFO_Forest2020_v01
var proj = forest_v01.first().projection();
var fmos = forest_v01.mosaic();
fmos.clip(SCo)
var mmu = 5000;

var fcount = fmos.connectedPixelCount({maxSize: 250, eightConnected:true}).reproject({crs:proj});
var farea = ee.Image.pixelArea().reproject({crs:proj});
var area = fcount.multiply(farea);


var mask_lte = area.lte(mmu);
var mix = fmos.add(mask_lte);
var mix_s = mix.gte(1);
var mix_s_sm = mix_s.selfMask();

var fcount2 = mix_s_sm.connectedPixelCount({maxSize: 250, eightConnected:true}).reproject({crs:proj});
var farea2 = ee.Image.pixelArea().reproject({crs:proj});
var area2 = fcount2.multiply(farea2);

var mask_gte = area2.gte(mmu);
var final = mask_gte.updateMask(mask_gte);


////GFC20 v1
var GFC20 = ee.ImageCollection('JRC/GFC2020/V1').mosaic();


////WorldCover 2020 and 2021
var WC2021 = ee.ImageCollection('ESA/WorldCover/v200').first();
var WC2021_s = (WC2021.eq(10)).or(WC2021.eq(95));
var WC2021_m = WC2021_s.updateMask(WC2021_s);

////WRI TC
var TC_wri = ee.ImageCollection("projects/wri-datalab/TropicalTreeCover").mosaic();
var TC_wri_map = TC_wri.gte(80).rename(['Trees']).selfMask();




//var SqKm = ee.Number(stateArea).divide(1e6).round()

var WC2021_cl = WC2021_m.clip(SCo);
var GFC20_cl = GFC20.clip(SCo);
var WRI_cl = TC_wri_map.clip(SCo);

var areaim_WC2021 = WC2021_cl.multiply(ee.Image.pixelArea());
var areaim_GFC20 = GFC20_cl.multiply(ee.Image.pixelArea());
var areaim_WRI = WRI_cl.multiply(ee.Image.pixelArea());

var areaim_fmos = fmos.multiply(ee.Image.pixelArea());
var areaim_lte5000 = mask_lte.multiply(ee.Image.pixelArea());
var areaim_final = final.multiply(ee.Image.pixelArea());

//Define scale to compute reducer
var scale = 10;

var area_WC2021 = areaim_WC2021.reduceRegion({
  reducer: ee.Reducer.sum(),
  geometry: SCo.geometry(),
  scale: scale,
  maxPixels: 1e10
  });
  
var area_GFC20 = areaim_GFC20.reduceRegion({
  reducer: ee.Reducer.sum(),
  geometry: SCo.geometry(),
  scale: scale,
  maxPixels: 1e10
  });
  
var area_WRI = areaim_WRI.reduceRegion({
  reducer: ee.Reducer.sum(),
  geometry: SCo.geometry(),
  scale: scale,
  maxPixels: 1e10
  });

  
var area_fmos = areaim_fmos.reduceRegion({
  reducer: ee.Reducer.sum(),
  geometry: SCo.geometry(),
  scale: scale,
  maxPixels: 1e10
  });
  
var area_lte5000 = areaim_lte5000.reduceRegion({
  reducer: ee.Reducer.sum(),
  geometry: SCo.geometry(),
  scale: scale,
  maxPixels: 1e10
  });
  
var area_final = areaim_final.reduceRegion({
  reducer: ee.Reducer.sum(),
  geometry: SCo.geometry(),
  scale: scale,
  maxPixels: 1e10
  });

var area_fmos_ha = ee.Number(area_fmos.get('Map')).divide(1e4).round(); //sqKm 1e6 1e4 Ha
var area_lte5000_ha = ee.Number(area_lte5000.get('Map')).divide(1e4).round(); //sqKm 1e6
var area_final_ha = ee.Number(area_final.get('Map')).divide(1e4).round(); //sqKm 1e6
var area_WC2021_sqkm = ee.Number(area_WC2021.get('Map')).divide(1e4).round(); //sqKm
var area_GFC20_sqkm = ee.Number(area_GFC20.get('Map')).divide(1e4).round(); //sqKm
var area_WRI_sqkm = ee.Number(area_WRI.get('Trees')).divide(1e4).round(); //sqKm

print(area_fmos_ha);
print(area_lte5000_ha);
print(area_final_ha);
print(area_WC2021_sqkm);
print(area_GFC20_sqkm);
print(area_WRI_sqkm);

var vp_wc2021 = {"opacity":1,"bands":["Map"],"palette":["ff0a0a"]};
var vp_gfc2020 = {"opacity":1,"bands":["Map"],"max":1,"palette":["31b319"]};
var vp_wri = {"opacity":1,"bands":["Trees"],"palette":["ffe66e"]};

Map.addLayer(WRI_cl, vp_wri,'TC_wri_map');
Map.addLayer(WC2021_cl, vp_wc2021, "WC 2021 TC" );
Map.addLayer(GFC20_cl, vp_gfc2020, "GFC 2020" );

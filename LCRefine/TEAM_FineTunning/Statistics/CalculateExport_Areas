var dataset = ee.ImageCollection('JRC/GFC2020/V1').mosaic();

var visualization = {
  bands: ['Map'],
  palette: ['4D9221']};

Map.setCenter(0.0, 0.0, 2);

Map.addLayer(dataset, visualization, 'EC JRC Global forest cover 2020 – V1');

var Zones=ee.FeatureCollection('users/bourgoinclement2/World_UNctry_grid');//



var LOOPsamples= function(feature) {
  var vals = dataset.multiply(ee.Image.pixelArea()).reduceRegion({
    reducer: ee.Reducer.sum(), 
    geometry: feature.geometry(),
    scale: 10,
    maxPixels: 5e9,
  }); 
  return ee.Feature(null, vals).copyProperties(feature, feature.propertyNames());
};

var LOOPresult2=Zones.map(LOOPsamples);

Export.table.toDrive({
	collection: LOOPresult2,
	description: 'JRC_GFC2020_V1_AreaEstimates',
	folder: '',
	fileNamePrefix: 'JRC_GFC2020_V1_AreaEstimates',
});





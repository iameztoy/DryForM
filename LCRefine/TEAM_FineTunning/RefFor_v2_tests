// ‘forest’ means land spanning more than 0,5 hectares (5000 m2 - 50 pixels of 10m) with trees higher than 5 metres and a canopy cover of more
// than 10 %, or trees able to reach those thresholds in situ, excluding land that is predominantly under agricultural
// or urban land use;

// ‘agricultural use’ means the use of land for the purpose of agriculture, including for 
// agricultural plantations and setaside agricultural areas, and for rearing livestock;

// agricultural plantation’ means land with tree stands in agricultural production systems, such as fruit tree plantations, oil palm plantations,
// olive orchards and agroforestry systems where crops are grown under tree cover; it
// includes all plantations of relevant commodities other than wood; agricultural plantations are excluded from the
// definition of ‘forest’;

////////////////////////////////////////////
////Step1 GLOBAL PROCESSING
////////////////////////////////////////////

//////////////// INPUT DATA

////JRC-TMF: 

var Transition = ee.ImageCollection('projects/JRC/TMF/v1_2022/TransitionMap_Subtypes').mosaic();
var humidDomain= ((Transition.gte(10)).and(Transition.lte(69))).or((Transition.gte(80)).and(Transition.lte(89)));

Map.addLayer(humidDomain, null, "TMF Humid Domain", 0);

////WorldCover 2020

var WC2020 = ee.ImageCollection("ESA/WorldCover/v100").first();
var WC2020_foret = WC2020.eq(10);

Map.addLayer(WC2020, null, "WC 2020", 0);
Map.addLayer(WC2020_foret, null, "Forest 2020 2021", 0);

//2021 shows a greater extent of the Tree Cover class 10 
//We can select maximum extent of class 10 on 2020 and 2021
var WC2021 = ee.ImageCollection('ESA/WorldCover/v200').first();
var WC2021_foret = WC2021.eq(10);
var WC2020_21_foret = WC2021_foret.or(WC2020_foret);
Map.addLayer(WC2020_21_foret.updateMask(WC2020_21_foret),{min:1,max:1, palette:['green']},'WC2020_21_foret',true);

var lc2019 = ee.Image("COPERNICUS/Landcover/100m/Proba-V-C3/Global/2019");
Map.addLayer(lc2019, null, "lc2019 100m");

//Shrub, herbaceous vegetation, Cultivated and managed vegetation / agriculture, urban/built-up, bare, wetlands.
var lc2019_otherlandcover = ((lc2019.select('discrete_classification').gte(20)).and(lc2019.select('discrete_classification').lte(100)));
Map.addLayer(lc2019_otherlandcover.updateMask(lc2019_otherlandcover),{},'lc2019_otherlandcover',false);

////Drivers of forest cover loss : https://data.globalforestwatch.org/documents/gfw::tree-cover-loss-by-dominant-driver-2022/about
//1 Commodity-driven deforestation: Large-scale deforestation linked primarily to commercial agricultural expansion.
//2 Shifting agriculture: Temporary loss or permanent deforestation due to small- and medium-scale agriculture.
//3 Forestry: Temporary loss from plantation and natural forest harvesting, with some deforestation of primary forests.
//4 Wildfire: Temporary loss, does not include fire clearing for agriculture.
//5 Urbanization: Deforestation for expansion of urban centers.

var CurtisMapDrivers = ee.Image('projects/planet-guido/assets/curtis');
CurtisMapDrivers=(CurtisMapDrivers.eq(3)).or(CurtisMapDrivers.eq(4));

Map.addLayer(CurtisMapDrivers, null, "Curtis Map Drivers", 0);


////Global land use UMD https://www.nature.com/articles/s43016-021-00429-z  https://glad.umd.edu/dataset/croplands

var cropmask_UMD_2003=ee.ImageCollection('users/potapovpeter/Global_cropland_2003').mosaic().unmask(); 
var cropmask_UMD_2007=ee.ImageCollection('users/potapovpeter/Global_cropland_2007').mosaic().unmask(); 
var cropmask_UMD_2011=ee.ImageCollection('users/potapovpeter/Global_cropland_2011').mosaic().unmask(); 
var cropmask_UMD_2015=ee.ImageCollection('users/potapovpeter/Global_cropland_2015').mosaic().unmask(); 
var cropmask_UMD_2019=ee.ImageCollection('users/potapovpeter/Global_cropland_2019').mosaic().unmask(); // Janvier 2019 !!
var cropmask_UMD = cropmask_UMD_2003.or(cropmask_UMD_2007).or(cropmask_UMD_2011).or(cropmask_UMD_2015).or(cropmask_UMD_2019);
Map.addLayer(cropmask_UMD.updateMask(cropmask_UMD),{},'cropmask_UMD',false);


////Add ESA World Cereal 2021 for cereals crop mapping (wheat, barley and rye) https://zenodo.org/record/7875105  
//Evaluate if makes any difference - very marginal overlap between forest classes from worldcover and worldcereals 
//https://developers.google.com/earth-engine/datasets/catalog/ESA_WorldCereal_2021_MODELS_v100
// crop/no crop is the temporary crops products

var dataset = ee.ImageCollection('ESA/WorldCereal/2021/MODELS/v100');

// Typically we'd want to mask the "other" class (value 0)
// in the images
function mask_other(img) {
  return img.updateMask(img.neq(0));
}
// Apply the mask_other function to the collection
dataset = dataset.map(mask_other);

// Get a global mosaic for all agro-ecological zone (AEZ) of temporary crops
var temporarycrops = dataset.filter('product == "temporarycrops"').mosaic().select('classification');

// Visualization specifics
var visualization_class = {
  bands: ["classification"],
  max: 100,
  palette: ["ff0000"]
};

Map.addLayer(temporarycrops, visualization_class, 'ESA WorldCereals Temporary crops', false);


////GFSAD USGS Landsat-Derived Global Rainfed and Irrigated-Cropland Product (https://gee-community-catalog.org/projects/lgrip30/?h=)
//Cropland that is permanently cropped with plantations (for example, orchards, vineyards, coffee, tea, and rubber) is included

var GFSAD = ee.ImageCollection('projects/sat-io/open-datasets/GFSAD/LGRIP30').mosaic();
/*
Class Label	Name	Description
0	Ocean	Ocean and Water bodies
1	Non-croplands	Land with other land use
2	Irrigated croplands	Agricultural croplands that are irrigated
3	Rainfed croplands	Agricultural croplands that are rainfed
*/

var GFSAD_crop = (GFSAD.eq(2)).or(GFSAD.eq(3));
Map.addLayer(GFSAD_crop,{},'GFSAD_crop',false);



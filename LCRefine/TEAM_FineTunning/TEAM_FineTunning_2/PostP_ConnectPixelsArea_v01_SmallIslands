var vp_area = {"opacity":1,"bands":["Map"],"min":6695.83100920014,"max":8941.438217099632,"gamma":1},
    vp_mix = {"opacity":1,"bands":["Map"],"max":2,"gamma":1},
    vp_final = {"opacity":1,"bands":["Map"],"palette":["51ac3a"]},
    vp_fmos = {"opacity":1,"bands":["Map"],"max":1,"palette":["000000","e51b05"]},
    vp_farea = {"opacity":1,"bands":["area"],"min":49.49585922678552,"max":49.54894921126505,"gamma":1};
/***** End of imports. If edited, may not auto-convert in the playground. *****/
var forest_v01 = ee.ImageCollection('projects/hardy-tenure-383607/assets/MissingIslands_Forest_indivs'); //users/bourgoinclement2/ForestReferenceMap/EUFO_Forest2020_v01
var proj = forest_v01.first().projection();
var fmos = forest_v01.mosaic();
var mmu = 5000;

// Considering that the pixel areas depend on the latitude and that the minimum size of these pixel
// areas is around 35 meters for fmos extent, we have to increase the maxSize number to more than (5000/min size pixel) in order to
// reach at least half an hectare. E.g. 200 connexted pixels * 35 > MMU. Thus, we can filter any area with 
// at least 0.5 ha. 

//We have added new tiles that were missing in the original forest product. Some of this tiles are in the northern 
//regions. Thus, we need to change the pixel size to 250. This is missing in the current version 1 processing.

var fcount = fmos.connectedPixelCount({maxSize: 200, eightConnected:true}).reproject({crs:proj});
var farea = ee.Image.pixelArea().reproject({crs:proj});
var area = fcount.multiply(farea);


var mask_lte = area.lte(mmu);
var mix = fmos.add(mask_lte);
var mix_s = mix.gte(1);
var mix_s_sm = mix_s.selfMask();

var fcount2 = mix_s_sm.connectedPixelCount({maxSize: 200, eightConnected:true}).reproject({crs:proj});
var farea2 = ee.Image.pixelArea().reproject({crs:proj});
var area2 = fcount2.multiply(farea2);

var mask_gte = area2.gte(mmu);
var final = mask_gte.updateMask(mask_gte);

Map.addLayer(fmos, vp_fmos, "fmos", 1); 
Map.addLayer(fcount, null, "fcount", 0);
Map.addLayer(farea, vp_farea, "farea", 0);
Map.addLayer(area, vp_area, "area", 0);   
Map.addLayer(mask_lte, null, "LTE 5000", 0);   
Map.addLayer(mix, vp_mix, "mix", 0);       
Map.addLayer(mix_s, null, "mix_s", 0); 
Map.addLayer(mix_s_sm, null, "mix_s_sm", 0);
Map.addLayer(fcount2, null, "fcount 2", 0);
Map.addLayer(farea2, vp_farea, "farea 2", 0);
Map.addLayer(area2, vp_area, "area 2", 0); 
Map.addLayer(mask_gte, null, "mask_gte", 0);
Map.addLayer(final, vp_final, "final", 1);




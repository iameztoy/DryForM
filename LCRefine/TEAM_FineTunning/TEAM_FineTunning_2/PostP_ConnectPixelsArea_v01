var forest_v01 = ee.ImageCollection('users/bourgoinclement2/ForestReferenceMap/v1/EUFO_Forest2020_v1'); //users/bourgoinclement2/ForestReferenceMap/EUFO_Forest2020_v01
var proj = forest_v01.first().projection();
var fmos = forest_v01.mosaic();
var mmu = 5000;

// Considering that the pixel areas depend on the latitude and that the minimum size of these pixel
// areas is around 11 meters in the northern lats, we have to increase the maxSize number to more than (5000/min size pixel which
// for fmos is around 35 pixels. ) in order to
// reach at least half an hectare. To be checked.

var fcount = fmos.connectedPixelCount({maxSize: 200, eightConnected:true}).reproject({crs:proj});
var farea = ee.Image.pixelArea().reproject({crs:proj});
var area = fcount.multiply(farea);


var mask_lte = area.lte(mmu);
var mix = fmos.add(mask_lte);
var mix_s = mix.gte(1);
var mix_s_sm = mix_s.selfMask();

var fcount2 = mix_s_sm.connectedPixelCount({maxSize: 200, eightConnected:true}).reproject({crs:proj});
var farea2 = ee.Image.pixelArea().reproject({crs:proj});
var area2 = fcount2.multiply(farea2);

var mask_gte = area2.gte(mmu);
var final = mask_gte.updateMask(mask_gte);


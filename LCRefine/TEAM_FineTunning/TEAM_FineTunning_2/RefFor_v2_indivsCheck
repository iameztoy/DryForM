/**** Start of imports. If edited, may not auto-convert in the playground. ****/
var kernel3 = ee.Image("projects/hardy-tenure-383607/assets/FineTuningTest/GlobalF_step1_America_Kernel3"),
    ivis = {"opacity":1,"bands":["Map"],"max":1,"gamma":1};
/***** End of imports. If edited, may not auto-convert in the playground. *****/
var NA = ee.Image('users/bourgoinclement2/Global_forest_step1_AOI_America1');
var WC2020 = ee.ImageCollection("ESA/WorldCover/v100").first();
var WC2020_foret = WC2020.eq(10);

var WC2021 = ee.ImageCollection('ESA/WorldCover/v200').first();
var WC2021_foret = WC2021.eq(10);
var WC2020_21_foret = WC2021_foret.or(WC2020_foret);

var CurtisMapDrivers = ee.Image('projects/planet-guido/assets/curtis');
CurtisMapDrivers=(CurtisMapDrivers.eq(3)).or(CurtisMapDrivers.eq(4));

var cropmask_UMD_2003=ee.ImageCollection('users/potapovpeter/Global_cropland_2003').mosaic().unmask(); 
var cropmask_UMD_2007=ee.ImageCollection('users/potapovpeter/Global_cropland_2007').mosaic().unmask(); 
var cropmask_UMD_2011=ee.ImageCollection('users/potapovpeter/Global_cropland_2011').mosaic().unmask(); 
var cropmask_UMD_2015=ee.ImageCollection('users/potapovpeter/Global_cropland_2015').mosaic().unmask(); 
var cropmask_UMD_2019=ee.ImageCollection('users/potapovpeter/Global_cropland_2019').mosaic().unmask(); // Janvier 2019 !!
var cropmask_UMD = cropmask_UMD_2003.or(cropmask_UMD_2007).or(cropmask_UMD_2011).or(cropmask_UMD_2015).or(cropmask_UMD_2019);

var cereal = ee.ImageCollection('ESA/WorldCereal/2021/MODELS/v100');

// Typically we'd want to mask the "other" class (value 0)
// in the images
function mask_other(img) {
  return img.updateMask(img.neq(0));
}
// Apply the mask_other function to the collection
var cerealm = cereal.map(mask_other);
var temporarycrops = cerealm.filter('product == "temporarycrops"').mosaic().select('classification');
// Visualization specifics
var visualization_class = {
  bands: ["classification"],
  max: 100,
  palette: ["ff0000"]
};

////GFSAD USGS Landsat-Derived Global Rainfed and Irrigated-Cropland Product (https://gee-community-catalog.org/projects/lgrip30/?h=)
//Cropland that is permanently cropped with plantations (for example, orchards, vineyards, coffee, tea, and rubber) is included

var GFSAD = ee.ImageCollection('projects/sat-io/open-datasets/GFSAD/LGRIP30').mosaic();
/*
Class Label	Name	Description
0	Ocean	Ocean and Water bodies
1	Non-croplands	Land with other land use
2	Irrigated croplands	Agricultural croplands that are irrigated
3	Rainfed croplands	Agricultural croplands that are rainfed
*/
var GFSAD_crop = (GFSAD.eq(2)).or(GFSAD.eq(3));

var ghsl = ee.Image("JRC/GHSL/P2023A/GHS_BUILT_C/2018");
var ghsl_built = ghsl.select('built_characteristics').gte(1);

Map.addLayer(WC2020_21_foret.updateMask(WC2020_21_foret),{min:1,max:1, palette:['green']},'WC Forest v200',true);
Map.addLayer(WC2020_foret, null, "WC Forest v100");
Map.addLayer(kernel3, ivis, "Kernel");
Map.addLayer(NA, ivis, "No Kernel");

Map.addLayer(ghsl_built.updateMask(ghsl_built),{color:"blue"},'built',false);
Map.addLayer(GFSAD_crop,{},'GFSAD_crop',false);
Map.addLayer(temporarycrops, visualization_class, 'ESA WorldCereals Temporary crops', false);
Map.addLayer(CurtisMapDrivers, null, "Curtis Map Drivers", 0);
Map.addLayer(cropmask_UMD.updateMask(cropmask_UMD),{},'cropmask_UMD',false);





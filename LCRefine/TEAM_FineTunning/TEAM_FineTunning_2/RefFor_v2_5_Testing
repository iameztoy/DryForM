//WRI

var TC_wri = ee.ImageCollection("projects/wri-datalab/TropicalTreeCover").mosaic();
var TC_wri_map = TC_wri.gte(80)


//Tree Cover UMD
var GLCmap = ee.ImageCollection('projects/glad/GLCmap2019').mosaic();
var treecoverUMD=(GLCmap.gte(54).and(GLCmap.lte(91))).or(GLCmap.gte(174).and(GLCmap.lte(211)));
var agriUMD = ((GLCmap.gte(0)).and(GLCmap.lte(53))).or((GLCmap.gte(120)).and(GLCmap.lte(170))).or((GLCmap.gte(240)).and(GLCmap.lte(249))).or((GLCmap.gte(251)).and(GLCmap.lte(252)))
var agriUMD_51_53 = GLCmap.gte(51).and(GLCmap.lte(53));


//Loss Year

var gfcImage = ee.Image("UMD/hansen/global_forest_change_2022_v1_10");  
var treeCover = gfcImage.select(['treecover2000']);
var lossImage = gfcImage.select(['loss']);
var gainImage = gfcImage.select(['gain']);
var lossYear = gfcImage.select(['lossyear']).unmask(); //2001=1, 2015=15


////WorldCover 2020 and 2021
var WC2020 = ee.ImageCollection("ESA/WorldCover/v100").first();
var WC2021 = ee.ImageCollection('ESA/WorldCover/v200').first();


//2021 shows a greater extent of the Tree Cover class 10  and mangroves 95
//We can select maximum extent of class 10 and 95 on 2020 and 2021
var WC2020_foret = (WC2020.eq(10)).or(WC2020.eq(95));
var WC2021_foret = (WC2021.eq(10)).or(WC2021.eq(95));


var WC2020_21_foret = WC2021_foret.or(WC2020_foret).or(treecoverUMD.unmask().and(lossYear.neq(20))).or(TC_wri_map); //issue (9.541755, 50.908829)
var WC2020_21_foret_NoWRI = WC2021_foret.or(WC2020_foret).or(treecoverUMD.unmask().and(lossYear.neq(20)));



// ADD Layers


Map.addLayer(TC_wri_map, null, "WRI => 80")
Map.addLayer(treecoverUMD, null, "Tree Cover UMD")
Map.addLayer(WC2020,{},'ESA WC2020',false);
Map.addLayer(WC2021,{},'ESA WC2021',false);
Map.addLayer(WC2021_foret.updateMask(WC2021_foret),{min:1,max:1, palette:['black']},'WC2021_foret',false);
Map.addLayer(WC2020_21_foret.updateMask(WC2020_21_foret),{min:1,max:1, palette:['black']},'Initial forest',false);
Map.addLayer(WC2020_21_foret_NoWRI.updateMask(WC2020_21_foret_NoWRI),{min:1,max:1, palette:['black']},'Initial forest No WRI',false);
Map.addLayer(agriUMD.updateMask(agriUMD), null, "Agri UMD 0 - 53")
Map.addLayer(agriUMD_51_53.updateMask(agriUMD_51_53), null, "Agri UMD 51 - 53")
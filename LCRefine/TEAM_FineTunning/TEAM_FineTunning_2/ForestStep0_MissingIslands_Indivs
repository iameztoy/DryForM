lossYearGFC2000_2020= lossYearGFC2000_2020.updateMask(no_fire_loss);

Global_forest_step1 = Global_forest_step1.where(lossYearGFC2000_2020,0);

Map.addLayer(Global_forest_step1.updateMask(Global_forest_step1),{min:1,max:1, palette:['red']},'Removal of tree cover loss ',false);



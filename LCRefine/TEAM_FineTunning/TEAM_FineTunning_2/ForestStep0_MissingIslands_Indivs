///////////////////////////////////////////////
// Define Tree cover initial mask /////////////
// Combine 4 products
//  1) Class 10 and 95 from WorldCover 2020 and 2021
//  2) Classes 53-91 and 174-211 from GLC 2019 UMD
//  3) WRI Tree cover dataset, TC>= 80
//  4) Mangroves

//1. Class 10 and 95 from WorldCover 2020 and 2021
var WC2020_foret = (WC2020.eq(10)).or(WC2020.eq(95));
var WC2021_foret = (WC2021.eq(10)).or(WC2021.eq(95));
Map.addLayer(WC2021_foret.updateMask(WC2021_foret),{min:1,max:1, palette:['black']},'WC2021_foret',false);

//2. UMD GLC 2019 Tree cover classes
var treecoverUMD=(GLCmap.gte(53).and(GLCmap.lte(91))).or(GLCmap.gte(173).and(GLCmap.lte(211)));

//3. WRI Tree cover dataset, TC>= 80
var TC_wri_map = TC_wri.gte(80).unmask().rename(['Trees']);
Map.addLayer(TC_wri_map,{},'TC_wri_map',false);

//4. Mangroves - from Mangroves2020

/////////////////////////////////////////////
//***Initial forest
/////////////////////////////////////////////

var Global_forest_step1 = WC2021_foret.or(WC2020_foret).or(TC_wri_map.unmask()).or(Mangroves2020.unmask()).or(treecoverUMD.unmask()); //issue (9.541755, 50.908829)
Global_forest_step1 = Global_forest_step1.where(WC2020_foret.and(WC2021.eq(80)).and(Mangroves2020.unmask().not()),0); //114.701294, -2.566712
Global_forest_step1 = Global_forest_step1.where(WC2021_foret.and(WC2020.eq(80)).and(Mangroves2020.unmask().not()),0);

// Global_forest_step1 = Global_forest_step1.where(Ecozone50_img.and((GLCmap.gte(38)).and(GLCmap.lte(50))),0); // reduce forests in the transition zone between taiga-tundra and taiga-bogs (e.g. Nenets Okrug)


Map.addLayer(Global_forest_step1.updateMask(Global_forest_step1),{min:1,max:1, palette:['blue']},'Initial forest',true);


//////////////////////////////////////////////////////////////////////////////////////////////
// Masking of tree height lower than 5 meters in the tropics
// Using tree height product derived from landsat and GEDI Potapov
// Except in mangrove area (89.270039, 22.05554)
//////////////////////////////////////////////////////////////////////////////////////////////
// In Ecozone 1
//in Undisturbed tropical moist forest (1) or Degraded tropical moist forest (2) according to TMF Annual change for 2020

var cond_mangrove = Mangroves2020.or(mangroveTMF2020);
Global_forest_step1 = Global_forest_step1.where((CH_GEDI.gte(0)).and(CH_GEDI.lt(5)).and(Ecozone1_img).and(cond_mangrove.not()),0); 

Global_forest_step1 = Global_forest_step1.where((CH_GEDI.gte(0)).and(CH_GEDI.lt(5)).and(tmf_forest2020.gte(1)).and(cond_mangrove.not()),0);

Map.addLayer(Global_forest_step1.updateMask(Global_forest_step1),{min:1,max:1, palette:['lime']},'forest higher or equal to 5 (tropics) ',false);

//////////////////////////////////////////////////////////////////////////////////////////////

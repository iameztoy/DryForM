// Loop to export
var featlist = Zones.getInfo()["features"];
//print(featlist)
for (var f in featlist) {
  var feat = ee.Feature(featlist[f]);
  var dis = feat.get("system:index");
  var disS = dis.getInfo();
  var name = "chip_MI_";  
  Export.image.toAsset({
    image: Edged1,
    description: name+disS,
    assetId: 'projects/hardy-tenure-383607/assets/DistanceForestEdge3_1/' + name+disS,
    pyramidingPolicy:"mode", //Activate and select the Pyramiding Policy
    crs: 'EPSG:4326',
    //fileNamePrefix: name+disS.toString(), //only available in Export to Drive
    region: feat.geometry().bounds(),
    scale: 10,
    maxPixels: 1e13
  });
}



//---------------------

Map.addLayer(WC2020, null, "WC2020", 0)
Map.addLayer(final.updateMask(final),{  
'min':1,  
'max': 4,  
'palette': PALETTE},'final',true)

Map.addLayer(Edged1.updateMask(Edged1),{},'Edged1',false)
Map.addLayer(Edged2.updateMask(Edged2),{},'Edged2',false)
Map.addLayer(Edged3.updateMask(Edged3),{},'Edged3',false)
Map.addLayer(forest.updateMask(forest),{},'forest',false)





/////////////////////
// IAA Oct. 2023
//
// Adapted from previous DryForM versions
// Sum of different datasets for Majority Vote calculation
// Note that while applying the MV threshold the number of observations vary depending on the region. 
// Therefore, number of pixels with valid observations have been calculated (count)
// Sum of products have been divided by the previous variable || perc = TotTreeFor/count
// A threshold of e.g. perc > 0.5 (50%) can be set to get a new boolean map, so the outcome (majority) is 
//    calculated based on the number of observations regardless their unequal distribution.




//****************************
// DATASETS
//****************************

//var WC2020 = ee.ImageCollection("ESA/WorldCover/v100").first(); //review! even remove and use esawc2020
var dw = ee.ImageCollection("GOOGLE/DYNAMICWORLD/V1"); //+Info: https://developers.google.com/earth-engine/datasets/catalog/GOOGLE_DYNAMICWORLD_V1#bands
var esri_lulc2020 = ee.ImageCollection("projects/sat-io/open-datasets/landcover/ESRI_Global-LULC_10m"); //+Info https://gee-community-catalog.org/projects/esrilc2020/
var esawc2020 = ee.ImageCollection("ESA/WorldCover/v100").first();
var esawc2021 = ee.ImageCollection('ESA/WorldCover/v200').first();
var TC_wri = ee.ImageCollection("projects/wri-datalab/TropicalTreeCover").mosaic();
var GLC10 = ee.ImageCollection("projects/sat-io/open-datasets/FROM-GLC10");
var gfcImage = ee.Image("UMD/hansen/global_forest_change_2021_v1_9"); 
var CH_GEDI = ee.ImageCollection('users/potapovpeter/GEDI_V27').mosaic();
var GEDI_Lang = ee.Image('users/nlang/ETH_GlobalCanopyHeight_2020_10m_v1');
var image0 = ee.Image("projects/hardy-tenure-383607/assets/CopForest10m/TCD2018010m0"), //Copernicus 10 meter Europe
    image1 = ee.Image("projects/hardy-tenure-383607/assets/CopForest10m/TCD2018010m1"),
    image3 = ee.Image("projects/hardy-tenure-383607/assets/CopForest10m/TCD2018010m3"),
    image5 = ee.Image("projects/hardy-tenure-383607/assets/CopForest10m/TCD2018010m5"),
    image6 = ee.Image("projects/hardy-tenure-383607/assets/CopForest10m/TCD2018010m6"),
    image8 = ee.Image("projects/hardy-tenure-383607/assets/CopForest10m/TCD2018010m8"),
    image7 = ee.Image("projects/hardy-tenure-383607/assets/CopForest10m/TCD2018010m7"),
    image2 = ee.Image("projects/hardy-tenure-383607/assets/CopForest10m/TCD2018010m2"),
    image4 = ee.Image("projects/hardy-tenure-383607/assets/CopForest10m/TCD2018010m4");

var Transition = ee.ImageCollection('projects/JRC/TMF/v1_2020/TransitionMap_Subtypes').mosaic();
var humidDomain= ((Transition.gte(10)).and(Transition.lte(69))).or((Transition.gte(80)).and(Transition.lte(89)));
var AnnualChange= ee.ImageCollection('projects/JRC/TMF/v1_2022/AnnualChanges').mosaic()

//////////////////
    
var GLCmap = ee.ImageCollection('projects/glad/GLCmap2019').mosaic(); //Legend: https://storage.googleapis.com/earthenginepartners-hansen/GLCLU_2019/legend.xlsx

//****************************
// SIMPLE PROCESSING
//****************************

// 1. Dynamic World
var srt = '2020-01-01'; var end = '2021-01-01'; //For DW processing
var dwl = dw.filterDate(srt, end).select("label"); //.filterBounds(AOIpt)
var dwMode = dwl.reduce(ee.Reducer.mode()); //Mode reducer for the period selected
var dwM_Tree = dwMode.eq(1).unmask().rename(['Trees']);  //Trees 1, shrub_and_scrub 5, Grass 2

// 2. ESRI LULC 2020
var esri_aoi = esri_lulc2020.mosaic(); 
var esri_Tree = esri_aoi.eq(2).unmask().rename(['Trees']); // Trees 3, shrubs 7, Grass 4 NEED TO DOUBLE CHECK WHICH CLASS ARE TREES APPARENTLY IT IS BAND 3 BUT THEN IT SEEMS IT IS 2

// 3. ESA World Cover 2020/2021

var esa_Tree2020 = (esawc2020.eq(10)).or(esawc2020.eq(95));
var esa_Tree2021 = (esawc2021.eq(10)).or(esawc2021.eq(95));
var esa_Tree_p = esa_Tree2020.or(esa_Tree2021);
var esa_Tree = esa_Tree_p.unmask().rename(['Trees']);

// 4. WRI Tree Cover 2020
var TC_wri_m = TC_wri.gte(80).unmask().rename(['Trees']);


// 5. GFC 2001-2020
var treeCover = gfcImage.select(['treecover2000']);
var treeCover10 = treeCover.gte(10);
var lossYear = gfcImage.select(['lossyear']).unmask(); //2001=1, 2015=15
var lossb2020 = lossYear.gte(1).and(lossYear.lte(20));
var HTC_2020 = treeCover10.subtract(lossb2020);
var HTC_2020_1 = HTC_2020.eq(1).unmask().rename(['Trees']); //remove negative values


// 6. GLC10 (2017) and 6.1 Hansen Loss (2018-2020)
var glc10m = GLC10.mosaic();
var glc10mForest = glc10m.eq(20); //Forest 20
var HLoss2018_2020 = lossYear.gte(2018).and(lossYear.lte(20));
var glc10Loss = glc10mForest.subtract(HLoss2018_2020);
var glc10Loss_1 = glc10Loss.eq(1).unmask().rename(['Trees']);

//7. GEDI => 5 Potapov
var gedi5P = CH_GEDI.gte(5).unmask().rename(['Trees']);

//8. GEDI Lang  => 5
var gedi5L = GEDI_Lang.gte(5).unmask().rename(['Trees']);

//9. Copernicus Europe
var ctcd = ee.ImageCollection([image0, image1, image2, image3, image4, image5, image6, image7, image8]);
var ctcd_mos = ctcd.mosaic();
var Cop10m = ctcd_mos.gte(10).and(ctcd_mos.lte(100)); // To comply to FAO definition of Forest: dens. =>10%
Cop10m = Cop10m.unmask().rename(['Trees']);

//10. TMF
var plantation = (Transition.gte(80)).and(Transition.lte(89));
var old_regrowth = (Transition.eq(31)); 
var AC= ee.ImageCollection('projects/JRC/TMF/v1_2022/AnnualChanges').mosaic().select('Dec2020');
var tmf = (AC.eq(1)).or(AC.eq(2));
var tmf_pl = tmf.where(plantation,0); 
var tmf_plrg = tmf_pl.add(old_regrowth).unmask().rename(['Trees']);
var tmf_plrg_m = tmf_plrg.gte(1);
var tmf_final = tmf_plrg_m.updateMask(tmf_plrg_m).unmask();

////////////////////////////

// UMD Dataset
var UMD_T3to5m = GLCmap.gte(50).and(GLCmap.lte(53)); //3 4 and 5m stable open trees


//****************************
// SIMPLE PROCESSING 2
//****************************

var TotTreeFor_p = dwM_Tree.add(esri_Tree).add(esa_Tree).add(TC_wri_m).add(HTC_2020_1).add(glc10Loss_1).add(gedi5P).add(gedi5L).add(Cop10m).add(tmf_final);
var mask = TotTreeFor_p.gte(1);
var TotTreeFor = TotTreeFor_p.updateMask(mask);

var thr = 5; //Majority Vote threshold

var majmask = TotTreeFor.gte(thr);
var TreeThr =TotTreeFor.updateMask(majmask);
var TreeThrBool = TreeThr.gte(4);

//****************************
// COUNT OBS.
//****************************
var dwM_c = dwMode.eq(1); var esri_c = esri_aoi.eq(2);
var esa_c = esa_Tree_p; var wri_c = TC_wri.gte(80);
var HTC2020_c = HTC_2020.eq(1); var glc10_c = glc10Loss.eq(1);
var gedi5P_c = CH_GEDI.gte(5); var gedi5L_c = GEDI_Lang.gte(5);
var Cop10m_c = ctcd_mos.gte(10).and(ctcd_mos.lte(100)); var tmf_c = tmf_plrg.gte(1);

var r1 = dwM_c.rename("f");
var r2 = esri_c.rename("f");
var r3 = esa_c.rename("f");
var r4 = wri_c.rename("f");
var r5 = HTC2020_c.rename("f");
var r6 = glc10_c.rename("f");
var r7 = gedi5P_c.rename("f");
var r8 = gedi5L_c.rename("f");
var r9 = Cop10m_c.rename("f");
var r10 = tmf_c.rename("f");

var plist = [r1, r2, r3, r4, r5, r6, r7, r8,r9, r10];
var col = ee.ImageCollection.fromImages(plist);
var count = col.count();

print(col);

var perc = TotTreeFor_p.divide(count);


//****************************
// ADD LAYERS
//****************************

//Vis params
var visP1 = {"opacity":1,"bands":["Trees"],"palette":["ffac64"]}; // World Cover 2020/2021
var visP2 = {"opacity":1,"bands":["Trees"],"palette":["7cff2b"]}; // Tree Boolean Thresholded
var visP3 = {"opacity":1,"bands":["b1"],"palette":["ff3210"]}; // UMD 3, 4 and 5 meter Trees
var visP4 = {"opacity":1,"bands":["f"],"max":9,"palette":["000000","ffb497","ffd916","cfff84","9aff82","3fffa7","58aaff","c4b5ff","a662ff","ff8686"]};

Map.setOptions('SATELLITE');
Map.addLayer(TC_wri_m.updateMask(TC_wri_m), null, "WRI >= 80", 1);
Map.addLayer(TotTreeFor, null, "Total Tree/Forest", 0);
Map.addLayer(TreeThr, null, "Tree thresholded", 0);
Map.addLayer(esa_Tree.updateMask(esa_Tree), visP1, "World Cover 2020/2021", 1);
Map.addLayer(UMD_T3to5m.updateMask(UMD_T3to5m), visP3, "UMD 3, 4 and 5 meter Trees", 1);
Map.addLayer(count, visP4, "Count", 0);
Map.addLayer(perc, null, "Percentage", 0);
Map.addLayer(TreeThrBool.updateMask(TreeThrBool), visP2, "Tree Boolean Thresholded", 1);




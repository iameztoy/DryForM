//***Forest map (no MMU)
var forest_v01 = ee.ImageCollection('users/bourgoinclement2/ForestReferenceMap/v1/EUFO_Forest2020_v1').mosaic();
var MI = ee.ImageCollection('projects/hardy-tenure-383607/assets/MissingIslands_Forest_indivs').mosaic();

//***Forest map (MMU)
var forest_MMU = ee.ImageCollection('projects/hardy-tenure-383607/assets/EUFO_Forest2020_v1_post_MMUAreaProj');
var MI_MMU = ee.ImageCollection('projects/hardy-tenure-383607/assets/MissingIslands_Forest_indivs_MMUAreaProj');

var forest_MMU_final = (forest_MMU.merge(MI_MMU)).mosaic().selfMask()
Map.addLayer(forest_MMU_final, null, "MMU merged")


//***Buffer distances
//200m
var buf200 = ee.ImageCollection('users/bourgoinclement2/ForestReferenceMap/v1/DistanceForestEdge1');
var MI_buf200 = ee.ImageCollection('projects/hardy-tenure-383607/assets/MissingIslands_Buf200');

var buf200_final = (buf200.merge(MI_buf200)).mosaic().selfMask()
Map.addLayer(buf200_final, null, "Buf 200 merged")

//500m
var buf500 = ee.ImageCollection('projects/ee-astridverhegghen/assets/DistanceForestEdge2');
var MI_buf500 = ee.ImageCollection('projects/hardy-tenure-383607/assets/MissingIslands_Buf500');

var buf500_final = (buf500.merge(MI_buf500)).mosaic().selfMask()
Map.addLayer(buf500_final, null, "Buf 500 merged")

//1000m
var buf1000_set1 = ee.ImageCollection("projects/hardy-tenure-383607/assets/DistanceForestEdge3_1");
var buf1000_set2 = ee.ImageCollection("projects/ee-dryforestia/assets/DistanceForestEdge3_2");
var MI_buf1000 = ee.ImageCollection('projects/hardy-tenure-383607/assets/MissingIslands_Buf1000');

var buf1000_final = (buf1000_set1.merge(buf1000_set2).merge(MI_buf1000)).mosaic().selfMask();
Map.addLayer(buf1000_final, null, "Buf 1000 merged")


var vp_forest1 = {"opacity":1,"max":1,"palette":["3ec01e"]};
var vp_forest0 = {"opacity":1,"max":1,"palette":["21781b"]};

Map.addLayer(forest_v01.selfMask(), vp_forest0, "Forest Original",false)
Map.addLayer(forest_MMU, vp_forest1, "Forest MMU without some islandss",false);
Map.addLayer(forest_MMU_final, vp_forest1, "Forest MMU",false);
Map.addLayer(buf1000_final.updateMask(buf1000_final), {"opacity":1,"max":1,"palette":["white"]}, "Buffer 1km",false);
Map.addLayer(buf500_final.updateMask(buf500_final), {"opacity":1,"max":1,"palette":["yellow"]}, "Buffer 500m",false);
Map.addLayer(buf200_final.updateMask(buf200_final), {"opacity":1,"max":1,"palette":["red"]}, "Buffer 200m",false);


//*** Final v1
var final = forest_MMU_final.unmask().where(buf1000_final.unmask(),4);
final = final.where(buf500_final.unmask(),3);
final = final.where(buf200_final.unmask(),2);

var WC2020 = ee.ImageCollection("ESA/WorldCover/v100").first().unmask();
final = final.where(WC2020.eq(80),0)

var visualization = {
 min: 1.0, 
 max: 4.0, 
 palette: ['4D9221', 'DE77AE', 'F1B6DA', 'FDE0EF'] 
}; 
 
 
Map.addLayer(final.updateMask(final), visualization, 'EC JRC Global forest cover 2020 - v1');
print(final)


////EXPORT 
// Loop to export
var Zones=ee.FeatureCollection('users/bourgoinclement2/ForestReferenceMap/Grid10deg')

var featlist = ee.FeatureCollection(Zones).getInfo()["features"];
for (var f in featlist) {
  var feat = ee.Feature(featlist[f]); 
  var dis = feat.get("id");
  var disS = dis.getInfo();
  var name = "tile";  
  Export.image.toAsset({
    image: final,
    description: name+disS.toString(),
    assetId: 'users/bourgoinclement2/ForestReferenceMap/v1/JRC_GFC2020_C1/' + name+disS.toString(),
    pyramidingPolicy:"mode", //Activate and select the Pyramiding Policy
    crs: 'EPSG:4326',
    //fileNamePrefix: name+disS.toString(), //only available in Export to Drive
    region: feat.geometry().bounds(),
    scale: 10,
    maxPixels: 1e13
  });
}




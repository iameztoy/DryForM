/**** Start of imports. If edited, may not auto-convert in the playground. ****/
var vp_fv01 = {"opacity":1,"bands":["Map"],"min":0,"max":1,"gamma":1};
/***** End of imports. If edited, may not auto-convert in the playground. *****/
var forest_v01 = ee.ImageCollection('users/bourgoinclement2/ForestReferenceMap/EUFO_Forest2020_v01');
var proj = forest_v01.first().projection();
var fmos = forest_v01.mosaic();

var fcount = fmos.connectedPixelCount({eightConnected:true}).reproject({crs:proj});
var farea = ee.Image.pixelArea().reproject({crs:proj});
var area = fcount.multiply(farea);
var mmu = 5000;

var mask_lte = area.lte(mmu);
var mask_gte = area.gte(mmu);
var mix = fmos.add(mask_lte);
var mix_sf = mix.selfMask();

var fcount2 = mix_sf.connectedPixelCount({eightConnected:true}).reproject({crs:proj});
var farea2 = ee.Image.pixelArea().reproject({crs:proj});
var area2 = fcount2.multiply(farea);
var mmu = 5000;

var mask_gte = area2.gte(mmu);
var final = mix_sf.updateMask(mask_gte);


Map.addLayer(forest_v01, vp_fv01, "Forest v01");
Map.addLayer(mask_lte, null, "Forest Mask LTE 5000");
Map.addLayer(mix, vp_fv01, "Voids Filled");
Map.addLayer(mix_sf, vp_fv01, "Voids Filled SelfMask")
Map.addLayer(mask_gte, null, "Forest Mask GTE 5000")
Map.addLayer(final, null, "Final");


Map.setOptions('SATELLITE');

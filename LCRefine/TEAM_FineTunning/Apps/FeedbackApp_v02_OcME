/* -----------------------------
Set Areas of Interest & Layers
--------------------------------*/

var AOI = ee.Geometry.MultiPolygon(
        [[[[107.73889969564004, -10.177086328250287],
           [107.73889969564004, -50.1012085834927],
           [182.00647782064004, -50.1012085834927],
           [182.00647782064004, -10.177086328250287]]],
         [[[154.06824539876504, -0.3653019987679177],
           [154.06824539876504, -10.014843226330488],
           [167.25183914876504, -10.014843226330488],
           [167.25183914876504, -0.3653019987679177]]],
         [[[-177.86354442489016, 2.867095419185493],
           [-177.86354442489016, -45.29746943889416],
           [-99.90456004989011, -45.29746943889416],
           [-99.90456004989011, 2.867095419185493]]],
         [[[25.51536182510988, 55.572145973898174],
           [25.51536182510988, 11.25385837391952],
           [88.70872120010988, 11.25385837391952],
           [88.70872120010988, 55.572145973898174]]]], null, false);


// Load Forest BLM 2020
var forest =ee.ImageCollection('users/bourgoinclement2/ForestReferenceMap/EUFO_Forest2020_v0_post').mosaic(); //Preliminary version
var forestm = forest.updateMask(forest);
var forestcl= forestm.clip(AOI); //Change this for each App

/* -----------------------------
Panels and Layouts
--------------------------------*/

// Create an empty panel.
// The layout is vertical flow by default.
var panel = ui.Panel({
  layout: ui.Panel.Layout.flow('vertical'),
  style: {width: '300px'}
});

// Create an intro panel with labels.
var intro = ui.Panel([
  ui.Label({
    value: 'Forest Baseline Map 2020',
    style: {fontSize: '20px', fontWeight: 'bold'}
  }),
  
  ui.Label({
    value: 'Clic on a location to get coordinates',
    style: {fontSize: '14px', fontWeight: 'bold'}
  }),
]);

panel.add(intro);

// Set a callback function for when the user clicks the map.
Map.onClick(function(coords) {
  var location = 'lon: ' + coords.lon.toFixed(5) + ' ' +
                 'lat: ' + coords.lat.toFixed(5);
  panel.widgets().set(1, ui.Label(location));
  var point = ee.Geometry.Point(coords.lon, coords.lat);
  Map.layers().set(1, ui.Map.Layer(point, {color: 'FF0000'}, "Point of Interest"));
});

/* -----------------------------
Add Layers and set Map
--------------------------------*/

//Visu Params

// Create an empty image into which to paint the features, cast to byte.
var empty = ee.Image().byte();

// Paint all the polygon edges with the same number and width, display.
var outline = empty.paint({
  featureCollection: AOI,
  color: 1,
  width: 3
});

var visPar = {"opacity":0.70,"bands":["Map"],"min":1,"max":1,"palette":["008000"]};

//Add Layers

//Map.addLayer(outline, {palette: 'FF0000'}, 'Area of Interest', true);
Map.addLayer(forestcl, visPar, 'Forest BL 2020 - South Africa', true);

//Set Map params
//Map.centerObject(AOI, 4);
Map.setCenter(96.81, 19.91, 3);
Map.style().set('cursor', 'crosshair');
Map.setOptions('SATELLITE');
Map.setControlVisibility({drawingToolsControl:false});

// Add the panel to the ui.root.
ui.root.add(panel);
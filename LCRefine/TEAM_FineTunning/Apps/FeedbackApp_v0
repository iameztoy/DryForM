/* -----------------------------
Set Areas of Interest & Layers
--------------------------------*/

// Areas of Interest
var NorthAmerica = ee.Geometry.Polygon([[[-170.05779793621525, 71.44398194429216],[-170.05779793621525, 6.411426070626747],
          [-47.88982918621525, 6.411426070626747],[-47.88982918621525, 71.44398194429216]]], null, false);
var Asia =  ee.Geometry.Polygon([[[25.586733313784766, 81.94878398109365],[25.586733313784766, -48.45391172946717],
          [190.8211083137846, -48.45391172946717],[190.8211083137846, 81.94878398109365]]], null, false);
var Europe = ee.Geometry.Polygon([[[-29.78436043621523, 77.80212451317189],[-29.78436043621523, 26.420011247207597],
          [79.90313956378476, 26.420011247207597],[79.90313956378476, 77.80212451317189]]], null, false);
var LatinAmerica = ee.Geometry.Polygon([[[-125.49725106121522, 36.93988116802135],[-125.49725106121522, -56.42082976339518],
          [-29.16912606121523, -56.42082976339518],[-29.16912606121523, 36.93988116802135]]], null, false);
var Africa = ee.Geometry.Polygon([[[-20.38006356121523, 38.67573176871493],[-20.38006356121523, -39.10568325366553],
          [54.15118643878477, -39.10568325366553],[54.15118643878477, 38.67573176871493]]], null, false);
var Siberia = ee.Geometry.Polygon([[[50.28399893878477, 78.59282214664536],[50.28399893878477, 48.09906672749329],
          [191.4363426887848, 48.09906672749329],[191.4363426887848, 78.59282214664536]]], null, false);
var Tropics =  ee.Geometry.Polygon([[[-129.36443856121522, 32.09057856136751],[-129.36443856121522, -29.39308885991816],
          [173.33087393878475, -29.39308885991816],[173.33087393878475, 32.09057856136751]]], null, false);

var AOI = NorthAmerica;

// Load Forest BLM 2020
var forest = ee.ImageCollection('users/bourgoinclement2/EUFO_Forest2020').mosaic();
var forestm = forest.updateMask(forest);
var forest_NA = forestm.clip(AOI); //Change this for each App

/* -----------------------------
Panels and Layouts
--------------------------------*/

// Create an empty panel.
// The layout is vertical flow by default.
var panel = ui.Panel({
  layout: ui.Panel.Layout.flow('vertical'),
  style: {width: '300px'}
});

// Create an intro panel with labels.
var intro = ui.Panel([
  ui.Label({
    value: 'Forest Baseline Map 2020',
    style: {fontSize: '20px', fontWeight: 'bold'}
  }),
  
  ui.Label({
    value: 'Clic on a location to get coordinates',
    style: {fontSize: '14px', fontWeight: 'bold'}
  }),
]);

panel.add(intro);

// Set a callback function for when the user clicks the map.
Map.onClick(function(coords) {
  var location = 'lon: ' + coords.lon.toFixed(4) + ' ' +
                 'lat: ' + coords.lat.toFixed(4);
  panel.widgets().set(1, ui.Label(location));
  var point = ee.Geometry.Point(coords.lon, coords.lat);
  Map.layers().set(1, ui.Map.Layer(point, {color: 'FF0000'}));
});

/* -----------------------------
Add Layers and set Map
--------------------------------*/
Map.addLayer(forest_NA, {min:1,max:1, palette:['green']}, 'Forest BL 2020 - North America', true);
// AOIs visu - To be removed
Map.addLayer(NorthAmerica, null, "North America", false);
Map.addLayer(Asia, null, "Asia", false);
Map.addLayer(Europe, null, "Europe", false);
Map.addLayer(LatinAmerica, null, "Latin America", false);
Map.addLayer(Africa, null, "Africa", false);
Map.addLayer(Siberia, null, "Siberia", false);
Map.addLayer(Tropics, null, "Tropics", false);

Map.centerObject(AOI, 4);
Map.style().set('cursor', 'crosshair');
Map.setOptions('SATELLITE');

// Add the panel to the ui.root.
ui.root.add(panel);
            title: 'Count',
            titleTextStyle: {italic: false, bold: true},
            minValue: 0,
            maxValue: 1
          },
          lineWidth: 5,
          //colors: ['e37d05', '1d6b99'],
          curveType: 'function'
        }); //END of BLOCK 2

panel.widgets().set(1, chart4all); //Locate chart inside panel



//*Copied from and older file
//------------------------------
//
// IAA 2019 Process and combine land cover classes from different product to get a new layer by mixing forest, tree cover and woodland + probably associated
// transition zones. The idea is to extract tiles that will be further refined and used in the frame of semantic segmentation procedures

//preliminary AOIpl and AOIpt is only for testing purposes

//idea from https://www.mdpi.com/2072-4292/14/16/4101: 
//DW 72% versus reported 74%; WC 65% versus reported 74%; Esri 75% versus 85%. 
//We note that it is also possible to use all three LULC products in combination by 
//creating some form of majority vote or weighted average.  
//Me: we could control a bit better whether to focus on omission or commission error
//for normalization see: https://gis.stackexchange.com/questions/313394/normalization-in-google-earth-engine

//DW 0.73
//WC 0.70
//ESRI 0.80
//Hansen? 0.8

//2020 baseline: need also to mitigate the impact (outweighs) of  number of datasets used per pixel;
//The maximum score we get is a sum of the number of products used, so to mitigate this issue
//Need to remove all about esawc2020
//Add From GLC10 https://gee-community-catalog.org/projects/glc10/?h=glc10



//--------------
// Datasets
//

var RefineStep1 = ee.Image("projects/ee-dryforestia/assets/Global_forest_step1"); //Our first processing step

var WC2020 = ee.ImageCollection("ESA/WorldCover/v100").first(); //review! even remove and use esawc2020
var dw = ee.ImageCollection("GOOGLE/DYNAMICWORLD/V1"); //+Info: https://developers.google.com/earth-engine/datasets/catalog/GOOGLE_DYNAMICWORLD_V1#bands
var esri_lulc2020 = ee.ImageCollection("projects/sat-io/open-datasets/landcover/ESRI_Global-LULC_10m"); //+Info https://gee-community-catalog.org/projects/esrilc2020/
var esawc2020 = ee.ImageCollection("ESA/WorldCover/v200").first(); //v100 also available
var TC_wri = ee.ImageCollection("projects/wri-datalab/TropicalTreeCover");
var GLC10 = ee.ImageCollection("projects/sat-io/open-datasets/FROM-GLC10");

// GFC 2001-2021
var gfcImage = ee.Image("UMD/hansen/global_forest_change_2021_v1_9"); 
var treeCover = gfcImage.select(['treecover2000']);
var treeCover10 = treeCover.gte(10);
var lossYear = gfcImage.select(['lossyear']).unmask(); //2001=1, 2015=15
var lossb2020 = lossYear.gte(1).and(lossYear.lte(20));
var lossYearGFC2000_2020 = (treeCover.gte(10)).and(lossb2020);
var HTC_2020 = treeCover10.subtract(lossb2020);



////Global land use UMD https://www.nature.com/articles/s43016-021-00429-z  https://glad.umd.edu/dataset/croplands

var cropmask_UMD_2003=ee.ImageCollection('users/potapovpeter/Global_cropland_2003').mosaic().unmask(); 
var cropmask_UMD_2007=ee.ImageCollection('users/potapovpeter/Global_cropland_2007').mosaic().unmask(); 
var cropmask_UMD_2011=ee.ImageCollection('users/potapovpeter/Global_cropland_2011').mosaic().unmask(); 
var cropmask_UMD_2015=ee.ImageCollection('users/potapovpeter/Global_cropland_2015').mosaic().unmask(); 
var cropmask_UMD_2015=ee.ImageCollection('users/potapovpeter/Global_cropland_2019').mosaic().unmask(); // January 2019 !!
var cropmask_UMD = cropmask_UMD_2003.or(cropmask_UMD_2007).or(cropmask_UMD_2011).or(cropmask_UMD_2015).or(cropmask_UMD_2015);

// GEDI CH 2019 

var CH_GEDI = ee.ImageCollection('users/potapovpeter/GEDI_V27').mosaic();

//--------------
// VARIABLES GENERAL

var srt = '2020-01-01'; var end = '2020-12-31';

//--------------
// PROCESSING

// 0. WorldCover 2020

var WC2020Forest = WC2020.eq(10);

// 1. Dynamic World

var dwl = dw.filterDate(srt, end).select("label"); //.filterBounds(AOIpt)
var dwMode = dwl.reduce(ee.Reducer.mode()); //Mode reducer for the period selected
var dwM_Tree = dwMode.eq(1).rename(['Trees']);  //Trees 1, shrub_and_scrub 5, Grass 2
var dwM_shrub = dwMode.eq(5).rename(['Shrubs']);

// 2. ESRI LULC 2020

var esri_aoi = esri_lulc2020.mosaic(); 
var esri_Tree = esri_aoi.eq(2).rename(['Trees']); // Trees 3, shrubs 7, Grass 4 NEED TO DOUBLE CHECK WHICH CLASS ARE TREES APPARENTLY IT IS BAND 3 BUT THEN IT SEEMS IT IS 2??
var esri_shrub = esri_aoi.eq(7).rename(['shrub']);

// 3. ESA World Cover 2020

var esa_Tree = esawc2020.eq(10); // Tree 10, shrubland 20
var esa_shrub = esawc2020.eq(20);

// 4. WRI Tree Cover 2020

var wrimax = TC_wri.max();
var wri80 = wrimax.eq(80);
var wri90 = wrimax.eq(90);
var wri100 = wrimax.eq(100);
var wri_Tree3 = wri80.add(wri90).add(wri100); //outcome ranges between 1 and 3
var wri_Treeu = wri_Tree3.unmask(0); //Reclass mask to zero so the calculation can go beyond the boundaries of the WRI dataset
var wri_Tree = wri_Treeu.gte(1)

// 5. GLC10

var glc10m = GLC10.mosaic()
var glc10mForest = glc10m.eq(20); //Forest 20, Shrub	40


// n. Overall Trees 2020

var sumDE = WC2020Forest.add(dwM_Tree).add(esri_Tree);
var sumDEW = sumDE.add(wri_Tree).add(glc10mForest);
var sumDEWs = sumDEW.add(HTC_2020); 
var sumDEWs = sumDEWs.where(cropmask_UMD,0);
var sumrec = sumDEWs.gte(1);

// n. Overall Shrub 2020

var sumshr = dwM_shrub.add(esri_shrub).add(esa_shrub);
var sumshrrec = sumshr.gte(1);


// Overall Tree + Shrub 1 = shrub or tree 2 = shrub and tree 0 = other class
var trsh = sumrec.add(sumshrrec);

//Select mixed trsh = 2. Mixed spectral response Trees/Shrub
var trshsel = trsh.eq(2);

//Need to remove value 2 (combination of Trees/Shrubs from the layers of 1) Treens and 2) Shrub))
var treemcomb = sumrec.subtract(trshsel);  //Overall Trees - (trees + shrub)
var shrubmcomb = sumshrrec.subtract(trshsel); //Overall Shrubs - (trees + shrub)

//Reclassify and Combine
var trees = treemcomb.add(9);
var shrubs = shrubmcomb.add(19);
var trsh = trshsel.add(29);

var final = treemcomb.add(shrubmcomb).add(trshsel);

//Countries or Polygons of Interest

var ctr = ["Brazil"];  //["Brazil", "Bolivia", "Paraguay", "Uruguay", "Argentina"]; //["Tanzania"]; 
var rgn = ["Europe", "Africa", "SW Asia"];

// Define mask to clip.
var mask = ee.FeatureCollection('USDOS/LSIB_SIMPLE/2017')
  .filter(ee.Filter.inList('country_na', ctr));
  //.filter(ee.Filter.inList('wld_rgn', rgn));   
  
//----------------
// SAMPLING
//
var region = Chaco;

// Generate x random points with the region.
var randomPoints = ee.FeatureCollection.randomPoints(
    {region: region, points: 500, seed: 0, maxError: 1});



var bounding_box_func = function(feature) {
    var intermediate_buffer = feature.buffer(1280);  // buffer radius, half your box width in m
    var intermediate_box = intermediate_buffer.bounds(); // Draw a bounding box around the circle
       return(intermediate_box); // Return the bounding box
      };
      
// Apply function
var Zones = randomPoints.map(bounding_box_func);

//Add Unique ID to each feature so it can be used to give a name while exporting to Drive
var utils = require('users/parevalo_bu/gee-ccdc-tools:ccdcUtilities/api');
Zones = utils.Classification.assignIds(Zones, 'ID');




//--------------
//VISUALIZATION

var dwVisParams = {min: 0, max: 8, palette: [
    '#419BDF', '#397D49', '#88B053', '#7A87C6', '#E49635', '#DFC35A',
    '#C4281B', '#A59B8F', '#B39FE1']};


Map.addLayer(mask, {}, "Selected courntries", 0);
Map.addLayer(Caatinga, {}, "Caatinga", 0);
Map.addLayer(Cerrado, {}, "Cerrado", 0);
Map.addLayer(Chaco, {}, "Chaco", 0);

//Map.addLayer(RefineStep1, {}, "Forest Refine Step1", 0);
Map.addLayer(WC2020Forest, {}, "World Cover 2020", 0);
Map.addLayer(dwl, dwVisParams, 'Dynamic World', 0);
Map.addLayer(esri_lulc2020, {}, "ESRI", 0);
Map.addLayer(dwM_Tree, {}, "DW Trees", 0);
Map.addLayer(dwM_shrub, {}, "DW Shrub", 0);
Map.addLayer(esri_Tree, {}, "ESRI Tree", 0);
Map.addLayer(esri_shrub, {}, "ESRI Shrub", 0);
Map.addLayer(esa_Tree, {}, "ESA Tree", 0);
Map.addLayer(esa_shrub, {}, "ESA Shrub", 0);
Map.addLayer(HTC_2020, {min:0, max:1},"Hansen Tree Cover 2020", 0);
Map.addLayer(wri80, {}, "WRI 80", 0);
Map.addLayer(wri90, {}, "WRI 90", 0);
Map.addLayer(wri100, {}, "WRI 100", 0);
Map.addLayer(wri_Tree, {}, "WRI Tree => 80", 0);



Map.addLayer(sumDE, {}, "sumDE", 0);
Map.addLayer(sumDEW, {}, "sumDEW", 0);
Map.addLayer(sumDEWs, {}, "sumDEWs", 0);
Map.addLayer(sumrec, {}, "sum Reclass", 0);
Map.addLayer(sumshr, {}, "Sum Shrub", 0);

Map.addLayer(treemcomb, {}, "Trees", 0);
Map.addLayer(shrubmcomb, {}, "Shrubs", 0);
Map.addLayer(trshsel, {}, "Trees/Shrub 1+1", 0);

Map.addLayer(final, {}, "Final", 0);

Map.addLayer(randomPoints, {color: 'red'}, 'Random points');
Map.addLayer(Zones, {color: '#FECA1E', fillColor: '#4c4cff'}, "Bounding boxes");





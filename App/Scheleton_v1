var RefineStep1 = ee.Image("projects/ee-dryforestia/assets/Global_forest_step1"); //Our first processing step
Map.setOptions("SATELLITE");


var panel = ui.Panel();
panel.style().set('width', '500px');
Map.style().set('cursor', 'crosshair');

// Create an intro panel with labels.
var intro = ui.Panel([
  ui.Label({
    value: 'Tree/Forest Explorer',
    style: {fontSize: '20px', fontWeight: 'bold'}
  }),
  
  ui.Label({
    value: 'Click on map to get a chart',
    style: {fontSize: '14px', fontWeight: 'bold'}
  }),
]);

panel.add(intro);
ui.root.insert(0, panel);



var lon = ui.Label();
var lat = ui.Label();



Map.onClick(function(coords) {
  // Update the lon/lat panel with values from the click event.
  lon.setValue('lon: ' + coords.lon.toFixed(2)),
  lat.setValue('lat: ' + coords.lat.toFixed(2));
  var point = ee.Geometry.Point(coords.lon, coords.lat);

  var chart =
    ui.Chart.image
        .series({
          imageCollection: ic_allTF,
          region: point,
          //reducer: ee.Reducer.mean(),
          scale: 10,
          xProperty: 'system:index'
        })
        .setSeriesNames(["DW", "ESRI", "ESA",  "WRI", "HANSEN", "GLS", "GEDI"])
        .setOptions({
          title: 'Tree/Forest Presence/Absence',
          hAxis: {title: 'Product', titleTextStyle: {italic: false, bold: true}},
          vAxis: {
            title: 'Count',
            titleTextStyle: {italic: false, bold: true}
          },
          lineWidth: 5,
          //colors: ['e37d05', '1d6b99'],
          curveType: 'function'
        });

  panel.widgets().set(1, ndviChart); //Locate chart inside panel
  
  
});

Map.addLayer(RefineStep1, {}, "RefineStep1");

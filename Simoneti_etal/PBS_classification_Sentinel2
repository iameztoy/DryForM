// INPUT: collection of single band image classification
// OUT :  sinle image with Land Cover labels



function PBS_classification1(COLL){  
 

      var tot=COLL.map(function(res){return res.gt(0) }).sum().divide(100);
      var relTot=COLL.map(function(res){return res.gte(3) }).sum().divide(100);
     
      //print('Basic conditions');
      
      //----------------------------------------------------------------------------------------------------------

     var CLOUDS=COLL.map(function(res){return res.eq(1)}).sum().divide(tot);
     tot=0;
     var DARK_VEG=COLL.map(function(res){return res.eq(40)}).sum().divide(relTot);
     var LOW_IL = COLL.map(function(res){return res.eq(42)}).sum().divide(relTot);
     
     var DARK_SOIL= COLL.map(function(res){return res.eq(41)}).sum().divide(relTot);
     var BRIGHT_SOIL=COLL.map(function(res){return res.eq(34)}).sum().divide(relTot);
     var SPARSE=COLL.map(function(res){return res.eq(30)}).sum().divide(relTot);
     var SOIL=COLL.map(function(res){return res.eq(31)}).sum().divide(relTot);

     var BRIGHT_FOREST=COLL.map(function(res){return res.eq(9)}).sum().divide(relTot);
     
     var DEGRADED_FOREST=COLL.map(function(res){return res.eq(13)}).sum().divide(relTot);
     var PURE_FOREST=COLL.map(function(res){return (res.gte(10)).and(res.lte(12))}).sum().divide(relTot);
     var FOREST=PURE_FOREST.add(DEGRADED_FOREST)
     var SHRUB=COLL.map(function(res){return (res.eq(16))}).sum().divide(relTot);
     
     var GRASS= COLL.map(function(res){return res.eq(21)}).sum().divide(relTot);
     
     var EVERGREEN_FOREST= (BRIGHT_FOREST.add(FOREST).add(DARK_VEG));
     
     var WATER=COLL.map(function(res){return (res.eq(7)).or(res.eq(8))}).sum().divide(relTot);
     var SNOW=COLL.map(function(res){return res.eq(3)}).sum().divide(relTot);
     
     var DRY = SPARSE.add(SOIL).add(BRIGHT_SOIL).add(DARK_SOIL).add(LOW_IL);
      
     //print('Valiables are now set ... ');
      
     var OUT =relTot.multiply(0).select([0],["Class"]).toByte(); 
     
     OUT=OUT.where( (CLOUDS.gt(90)),1);
     
    
     
     OUT=OUT.where( (DRY.add(SNOW).gte(95)) ,34);  // 06/10/2014
     OUT=OUT.where( (DRY.add(SNOW).gte(85)).and(SPARSE.lt(10))  ,34);  // 06/10/2014
    
     var GREEN=(EVERGREEN_FOREST.add(SHRUB).add(GRASS));
    
     OUT=OUT.where( (GREEN.gt(40)).and(SHRUB.add(GRASS).gt(30)) ,29)
     
     OUT=OUT.where( (GREEN.gt(60)).and(FOREST.gt(0)).and(SHRUB.gt(10)) ,28)
     
     OUT=OUT.where( (GREEN.gt(45)).and(GREEN.lt(60)).and(SHRUB.gte(15)).and(SHRUB.lt(40)).and(FOREST.eq(0)).and(DRY.gt(40)).and(DRY.lt(55)).and(GRASS.gt(15)).and(GRASS.lt(40)) ,25); 
     
     OUT=OUT.where( (GREEN.gt(65)).and((GRASS.add(SHRUB)).gt(35)).and(DRY.lt(35)) ,26);  // DECIDE IF OPEN DRY or HUMID
     
    
     OUT=OUT.where( ((GREEN.gt(90)).and(DRY.lt(5))).and(FOREST.lt(20)),21);
    
     OUT=OUT.where( (GREEN.gt(70)).and(SHRUB.gt(20)).and(FOREST.gt(10)).and((GRASS.add(SHRUB)).gt(30))   ,20); 
     
    
     OUT=OUT.where( (GREEN.gt(85)).and((SHRUB.add(DEGRADED_FOREST)).gt(70)).and(DRY.lt(5)) ,16);
     
     OUT=OUT.where(  (GREEN.gte(95)).and(FOREST.gte(30)).and(SHRUB.gt(40)).and(EVERGREEN_FOREST.gt(40))   ,15);  // almost evergreen   
     OUT=OUT.where(OUT.eq(0).and((GREEN.gt(85)).and((GRASS.add(DEGRADED_FOREST)).gt(80))),14);   
     OUT=OUT.where( ((BRIGHT_FOREST.add(DEGRADED_FOREST)).gt(60)).and(DRY.eq(0)),13);  // evergreen shrub 
     
     OUT=OUT.where( (FOREST.gt(60)).and(EVERGREEN_FOREST.gt(80)),11);
     OUT=OUT.where( (FOREST.gt(70)).and(GREEN.eq(FOREST)),11);
     OUT=OUT.where( (FOREST.gt(50)).and(GREEN.gt(60)).and((WATER.add(SNOW).add(DARK_VEG).add(LOW_IL).add(GREEN)).gt(90)),10);
     
     OUT=OUT.where( (FOREST.gt(50)).and((EVERGREEN_FOREST.add(SHRUB)).gt(80)).and(DRY.eq(0)),12);
     
    // if (EVG_domain == 1){
     
    //   OUT=OUT.where( (BRIGHT_FOREST.add(EVERGREEN_FOREST)).gt(85),10);  // Brigt 
     
    // }
     
     OUT=OUT.where( (FOREST.gt(90)),10);
      
     OUT=OUT.where( (WATER.gt(60)),7);
     OUT=OUT.where( (WATER.gt(80)),8);
     
     OUT=OUT.where( (OUT.eq(0)).and((DRY.add(WATER).add(SNOW)).gt(90)).and(WATER.gte(20)) ,6)
     OUT=OUT.where( (OUT.eq(0)).and((GREEN.add(WATER)).gt(90)).and(WATER.gt(0)) ,9)
     
     OUT=OUT.where(((DARK_SOIL.add(LOW_IL)).gte(90)),42);
     
     
     var MYCOND=(OUT.eq(0)).and((DRY.add(GRASS)).gt(65)).and(EVERGREEN_FOREST.eq(0));
     OUT=OUT.where( MYCOND.and(GRASS.gte(DRY)).and(SHRUB.lte(5)) ,31); //  bush + grass
     OUT=OUT.where( MYCOND.and(DRY.gt(GRASS)).and(SHRUB.eq(0)) ,32);  // grass 
     MYCOND=0;
     OUT=OUT.where( (GRASS.gte(80)).and((GRASS.add(DRY)).gt(95)) ,30);
     
   
     
     OUT=OUT.where( (DRY.gte(90)) ,34);
     OUT=OUT.where( (SOIL.gte(90)) ,35);
     OUT=OUT.where((BRIGHT_SOIL.gte(90)) ,41);
     OUT=OUT.where( (SPARSE.gte(90)) ,36);
     OUT=OUT.where( (SNOW.gte(80)),2);
     
     OUT=OUT.where(OUT.eq(0).and(FOREST.gte(45)),20);
     OUT=OUT.where(OUT.eq(0).and(FOREST.gte(25)),26);
     OUT=OUT.where(OUT.eq(0),31);
     OUT=OUT.where( (OUT.eq(20)).and(PURE_FOREST.eq(0)).and((GRASS.add(DRY)).gt(70)) ,31);  
     OUT=OUT.where((OUT.eq(26)).and(PURE_FOREST.eq(0)).and((GRASS.add(DRY)).gt(70)).and(DRY.gt(30)) ,30);  
   
     // ADD extra combination involving SNOW ---> not so important for Tropics 
     // .....
     if (debug_mode == 1) { 
       OUT=OUT.addBands(GREEN.select([0],["Green"]).toByte());
       OUT=OUT.addBands(SHRUB.select([0],["SHRUB"]).toByte());
       OUT=OUT.addBands(FOREST.select([0],["FOREST"]).toByte());
       OUT=OUT.addBands(DRY.select([0],["DRY"]).toByte());
       OUT=OUT.addBands(GRASS.select([0],["GRASS"]).toByte());
       OUT=OUT.addBands(SNOW.select([0],["SNOW"]).toByte());
       OUT=OUT.addBands(WATER.select([0],["WATER"]).toByte());
  }  
   
     return OUT
}  //  END PBS





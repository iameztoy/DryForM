// https://medium.com/@gglemoine62/12-day-sentinel-1-coherence-a-test-case-for-ukraine-998488bf589
// also more info in Gmail email

// The COH12 test set has mixed VV (majority) and VH images, both with a single band
// This is why ee.Image.select('VV') does not work. Filter by polarization as follows:
var c12 = ee.ImageCollection('JRC/S1_COH_TEST').
  filterMetadata('system:index', 'ends_with', '_VV_coh12') 

print(c12.size())
print(c12.first())
Map.addLayer(c12, null, 'Mosaic', false)

// Reproduce images from Medium article 
var mariupol = c12.filterBounds(mariupol_aoi).filterDate('2022-03-16', '2022-04-22')

print(mariupol)

// COH12 has values between 0 and 1, so no need to define visualization parameters
Map.addLayer(mariupol.toBands().select([0,7,12]), {min: 0.2, max: 1}, 'Mariupol 3-date COH12 composite')

// Another way to get at some extra metadata: find the GRD images that correspond to the
// master and slave SLC that composes the COH12
//
// From User Guide: https://developers.google.com/earth-engine/guides/joins_save_best
//
// There is usualy a few seconds between the frame timestamps for GRD and SLC.
// Allow maximum 10 seconds difference between time stamps

// Join COH12 master with S1_GRD_FLOAT

var mariupol_s0 = ee.ImageCollection('COPERNICUS/S1_GRD_FLOAT').
  filterBounds(mariupol_aoi).filterDate('2022-03-16', '2022-04-22')

var masterDiffFilter = ee.Filter.maxDifference({
  difference: 10 * 1000,
  leftField: 'system:time_start',
  rightField: 'system:time_start'
});

var slaveDiffFilter = ee.Filter.maxDifference({
  difference: 10 * 1000,
  leftField: 'system:time_end',
  rightField: 'system:time_start'
});

// Define the join.
var saveMasterJoin = ee.Join.saveBest({
  matchKey: 'masterImage',
  measureKey: 'timeDiff'
});

var saveSlaveJoin = ee.Join.saveBest({
  matchKey: 'slaveImage',
  measureKey: 'timeDiff'
});

// Apply the joins.
var mariupol_joined = ee.ImageCollection(saveMasterJoin.apply(mariupol, mariupol_s0, masterDiffFilter))

mariupol_joined = ee.ImageCollection(saveSlaveJoin.apply(mariupol_joined, mariupol_s0, slaveDiffFilter))

print(mariupol_joined)

// Select the COH12 pair March 28 - April 9
var composite = ee.Image(mariupol_joined.filterDate('2022-03-28', '2022-03-29').first())

// Compose Sigma0_master - COH12 - Sigma0_slave
var rgb = ee.Image(composite.get('masterImage')).select('VV').log10().multiply(10).
  addBands(composite).
  addBands(ee.Image(composite.get('slaveImage')).select('VV').log10().multiply(10))

// Now, we're combining dB scaled GRD with COH12, so visualization params required
// The lowest COH12 values are expected around 0.2 (noise equivalent)
Map.addLayer(rgb, {min: [-20, 0.2, -20], max: [-5, 1, -5]}, 'VV master - COH12 - VV slave')

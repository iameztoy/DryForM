//integral NDVI
var pt = ee.Geometry.Point(17.747801, -17.815338).buffer(500)
Map.centerObject(pt, 11)

var mod13q1 = ee.ImageCollection("MODIS/006/MOD13A2").select("NDVI").filterBounds(pt)

var rescale = function(image) {
  return image.divide(10000).copyProperties(image, ["system:time_start", "system:time_end"])
}

var mod13q1 = mod13q1.map(rescale)

var years = ee.List.sequence(2000, 2020);  
var oeel=require('users/OEEL/lib:loadAll'); 

var stepInDay=1;

var enddoy=181;

//Use two whole years 
var emptyimgs=ee.FeatureCollection(ee.List.sequence(ee.Date.fromYMD(2000, 1, 1).millis(),null,1000*3600*24*stepInDay,7300).
      map(function(t){return ee.Feature(null,{'system:time_start':t})}));

var mod13q1_oeel = oeel.ImageCollection.SavatskyGolayFilter({
        collection: mod13q1,
        filter: ee.Filter.maxDifference(1000*3600*24*16*3, 'system:time_start', null, 'system:time_start'),
        distanceFunction: function(infromedImage,estimationImage){
          return ee.Image.constant(ee.Number(infromedImage.get('system:time_start'))
            .subtract(ee.Number(estimationImage.get('system:time_start'))));},
        degree: 3,
        bandOfInterest:["NDVI"], 
        EstimationCollection:emptyimgs
  
}); 
        
var mod13q1_oeel=mod13q1_oeel.map(function(im){return im.updateMask(im.select('extrapolate_flag').not())});

var filtered = mod13q1_oeel.map(function(img) {
  var fitted = img.select("d_0_NDVI")
  var timestamp = img.metadata('system:time_start')
  //var doy = ee.Image(ee.Number.parse(img.date().getRelative("day","years")))
  var doy_austral = ee.Image(ee.Number.parse(img.date().getRelative("day","years")).subtract(enddoy)).uint16()
     
      return fitted
      .addBands(timestamp)
      .addBands(doy_austral)
      .rename('NDVI','timestamp', 'doy');

})


//function for computing mean NDVI per summer season
var yearly = function(y) {
  var start = ee.Date.fromYMD(2000, 1, 1);
  var stop = start.advance(1, 'year');
  var fittedNDVIandTimes = filtered.filterDate(start, stop)

//Get maximum NDVI and doy and date at which it occurs
var maxNDVItime=fittedNDVIandTimes.reduce(ee.Reducer.max(3)).rename('maxNDVI','maxTimestamp', 'maxDoy');

//Get minimum NDVI and doy and date at which it occurs
var minNDVItime=fittedNDVIandTimes.reduce(ee.Reducer.min(3)).rename('minNDVI','minTimestamp', 'minDoy');

//Calculate the mid-point. 
var midpoint = maxNDVItime.select('maxNDVI').add(minNDVItime.select('minNDVI')).divide(2);

//masks all values after season maximum
var preSeasonMax= fittedNDVIandTimes.map(function(img){
  var preMask=img.select('doy').lte(maxNDVItime.select('maxDoy'));
  return img.updateMask(preMask);
});

//mask all values previous to season max
var postSeasonMax= fittedNDVIandTimes.map(function(img){
  var postMask=img.select('doy').gt(maxNDVItime.select('maxDoy'));
  return img.updateMask(postMask);
});


var addMidpointProximity = function(img){
  var midpointProxNeg = img.select('NDVI').subtract(midpoint).abs().multiply(-1).rename('midpointProxNeg')
  return img.addBands(midpointProxNeg);
}


var forSOSretrieval = preSeasonMax.map(addMidpointProximity);

var forEOSretrieval = postSeasonMax.map(addMidpointProximity);

//composite images based on NDVI minimal distance from midpoint. 
var SOSmidp= forSOSretrieval.qualityMosaic('midpointProxNeg');
var EOSmidp= forEOSretrieval.qualityMosaic('midpointProxNeg');
var LOSmidp = EOSmidp.select('doy').subtract(SOSmidp.select('doy'));


var LSP = SOSmidp.select("doy").addBands(EOSmidp.select("doy")).addBands(LOSmidp.select("doy"))
.rename('SOS','EOS', 'LOS').set('year', y,
                    "system:time_start", start.millis(),
                    "system:time_end", stop.millis());

return LSP
  
}


var LSP = ee.ImageCollection(years.map(yearly));
print(LSP, "LPS");

 // Get a palette: a list of hex strings
var palettes = require('users/gena/packages:palettes');
var palette = palettes.matplotlib.viridis[7];
 


Map.addLayer(LSP.first().reproject(LSP.first().projection(), null, 1000), 
{bands: ['LOS'],min: 1, max: 365, palette: palette}, 
"LSP")



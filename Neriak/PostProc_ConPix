var m = ee.ImageCollection('projects/hardy-tenure-383607/assets/MajorityVote_p_gt05').mosaic();

var un = m.unmask();
var cp = un.connectedPixelCount(20).lte(18);
var cp_unm = cp.updateMask(cp);
var mix = un.add(cp);

var mix_sf = mix.selfMask();
var final = mix_sf.connectedPixelCount(50).gte(50).selfMask();


Map.addLayer(un, vp_or, "original unmasked");
Map.addLayer(mix, vp_mx, "Mix - corrected CP <= 18");
Map.addLayer(cp_unm, vp_cp, "Only Connected Pixes <= 18");
Map.addLayer(final, vp_final, "Final - CP => 50");
Map.addLayer(cp.selfMask(), vp_cp, "connected pixels lte 18");

Map.setOptions('SATELLITE');
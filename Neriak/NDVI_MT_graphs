// GRAFICA DE REFERENCIA:
var grafico2D_ndvi = ui.Chart.image.series({
    imageCollection: ndviCol, // Imagenes NDVI
    region: layer, // Geometria de la parcela rural
    reducer: reducers, // Reductores estadisticos
    scale: 10,
    xProperty: 'system:time_start'
  })
  .setChartType('LineChart')
  .setOptions({

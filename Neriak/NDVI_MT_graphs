// Capa de Catastro Rural
var shp_parcelas = ee.FeatureCollection('users/ingenieriageografic/TFM/Parcelas_2022_10_01'); 
var layer = shp_parcelas.filter(ee.Filter.inList('NUM_DOC', ['16611223'])); // Filtro por numero de DNI
var layerstyle = layer.style({fillColor:'00000000', width:4 , color:'orange'});
var namelayer = ui.Map.Layer({eeObject:layerstyle, visParams: null, name:'Parcelas (DNI)', shown: true});                                                
Map.layers().set(0,namelayer); 
Map.centerObject(layer,18); 

// Imagen Sentinel-2
var band = 'NDVI';
var S2A = ee.ImageCollection("COPERNICUS/S2_SR_HARMONIZED")
.filterBounds(layer)
.filterDate('2022-01-01', '2023-01-01');

// Calculo del NDVI
var S2A_filter = S2A.map(function(image){
    var ndvi = image.normalizedDifference(['B8', 'B4']); //NDVI = (NIR – Red)/(NIR + Red)
    image = image.addBands(ndvi.rename('NDVI')); // Agrega una banda con valores de NDVI
    return image;
  });

// Seleccion de la banda NDVI
var ndviCol = S2A_filter.select('NDVI');

// Generación de los reductores de media, mínimos, máximos y desviación estándar.
var reducers = ee.Reducer.minMax()
  .combine({
     reducer2: ee.Reducer.mean(),
     sharedInputs: true
  })
  .combine({
    reducer2: ee.Reducer.stdDev(),
    sharedInputs: true
  });

// Calcula todas las estadísticas en un conjunto de colecciones de imágenes y se agrega la fecha.
var compImg = ee.ImageCollection(ndviCol.map(function(img) {
  return img
      .reduce(reducers)
      .set({'system:time_start': ee.Date(img.get('system:time_start')).format("YYYY-MM-dd")});
}));
print('compImg', compImg);

// Extraiga las estadísticas del NDVI doy para el
// area de interés (parcela rural). El resultado es
// es una colección de características donde cada característica es un representante de la fecha
// que contiene una propiedad (fila) que describe el respectivo NDVI en intervalos de media, minimo, maximo
// desviacion estandar, formateada como una lista de valores.

var reductionTable = compImg.map(function(img) {
  var stats = ee.Dictionary(img
          .reduceRegion({
            reducer: ee.Reducer.mean(), 
            geometry: layer, 
            scale: 10,
            maxPixels: 1e9
          }));

  // Ordene los elementos de reducción de las estadisticas de acuerdo con las columnas que desee
  // en el DataTable organizado (los valores del eje x son los primeros).
  var row = ee.List([
    img.get('system:time_start'), // x-axis, date.
    stats.get('mean'),  // y-axis, mean.
    stats.get('min'), // y-axis, min.   
    stats.get('max'), // y-axis, max.  
    stats.get('stdDev'), // y-axis, StdDev. 
  ]);
// Devuelve la fila como propiedad de una ee.Feature.
  return ee.Feature(null, {row: row});
});
print('reductionTable', reductionTable);

// Agregue las propiedades de 'fila' para crear una matriz 2-D del lado del servidor (DataTable).
var dataTableServer = reductionTable.aggregate_array('row');

// Definir nombres de columna y propiedades para DataTable. La orden debe
// corresponde al orden en la construcción de la propiedad 'fila' anterior.
var columnHeader = ee.List([[
  {label: 'date', role: 'domain'},
  {label: 'mean', role: 'data', type: 'number'},
  {label: 'min', role: 'interval'},
  {label: 'max', role: 'interval'},
  {label: 'stdDev', role: 'data', type: 'number'}
]]);

// Concatenar el encabezado de la columna a la tabla.
dataTableServer = columnHeader.cat(dataTableServer);
print('dataTableServer',dataTableServer);

// Use 'evaluate' para transferir la tabla del lado del servidor al cliente, defina el
// gráfico e imprimirlo en la consola.
dataTableServer.evaluate(function(dataTableClient) {
  var chart_dataTableClient = ui.Chart(dataTableClient)
  // .setChartType('LineChart')
  .setOptions({
    title: 'Fenología del Cultivo',
    interpolateNulls: true,
    intervals: {style: 'area'},
    hAxis: {
      title: 'Análisis Fenológico Multiespectral Sentinel-2',
      titleTextStyle: {italic: false, bold: true},
    },
    vAxis: {
      title: 'NDVI', 
      minValue: -0.2,
      maxValue: 1.0,
      titleTextStyle: {italic: false, bold: true}},
    lineWidth: 1.2,
    pointSize: 2,
    colors: ['#0c310a', 'gray']
  });
  print('Gráfica de areas:',chart_dataTableClient);
});


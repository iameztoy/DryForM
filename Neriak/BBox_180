// Idea to create a grid that does not give problems while exporting an image to Asset or Drive
// IAA 2023-11-21

// Create two separate Bounding Boxes
// Longitude coordinates from GC script.

var bbox_1 = ee.Geometry.BBox(-179.99999945312500005, -75, 0, 75);
var bbox_2 = ee.Geometry.BBox(0, -75, 179.99999913007812500007, 75);

//Convert to Features
var fc_1 = ee.Feature(bbox_1);
var fc_2 = ee.Feature(bbox_2);

Map.addLayer(fc_1, null, "bbox 1");
Map.addLayer(fc_2, null, "bbox 2");

//Create a Covering Grid over the two BBoxes
var grid_1 = bbox_1.coveringGrid(bbox_1.projection(), 1300000);
var grid_2 = bbox_2.coveringGrid(bbox_2.projection(), 1300000);

//Intersect the BBox with the Grids to get read of the areas outside the Bbox
var grid_1_cl = grid_1.map(function(feat) {
                      return fc_1.intersection(feat, 0.1)})
var grid_2_cl = grid_2.map(function(feat) {
                      return fc_2.intersection(feat, 0.1)})

print(grid_1)
print(grid_2)

Map.addLayer(grid_1_cl, null, "Grid 1 Clipped");
Map.addLayer(grid_2_cl, null, "Grid 2 Clipped");

//Merge both grids from both Bboxes
var grid = grid_1_cl.merge(grid_2_cl);
Map.addLayer(grid, null, "Grids Merged");

//For testing purposes
var select_test1 = grid.filterBounds(test1);
var select_test2 = grid.filterBounds(test2);

Map.addLayer(select_test1, null, "Selected 1 West - Test");
Map.addLayer(select_test2, null, "Selected 2 East - Test");

// Just to see if the coordinates are correct
// All long. coords should be negative in test 1
// All long. coords should be positive in test 2

print(select_test1); 
print(select_test2);

//For testing purposes
var Zones = select_test1.merge(select_test2)
print(Zones)
Map.addLayer(Zones, null, "Zones")

// CoveringGrid produces a strange ID so I make a new fc with proper
// unique id so we can parse tehm to the name while running the Export Loop.

// make a list of length of features
var idList = ee.List.sequence(0,Zones.size().subtract(1));
// featureCollection to a List
var list = Zones.toList(Zones.size());

// set the system:index
var zonesID = ee.FeatureCollection(idList.map(function(newSysIndex){
  var feat = ee.Feature(list.get(newSysIndex));
  // format number to string (system:index must be a string)
  var indexString = ee.Number(newSysIndex).format('%03d') //3 is until 999, increase if needed 
                                                          //but big chance of client crash while exporting
  return feat.set('system:index', indexString, 'ID', indexString);
}));

print(zonesID)


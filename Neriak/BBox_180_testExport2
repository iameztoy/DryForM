var featlist = zonesID.getInfo()["features"];
for (var f in featlist) {
  var feat = ee.Feature(featlist[f]);
  var dis = feat.get("ID");
  var disS = dis.getInfo();
  var name = "chip";  
  Export.image.toDrive({
    image: target,
    description: name+disS, //.toString(),
    folder: "Zones_test",
    fileNamePrefix: name+disS, //.toString(), (only if integer ID)
    region: feat.geometry().bounds(),
    scale: 10,
    maxPixels: 1e13
  });

//DMS to Decimal

var DMS_to_Decimal = function (d, m, s) {
  var dec = Math.abs(d) + Math.abs(m/60) + Math.abs(s/3600);
  return d/Math.abs(d)*dec;
}

var oros = ee.Geometry.Point(DMS_to_Decimal(-39, 0, 10), 
                             DMS_to_Decimal(-6, 15, 12))
Map.addLayer(oros)
Map.centerObject(oros, 12)
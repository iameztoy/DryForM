//
// The overall purpose of this script is to perform a landcover classification on the Rocky Mountain Ecoregion
// of Alberta. The mandate was to produce a 5 class wetland classification according to class level of the 
// Canadian Wetland Classification System. In this classification, upland classes are also identified in order to 
// distinguish them from wetlands. This classification is based entirely on open source freely available data, 
// most of which is available in Google Earth Engine. The training data for the classification is derived from
// photo-interpretation by the  Alberta Biodiversity Monitoring Institute, which is available at 
// https://www.abmi.ca/home/data-analytics/da-top/da-product-overview/Advanced-Landcover-Prediction-and-Habitat-Assessment--ALPHA--Products/Photoplot-Land-Cover-Data-Training-and-Validation.html
// A few additional training sites were added through photo-interpretation of photographs taken by users of Google Maps.
//
// The classification process is split into three sections.
// This is done to avoid memory errors, by exporting and
// then reimporting intermediate products at two points within the process.
// Follow instructions at beginning and end of each section carefully
//
//-------------------------------------------------------------------------------------
//-------------------------------------------------------------------------------------


// INPUTS: a.Study area feature collection ("Rocky") in asset folder
// The study area feature collection is a shapefile of the
// Rocky Mountain ecoregion of Alberta (a very irregular shape)
// surrounded by a 10 km buffer to make a more regular, contiguous shape
// b. Topographic variable images derived from ALOS DEM and calculated in SAGA GIS
// c. Training data as labelled points
// INTERMEDIATE OUTPUT of SECTION ONE: Exported Image with indices and range variables calculated
// INTERMEDIATE OUTPUT of SECTION TWO: Training points with sampled image information
// OUTPUT OF SECTION THREE: Classified image
//
//Table of Contents 
// SECTION 1
//1. Build Sentinel-2 image collection and mask clouds
//2. Derive indices from the composite
//3. Derive temporal-spectral variables to represent the range of values over the season
//4. Reduce Image Collection to  Median image, scale, and export
//5. Export the image composite
// SECTION 2
//6. Reduce the image collection by standard deviation, adding additional bands to image 
//7. Add topographic data: SWI, TPI, and VBF images
//8. SNIC Segmentation
//9. Calculate means and standard deviations within cluster segments
//10. Create the training samples by sampling within training polygons 
//on image bands to create training points, and export them
// SECTION 3
//11. Partition training points into training and validation
//12. Train the Classifier
//13. Classify
//14. Validation error matrix
//15. Export classified image
//-------------------------------------------------------------------------------------


//---------------------------------------------------------------------------------
//---------------------------------------------------------------------------------
//1. Build Sentinel-2 image collection and mask clouds
//---------------------------------------------------------------------------------

//Identify study area
var Rocky = ee.FeatureCollection('users/fgregory/RockyMountain_Buff10');
//

// Define Sentinel-2 Image Collection
var imgC = ee.ImageCollection('COPERNICUS/S2_SR')
    .filterDate('2020-06-15', '2020-09-15') //2020 snow-free season (earlier dates too cloudy)
    .filterBounds(Rocky)
   .filter(ee.Filter.lt('CLOUDY_PIXEL_PERCENTAGE', 30));  
   
//Function to mask cloud from built-in quality band information
var maskcloud1 = function(image) {
var QA60 = image.select(['QA60']);
return image.updateMask(QA60.lt(1));
 };
// Apply cloud-masking to image collection
var imgC = imgC.map(maskcloud1);

// Function to mask further cloud using B1 (cirrus cloud) threshold
var maskcloud2 = function(image) {
 var B1 = image.select(['B1']);
 var bin = B1.gt(1500);  //Threshold chosen by observation, usually something close to this value works 
 return image.updateMask(bin.lt(1));
 };
// Apply 2nd cloud-masking to image collection
var imgC = imgC.map(maskcloud2);
// Note: In glacial areas such as the Rocky Mountains, this masking technique will also capture some snow caps
// This was not of concern for this application as there will not be wetlands within the snow caps


//---------------------------------------------------------------------------------
// 2. Derive indices from the composite
//
// After visually comparing a few different indices, 
// these were chosen as the best for distinguishing wetlands in this area 
//---------------------------------------------------------------------------------

//Normalized Difference Water Index 1 for detecting water bodies, McFeeters (1996) 
var addNDWI1 = function(image) {
  return image.addBands(image.normalizedDifference(['B3', 'B8']).rename('NDWI1'));
};
//map the function over the image collection, adding a NDWI1 band to each image
imgC = imgC.map(addNDWI1);

// Normalized Water Index 2 for water content of leaves,  Gao (1996)
var addNDWI2 = function(image) {
  return image.addBands(image.normalizedDifference(['B8', 'B11']).rename('NDWI2'));
};
//map the function over the image collection
imgC = imgC.map(addNDWI2);

// Enhanced Vegetation Index, Huete et al (1997)
var addEVI = function(image)  {
  return image.addBands(image.expression(
  '2.5*(B8-B4)/((B8+(6*B4)-(7.5*B2))+1)',{
  'B8': image.select(['B8']),
  'B4': image.select(['B4']),
  'B2': image.select(['B2']),
  }).rename('EVI'));
};
//map the function over the image collection
imgC = imgC.map(addEVI);

//normalized Anthocyanin Reflectance Index, Bayle et al (2019)
var addNARI = function(image) {
  return image.addBands(image.expression(
   '((1/B3) - (1/B5))/((1/B3) + (1/B5))', {
    'B5': image.select(['B5']),
    'B3': image.select(['B3']), 
   }).rename('NARI'));
};
imgC = imgC.map(addNARI);


//---------------------------------------------------------------------------------------
// 3. Derive temporal-spectral variables to represent the range of values over the season
//---------------------------------------------------------------------------------------
//

// List of bands to calculate the range for
var bandList = [ "B7", "B12", "NDWI2", "NARI"];  
// These particular bands and indices chosen for this calculation was narrowed down 
// by trial and testing for importance from the full set of potential bands and indices

// Function to do the calculating for each band
var diffList = bandList.map(function(band) {
//compute range of values between 90th and 10th percentiles
   var High = imgC.select([band]).reduce(ee.Reducer.percentile([90]));
   var Low = imgC.select([band]).reduce(ee.Reducer.percentile([10]));
   var Diff = High.subtract(Low);
return Diff;
  });
// Percentiles are used rather than max & min to avoid outliers

// Put the results together
var diffC = ee.ImageCollection.fromImages(diffList);

//Cast it to an image 
var diff = diffC.toBands().rename(['diffB7',
  'diffB12','diffNDWI2', 'diffNARI']);
  
//---------------------------------------------------------------------------
// 4. Reduce Image Collection to Image: Median image, scale, and export
//---------------------------------------------------------------------------
//

//Reduce to image median and add difference bands from previous step
var imgMed = imgC.median().addBands(diff);

//Scale image bands but not indices
var imgbands = ['B2', 'B3', 'B4', 'B5', 'B6', 'B7' , 'B8',  'B11', 'B12',
'diffB7','diffB12'];
var imgScale  = imgMed.select(imgbands).divide(10000); //scale image bands
var indBands = ['NDWI1', 'NDWI2', 'EVI', 'NARI','diffNDWI2', 'diffNARI'];
var img = imgScale.addBands(imgMed.select(indBands)) .float();
print (img);

//Optional - Display data 
//---------------------------------------------------------------------------------
//draw box in red underneath to make sure there is coverage (no cloud mask holes)
Map.addLayer (Rocky, {color: 'FF0000'}, 'StudyArea Fill',false);
// Display Image Composites
var visTCC = {bands:['B4','B3','B2'], gamma: 1.4, min:0, max:[.2000, .2000, .2500]};
var visFCC = {bands:['B8','B4','B3'], gamma: 1.4, min:0.01, max:[.5000, .2500, .2500]};
var visSWIR = {bands:['B11','B8','B4'], gamma: 1.3, min:0.01, max:[.5000, .5000, .2500]};
Map.addLayer(img, visTCC, 'Summer TCC 2020'); 
Map.addLayer(img, visFCC, 'Summer Infrared FCC 2020', false); //don't draw this yet, can turn on in map
Map.addLayer(img, visSWIR, 'Summer SWIR FCC 2020', false); 
// Display Indices
var colorbrewer = require('users/gena/packages:colorbrewer');
Map.addLayer(img, {bands:['EVI'],min: -0.9, max:0.9, palette: colorbrewer.Palettes.PRGn[11]}, 'EVI', false);
Map.addLayer(img, {bands:['NDWI2'], min: -0.7, max:0.9, palette: colorbrewer.Palettes.Spectral[11]}, 'NDWI_Gao', false);
Map.addLayer(img, {bands:['NARI'],min: 0, max:0.3, palette: colorbrewer.Palettes.RdYlBu[11].reverse()}, 'nARI', false);
//display difference bands
Map.addLayer(img, {bands:['diffNDWI2']},'diffNDWI2',false);
Map.addLayer(img, {bands:['diffNARI']},'diffNaRI',false);
//Display study area outline
var image1 = ee.Image(0).mask(0);
var rockyOutline = image1.paint(Rocky, 'ff00ff',2);
Map.addLayer(rockyOutline, {'palette': 'ff0000', 'opacity': 0.5}, "Study Area Outline");
Map.centerObject(Rocky);


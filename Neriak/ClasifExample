//SECTION TWO

//--------------------------------------------------------------------------------- 
//6. Reduce the image collection by standard deviation, adding additional bands to image 
//--------------------------------------------------------------------------------- 
////These variables represent standard deviation over time
////These particular bands and indices chosen for this calculation was narrowed down 
//// by trial and testing for importance from the full set of potential bands and indices
//--------------------------------------------------------------------------------- 
var img = image
var imgSD = imgC.reduce(ee.Reducer.stdDev());
var imgbands = ['B2_stdDev', 'B5_stdDev',  'B7_stdDev' , 'B8_stdDev',  'B11_stdDev', 'B12_stdDev'];
var imgSDscale  = imgSD.select(imgbands).divide(10000); //scale image bands
var indSDBands = ['NDWI2_stdDev', 'EVI_stdDev', 'NARI_stdDev']; 
var imgSDnew = imgSDscale.addBands(imgSD.select(indSDBands)).float();

var img = img.addBands(imgSDnew);


//--------------------------------------------------------------------------------- 
//---------------------------------------------------------------------------------
//7. Add topographic data: SWI, TPI, and VBF images
//---------------------------------------------------------------------------------
// The following topographic derviative images were precalculated in SAGA GIS
//

var SWI = ee.Image('users/fgregory/SWI_ALOS');  //SAGA WETNESS INDEX (Beven et al, 1997)
var TPI250 = ee.Image('users/fgregory/TPI250_ALOS');  //Topographic Position Index, 
// with neighbourhood radius of 250m
var TPI750 = ee.Image('users/fgregory/TPI750_ALOS');//Topographic Position Index, 
// with neighbourhood radius of 750m
var VBF  = ee.Image('users/fgregory/VBF_ALOS_Rocky') //Valley Bottom Flatness (Gallant et al, 2003)

var img = img.addBands(SWI.rename('SWI'))
           .addBands(TPI250.rename('TPI250'))
           .addBands(TPI750.rename('TPI750'))
           .addBands(VBF.rename('VBF'))
           .float();
print (img, "img");  //print to check bands were added as expected


//---------------------------------------------------------------------------------
//---------------------------------------------------------------------------------
//8. SNIC Segmentation
//---------------------------------------------------------------------------------
//

//Set seeds for segmentation and apply softening
var seeds = ee.Algorithms.Image.Segmentation.seedGrid(36, 'hex');
var kernel = ee.Kernel.gaussian(3);

//Select 10 m bands
var bands10m = ['B2','B3','B4','B8']
var img10m = img.select(bands10m);
// Apply light smoothing to bands
var img10mSmoo = img10m.convolve(kernel);

//Run SNIC algorithm 
//// Parameters determined by experimentation
//// Ideal clusters follow the shape of natural features
//// but are not too long and thin because features which cross tiles
//// may cause data gaps in the output
//// Clusters were assessed with map display zoomed in to a 5 m scale
//// 5m was chosen as the scale at which the clusters best matched the target features
//// This is not to be confused with input image resolutions which vary from 10-30 m pixel size
var snic = ee.Algorithms.Image.Segmentation.SNIC({
  image: img10mSmoo,
  compactness: 0.4,  
  connectivity: 4,
  neighborhoodSize: 64,
  seeds: seeds
}).select(['B2_mean', 'B3_mean', 'B4_mean', 'B8_mean', 'clusters'], 
['B2', 'B3', 'B4', 'B8', 'clusters']);

var clusters = snic.select(['clusters']);

//Optional: Display clusters generated from SNIC
// Zoom in to scale of 5 m (Check with Inspector)
Map.addLayer(clusters.randomVisualizer(), null, 'clusters', false);

// add clusters to image
var img = img.addBands(clusters.rename('clusters'));

//---------------------------------------------------------------------------------
//---------------------------------------------------------------------------------
//9. Calculate means and standard deviations within cluster segments
// The standard deviations within clusters represent class variation across space
//---------------------------------------------------------------------------------
//

var allStats = img.reduceConnectedComponents({
  reducer: ee.Reducer.mean().combine({
  reducer2:ee.Reducer.stdDev(),
  sharedInputs:true
  }),
  labelBand: 'clusters',
  maxSize: 512  
  }).float();

var imgstats = allStats; 
print (imgstats, "imgstats");  //print to check bands were created as expected


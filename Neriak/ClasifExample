//---------------------------------------------------------------------------------
//11. Partition training points into training and validation
//---------------------------------------------------------------------------------
//---------------------------------------------------------------------------------
var trainPoints = table
trainPoints = trainPoints.filter(ee.Filter.notNull(['B2_mean'])).randomColumn();
var split = 0.7;  
var training = trainPoints.filter(ee.Filter.lt('random', split));  //70% training
var validation = trainPoints.filter(ee.Filter.gte('random', split));  //30% validation

//---------------------------------------------------------------------------------
//---------------------------------------------------------------------------------
//12. Train the Classifier
//---------------------------------------------------------------------------------
//These are the 60 variables that will be used in the classification
// The 10 least important or most redundant variables were removed after several trials of Random Forest
// Variable removal stopped when class accuracies as shown in the validation error matrix started to fall
var predictionVar= ['B2_mean', 'B2_stdDev','B3_mean', 'B3_stdDev', 'B4_mean', 'B4_stdDev','B5_mean', 'B5_stdDev',
'B6_mean', 'B6_stdDev','B7_mean', 'B7_stdDev','B8_mean', 'B8_stdDev','B11_mean', 'B11_stdDev',
'B12_mean', 'B12_stdDev',
'diffB7_mean', 'diffB7_stdDev','diffB12_mean','diffB12_stdDev',
'EVI_mean', 'EVI_stdDev','NARI_mean', 'NARI_stdDev',
'diffNARI_mean', 'diffNARI_stdDev','NDWI1_mean', 'NDWI1_stdDev','NDWI2_mean', 'NDWI2_stdDev',
'diffNDWI2_mean', 'diffNDWI2_stdDev','B2_stdDev_mean','B2_stdDev_stdDev','B5_stdDev_mean','B5_stdDev_stdDev',
'B7_stdDev_mean','B7_stdDev_stdDev','B8_stdDev_mean','B8_stdDev_stdDev',
'B11_stdDev_mean','B11_stdDev_stdDev','B12_stdDev_mean','B12_stdDev_stdDev',
'EVI_stdDev_mean', 'EVI_stdDev_stdDev','NARI_stdDev_mean', 'NARI_stdDev_stdDev',
'NDWI2_stdDev_mean', 'NDWI2_stdDev_stdDev','SWI_mean', 'SWI_stdDev',
'TPI250_mean', 'TPI250_stdDev','TPI750_mean', 'TPI750_stdDev', 'VBF_mean', 'VBF_stdDev'];

var trainedRF = ee.Classifier.smileRandomForest({numberOfTrees: 1000}).train({
  features: training,
  classProperty: 'Class_2',  //Name of the field with the class labels
  inputProperties:predictionVar
});
print (trainedRF.explain());


//---------------------------------------------------------------------------------
//13. Classify
//---------------------------------------------------------------------------------

var classifiedRF = imgstats.classify(trainedRF);

//---------------------------------------------------------------------------------
//14. Validation error matrix
//---------------------------------------------------------------------------------
var validated = validation.classify(trainedRF);
var testAccuracy = validated.errorMatrix('Class_2', 'classification');
print('Validation error matrix: ', testAccuracy);
print('Validation overall accuracy: ', testAccuracy.accuracy());
print('Validation consumer accuracy: ', testAccuracy.consumersAccuracy());
print('Validation producer accuracy: ', testAccuracy.producersAccuracy());
print('Kappa Coefficient: ', testAccuracy.kappa());

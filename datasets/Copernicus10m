var palettes = require('users/gena/packages:palettes');
var palette = palettes.cmocean.Speed[7]; //https://github.com/gee-community/ee-palettes 


//Copernicus TCD
var ctcd = ee.ImageCollection([image0, image1, image2, image3, image4, image5, image6, image7, image8]);
var ctcd_mos = ctcd.mosaic();
//print(cop_mos)

var boolean = ctcd_mos.gte(10).and(ctcd_mos.lte(100)); // To comply to FAO definition of Forest: dens. =>10%
var ctcd_mosm = ctcd_mos.updateMask(boolean); //Original Copernicus Forest dataset (10m). Background value 255 masked. Range 0 - 100%
var ctcd_mosm_gt10 = boolean.updateMask(boolean); //Boolean mask (Only => 10%, value 255 masked)

Map.setCenter(10.75, 49.29, 4)
Map.addLayer(ctcd_mosm_gt10, {min: 0, max: 1}, "Copernicus 10m, => 10%", true);
Map.addLayer(ctcd_mosm, {min: 0, max: 100, palette: palette}, "Copernicus 10m, 0 - 100%", 0);


/**** Start of imports. If edited, may not auto-convert in the playground. ****/
var image1 = ee.Image("projects/hardy-tenure-383607/assets/CopForest10m/TCD2018010m0"),
    image2 = ee.Image("projects/hardy-tenure-383607/assets/CopForest10m/TCD2018010m1"),
    image3 = ee.Image("projects/hardy-tenure-383607/assets/CopForest10m/TCD2018010m3"),
    image4 = ee.Image("projects/hardy-tenure-383607/assets/CopForest10m/TCD2018010m5"),
    image5 = ee.Image("projects/hardy-tenure-383607/assets/CopForest10m/TCD2018010m6"),
    image6 = ee.Image("projects/hardy-tenure-383607/assets/CopForest10m/TCD2018010m8"),
    image7 = ee.Image("projects/hardy-tenure-383607/assets/CopForest10m/TCD2018010m7");
/***** End of imports. If edited, may not auto-convert in the playground. *****/
var palettes = require('users/gena/packages:palettes');
var palette = palettes.cmocean.Speed[7]; //https://github.com/gee-community/ee-palettes 

var col = ee.ImageCollection([image1, image2, image3, image4, image5, image6, image7]);
var cop_mos = col.mosaic();
//print(mos)

var boolean = cop_mos.gte(10).and(cop_mos.lte(100)); // To comply to FAO definition of Forest dens =>10
var cop_mosm = cop_mos.updateMask(boolean); //Original Copernicus Forest dataset (10m). Background value 255 masked
var cop_gt10p = boolean.updateMask(boolean); //Boolean mask (Only => 10%, value 255 masked)


Map.addLayer(cop_mosm, {min: 0, max: 100, palette: palette}, "Copernicus 10m, 0 - 100%", true);
Map.addLayer(cop_gt10p, {min: 0, max: 1}, "Copernicus 10m, => 10%", true);
Map.centerObject(cop_mosm, 5);



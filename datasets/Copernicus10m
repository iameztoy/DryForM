/*
September 2023. TCD ingested as an asset. Iban Ameztoy | JRC Bioeconomy Unit
Source: Tree Cover Density 2018 — Copernicus Land Monitoring Service (File name & version: TCD_2018_010m_eu_03035_V2_0)
Link: land.copernicus.eu/pan-european/high-resolution-layers/forests/tree-cover-density/status-maps/tree-cover-density-2018?tab=download

Previous steps: Size reduction of the original 10 meter mosaic; split in 9 tiles. Approx. processing time: 25 minutes
Approx. upload time: 6h + 0.5 to 2h processing 
*/

var palettes = require('users/gena/packages:palettes');
var palette = palettes.cmocean.Speed[7]; //https://github.com/gee-community/ee-palettes 

var col = ee.ImageCollection([image0, image1, image2, image3, image4, image5, image6, image7, image8]);
var cop_mos = col.mosaic();
//print(cop_mos)

var boolean = cop_mos.gte(10).and(cop_mos.lte(100)); // To comply to FAO definition of Forest: dens. =>10%
var cop_mosm = cop_mos.updateMask(boolean); //Original Copernicus Forest dataset (10m). Background value 255 masked. Range 0 - 100%
var cop_gt10p = boolean.updateMask(boolean); //Boolean mask (Only => 10%, value 255 masked)


Map.addLayer(cop_gt10p, {min: 0, max: 1}, "Copernicus 10m, => 10%", true);
Map.addLayer(cop_mosm, {min: 0, max: 100, palette: palette}, "Copernicus 10m, 0 - 100%", true);


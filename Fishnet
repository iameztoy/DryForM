////// BACKUP /////////

var colFunc = function(feat) {
  var dis = feat.get("myname");
  var clipped = img.clip(feat).set("myname", dis);
  return clipped;
};

var imcol = ee.ImageCollection(xhogei.map(colFunc));

print(imcol);

////////////// EXPORTING ///////////////////////
var featlist = xhogei.getInfo()["features"];
for (var f in featlist) {
  var feat = ee.Feature(featlist[f]);
  var dis = feat.get("myname");
  var disS = dis.getInfo();
  var name = "chip";  
  Export.image.toDrive({
    image: img,
    description: name+disS.toString(),
    folder: "EEtest",
    fileNamePrefix: name+disS.toString(),
    region: feat.geometry().bounds(),
    scale: 10,
    maxPixels: 1e13
  });
}

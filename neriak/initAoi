//Set 30° N/S Aoi
var tropic = ee.Geometry.Polygon([[[-120, 30],[-120, -30],[165, -30],[165, 30]]], null, false);


// Different definitions of TFM in https://doi.org/10.1371/journal.pone.0252063.t001
// Murphy and Lugo 1986 --- 250–2000 mm, 4–7 months <= 100 mm
// FAO Sunderlandet al. 2015 --- 500–1500 mm, 5–8 months <=100 mm
// DryFlor Banda et al. 2016 <=1800 mm, 3–6 months <=100 mm
// Aridity Index* Bastin et al. 2017 --- 0.2 < aridity index < 0.65
// *Calculated by taking the ratio of mean annual precipitation to potential evapotranspiration.

var precip = ee.Image("OpenLandMap/CLM/CLM_PRECIPITATION_SM2RAIN_M/v01");
var countries = ee.FeatureCollection("FAO/GAUL/2015/level0");

var proj = precip.projection();
var raint1 = 120;

var jan = precip.select("jan").clip(tropic);
var jan_cl = ee.Image(1).where(jan.gt(raint1), 0).where(jan.lte(raint1), 1);
var feb = precip.select("feb").clip(tropic);
var feb_cl = ee.Image(1).where(feb.gt(raint1), 0).where(feb.lte(raint1), 1);
var mar = precip.select("mar").clip(tropic);
var mar_cl = ee.Image(1).where(mar.gt(raint1), 0).where(mar.lte(raint1), 1);
var apr = precip.select("apr").clip(tropic);
var apr_cl = ee.Image(1).where(apr.gt(raint1), 0).where(apr.lte(raint1), 1);
var may = precip.select("may").clip(tropic);
var may_cl = ee.Image(1).where(may.gt(raint1), 0).where(may.lte(raint1), 1);
var jun = precip.select("jun").clip(tropic);
var jun_cl = ee.Image(1).where(jun.gt(raint1), 0).where(jun.lte(raint1), 1);
var jul = precip.select("jul").clip(tropic);
var jul_cl = ee.Image(1).where(jul.gt(raint1), 0).where(jul.lte(raint1), 1);
var aug = precip.select("aug").clip(tropic);
var aug_cl = ee.Image(1).where(aug.gt(raint1), 0).where(aug.lte(raint1), 1);
var sep = precip.select("sep").clip(tropic);
var sep_cl = ee.Image(1).where(sep.gt(raint1), 0).where(sep.lte(raint1), 1);
var oct = precip.select("oct").clip(tropic);
var oct_cl = ee.Image(1).where(oct.gt(raint1), 0).where(oct.lte(raint1), 1);
var nov = precip.select("nov").clip(tropic);
var nov_cl = ee.Image(1).where(nov.gt(raint1), 0).where(nov.lte(raint1), 1);
var dec = precip.select("dec").clip(tropic);
var dec_cl = ee.Image(1).where(dec.gt(raint1), 0).where(dec.lte(raint1), 1);

//Sum of montly reclassified rainfall raint1
var AR100 = jan_cl.add(feb_cl).add(mar_cl).add(apr_cl).add(may_cl).add(jun_cl)
            .add(jul_cl).add(aug_cl).add(sep_cl).add(oct_cl).add(nov_cl).add(dec_cl);
//Reclassify to 1 values falling between 4 and 7. These are pixels with 4 or 7 months with montly precipitation below 100mm
var AR100r = ee.Image(1).where(AR100.lt(4), 0).where(AR100.gte(4),1).where(AR100.lte(7),1).where(AR100.gt(7),0);

//Visu and add
var visu_p = {
  bands: ['jan'],
  min: 0.0,
  max: 380.0,
  palette: ['ecffbd', 'ffff00', '3af6ff', '467aff', '313eff', '0008ff']
};

var visu_rec = {"opacity":0.70,
  "bands":["constant"],
  "palette":["ff4812","ffa39f","ffd3c6","ffcb0c","ffdf41","f7ff7e","d2ff97",
              "98ff58","08ff26","83f4ff","64b7ff","235dff"]};



Map.addLayer(jan, visu_p, "Precipitation monthly in mm", false);
Map.addLayer(AR100, visu_rec, "AR100", true);
Map.addLayer(AR100r, {}, "AR100r", false)
//Map.addLayer(tropic);
Map.addLayer(countries,{}, "Country Boundaries", false)






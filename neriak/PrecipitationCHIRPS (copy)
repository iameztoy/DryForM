var roii = ee.FeatureCollection("users/cyberiba/LegalAmazon/arc_deforestation");
var roiii = ee.FeatureCollection("users/cyberiba/LegalAmazon/Brazil_amazonia_legal");
var roi = ee.FeatureCollection("users/cyberiba/LegalAmazon/Amazon_biome");

//edit sum, mean lines 66 and 106 and stdDev for annual values

var chirps = ee.ImageCollection('UCSB-CHG/CHIRPS/PENTAD');
print(chirps)

// set the projection variable so we can use to the reducer
// afterwards with the nominal scale
var projection = ee.Image(chirps.first()).projection()  



//defines period of interest
var startyear = 1981; 
var endyear = 2023; 

var startmonth = 1;
var endmonth = 12;

var startdate = ee.Date.fromYMD(startyear, startmonth, 1);
var enddate = ee.Date.fromYMD(endyear , endmonth, 1);

var years = ee.List.sequence(startyear, endyear);

//select data for the period of interest and place
var precip = chirps.filterDate(startdate, enddate)
  .sort('system:time_start', false)
  .filterBounds(roi);

//function for calculating the annual precipitation
var annualPrecip = ee.ImageCollection.fromImages(
  years.map(function (year) {
    var annual = precip
        .filter(ee.Filter.calendarRange(year, year, 'year'))
        .sum();
    return annual
        .set('year', year)
        .set('system:time_start', ee.Date.fromYMD(year, 1, 1));
}));

//set up visualiztion parameter for the image and bar chart


var pViz = {
  min: -1, 
  max: 1, 
  palette: '000000, 0000FF, FDFF92, FF2700, FF00E7'
};

var title = {
  title: 'Annual precipitation',
  hAxis: {title: 'Time'},
  vAxis: {title: 'Precipitation (mm)'},
};


//crate a chart for yearly precipitation data ,using the geometry, and a reducer for 
//calculating mean precipitation area
print(annualPrecip)
var chart = ui.Chart.image.seriesByRegion({
  imageCollection: annualPrecip, 
  regions: roi,
  reducer: ee.Reducer.mean(),
  band: 'precipitation',
  scale: projection.nominalScale(), // original 2500
  xProperty: 'system:time_start',
  seriesProperty: 'SITE'
}).setOptions(title)
  .setChartType('ColumnChart');

//display the results by printing the chart and adding mean precipitation to the map

print(chart);


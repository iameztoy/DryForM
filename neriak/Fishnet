/**** Start of imports. If edited, may not auto-convert in the playground. ****/
var co = ee.FeatureCollection("users/iameztoy/dryform/fn1d"),
    xsei = ee.FeatureCollection("users/iameztoy/1degx6"),
    xhogei = ee.FeatureCollection("users/iameztoy/1degx20"),
    img = ee.Image("DLR/WSF/WSF2015/v1"),
    table = ee.FeatureCollection("users/iameztoy/1degx20str"),
    table2 = ee.FeatureCollection("users/iameztoy/dryform/GFN1d");
/***** End of imports. If edited, may not auto-convert in the playground. *****/
//Fishnet + GADM spatial join
var cont = ["Africa"];
var sel = table2.filter(ee.Filter.inList('CONTINENT', cont));
print(sel)
var seld = sel.filter(ee.Filter.lt("id", 7800));
Map.addLayer(sel);
Map.addLayer(seld);

//FN 10 deg.
var Zones=ee.FeatureCollection('users/bourgoinclement2/Harvest/10degGridGlobal_WithoutOcean')




var colFunc = function(feat) {
  var dis = feat.get("id");
  var clipped = img.clip(feat).set("id", dis);
  return clipped;
};

var imcol = ee.ImageCollection(Zones.map(colFunc));

print(imcol);

////////////// EXPORTING ///////////////////////
var featlist = Zones.getInfo()["features"];
for (var f in featlist) {
  var feat = ee.Feature(featlist[f]);
  var dis = feat.get("id");
  var disS = dis.getInfo();
  var name = "chip";  
  Export.image.toDrive({
    image: img,
    description: name+disS.toString(),
    folder: "EEtest",
    fileNamePrefix: name+disS.toString(),
    region: feat.geometry().bounds(),
    scale: 10,
    maxPixels: 1e13
  });
}


